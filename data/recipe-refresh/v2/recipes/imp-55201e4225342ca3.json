  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá: rửa sạch phi lê, dùng giấy bếp thấm thật khô, cắt miếng vừa ăn cỡ 3–4 cm.",
      "tip": "Woks of Life: cá phải thật khô thì lớp áo mới giòn; miếng cá ướt làm bột nhão và bắn dầu."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp cá với muối, tiêu trắng và lòng trắng trứng, trộn đều cho bám khắp miếng cá, để 15 phút. Sau đó rắc bột ngô vào, xóc đều cho phủ một lớp mỏng.",
      "tip": "Theo tỉ lệ video 酸甜鱼片 (1 muỗng cà phê muối + 1 lòng trắng trứng + 2 muỗng canh bột ngô cho 700 g cá). Không ướp quá 20 phút kẻo cá ra nước.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sốt chua ngọt: cho tương cà, giấm gạo, đường, xì dầu nhạt và 100 ml nước vào bát, khuấy tan. Pha riêng bột ngô (1,5 muỗng canh) với 45 ml nước lạnh, khuấy đều.",
      "tip": "Red House Spice: trộn sẵn hỗn hợp sốt trong lúc chờ cá để thao tác xào được nhanh, gọn."
    },
    {
      "stepNumber": 4,
      "instruction": "Sơ chế rau củ: hành tây và ớt chuông cắt miếng vuông cỡ 2 cm; cà chua cắt múi cau; dứa cắt miếng vừa ăn; tỏi băm nhỏ; gừng thái lát; hành lá cắt khúc 3 cm."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng dầu chiên trong chảo sâu lòng/wok đến khoảng 180–190°C. Thử bằng cách thả một ít bột: bột sủi bọt và nổi lên ngay, hơi vàng nhạt là đạt.",
      "tip": "Woks of Life chiên ở 380°F (~193°C); F&N Life chiên ở 180°C — hai nguồn chênh nhau, chọn khoảng 180–190°C an toàn cho bếp nhà.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Thả từng miếng cá vào chiên thành nhiều mẻ, không nhồi chảo. Chiên 3–4 phút đến khi vàng giòn thì vớt ra, để ráo trên rack hoặc giấy thấm dầu.",
      "tip": "Woks of Life: chiên từng mẻ nhỏ để cá không dính nhau và giữ nhiệt dầu; nhồi chảo làm cá bị mềm, không giòn.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 7,
      "instruction": "Nếu cá chiên xong bị mềm: đun dầu nóng già hơn, chiên lại toàn bộ cá khoảng 30 giây rồi vớt ra ngay.",
      "tip": "Mẹo của Woks of Life để 'hồi giòn' cá chiên trước khi áo sốt.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Chắt bớt dầu, chừa lại khoảng 1 muỗng canh trong wok. Phi thơm tỏi băm và gừng (nếu dùng) khoảng 30 giây, rồi cho tương cà vào xào thêm 20 giây cho lên màu đẹp.",
      "tip": "Woks of Life: xào tương cà trước giúp sốt lên màu đỏ đẹp và dậy mùi hơn là đổ thẳng vào nước.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Cho hành tây, ớt chuông, cà chua và dứa vào đảo nhanh khoảng 1 phút. Đổ hỗn hợp sốt và nước ép dứa vào, đun sôi nhẹ khoảng 2 phút.",
      "tip": "Rau củ chỉ xào sơ để giữ độ giòn — Woks of Life xào 30 giây, Red House Spice om 5 phút; món phi lê này theo cách xào nhanh.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Khi sốt đang sôi lăn tăn, vừa khuấy vừa rót từ từ bột ngô pha loãng vào đến khi sốt sánh vừa đủ bám thìa.",
      "tip": "Woks of Life: rót chậm tay, khuấy liên tục — dừng ngay khi sốt phủ được mặt thìa, đừng để quá đặc.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 11,
      "instruction": "Cho cá chiên giòn vào wok, dùng động tác xúc-gập nhẹ 3–4 lần cho sốt bám đều từng miếng cá. Rắc hành lá lên trên.",
      "tip": "Woks of Life nhấn mạnh: chỉ đảo 3–4 cái, đảo nhiều cá mất giòn và nát."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn ngay ra đĩa khi còn nóng, ăn kèm cơm trắng.",
      "tip": "Cả hai nguồn đều yêu cầu dọn ngay — sốt chua ngọt để lâu làm lớp cá chiên bị ỉu."
    }
  ],
