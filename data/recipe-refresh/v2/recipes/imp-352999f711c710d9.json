  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế nguyên liệu: gà cắt miếng vuông khoảng 2,5 cm. Gừng: lấy 1 muỗng cà phê bào nhuyễn để ướp, phần còn lại thái lát mỏng. Hành lá cắt khúc dài 5 cm, tách riêng phần trắng và phần xanh. Tỏi và hành tím đập dập.",
      "tip": "WOL: đập dập gừng, tỏi, phần trắng hành lá bằng sống dao giúp dậy mùi hơn thái lát."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp gà: cho gà vào tô cùng 1 muỗng canh rượu Thiệu Hưng, 2 muỗng cà phê xì dầu nhạt, muối, gừng bào và 1,5 muỗng canh bột bắp. Trộn đều đến khi gà thấm hết nước.",
      "tip": "OC: trộn đến khi chất lỏng được gà hấp thụ hoàn toàn rồi mới cho bột bắp vào áo đều; ướp 10–15 phút.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sốt: trong chén nhỏ khuấy đều nước dùng gà, dầu hào, 4 muỗng cà phê xì dầu nhạt còn lại, đường, 0,5 muỗng canh bột bắp và tiêu trắng. Để riêng.",
      "tip": "Kết hợp OC (sốt) và WOL (tiêu trắng, xì dầu đặc cho màu). Khuấy lại trước khi đổ vào chảo vì bột bắp lắng xuống."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng chảo (tốt nhất là wok) trên lửa vừa–lớn, cho dầu lạc vào tráng đều quanh chảo đến khi dầu nóng già, hơi bốc khói.",
      "tip": "OC dùng chảo chống dính lớn cũng được; WOL: chảo phải thật nóng để áp chảo gà không bị dính."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho gừng thái lát vào, đảo đến khi cạnh gừng xém vàng. Thêm tỏi, hành tím và phần trắng hành lá đã đập dập, đảo nhanh 15–20 giây cho thơm.",
      "tip": "OC: để gừng xém cạnh sẽ thơm và dai ngon hơn; WOL: phi gừng trước 15 giây rồi mới cho gà."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho gà vào, dàn thành một lớp mỏng, áp chảo 1–2 phút không đảo để mặt dưới vàng xém.",
      "tip": "OC: không xếp chồng miếng gà — xếp chồng sẽ hấp hơi thay vì áp chảo; chảo nhỏ thì chia 2 mẻ."
    },
    {
      "stepNumber": 7,
      "instruction": "Lật gà, áp mặt còn lại khoảng 1 phút cho vàng đều.",
      "tip": "WOL áp mỗi mặt 45 giây và 30 giây; OC áp 1–2 phút mỗi mặt — gà còn nấu tiếp với sốt nên không cần chín hẳn lúc này."
    },
    {
      "stepNumber": 8,
      "instruction": "Rưới 2 muỗng canh rượu Thiệu Hưng quanh thành chảo nóng, đảo nhanh tay để hơi rượu bốc lên khử mùi và lấy hết phần cháy dưới đáy chảo.",
      "tip": "OC: tráng rượu quanh mép chảo tạo hơi nước làm bong lớp cháy — đó là phần ngon nhất."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho phần xanh hành lá và ớt sừng (nếu dùng) vào, đảo 30 giây–1 phút đến khi hành lá hơi mềm, vẫn giữ màu xanh.",
      "tip": "OC: chỉ đảo đến khi hành bắt đầu mềm để giữ độ giòn và màu sắc."
    },
    {
      "stepNumber": 10,
      "instruction": "Khuấy lại chén sốt, đổ vào chảo, đảo đều khoảng 30 giây đến khi sốt sánh lại, bám đều miếng gà.",
      "tip": "WOL: nếu thích sốt đặc hơn, pha thêm bột bắp với nước rồi cho từ từ vào."
    },
    {
      "stepNumber": 11,
      "instruction": "Tắt bếp, rưới dầu mè lên, đảo một lần nữa cho thơm.",
      "tip": "OC: cho dầu mè sau khi tắt bếp để giữ mùi thơm, dầu mè đun lâu dễ đắng."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn ra đĩa, ăn nóng với cơm trắng.",
      "tip": "OC: món này ăn kèm cơm trắng là ngon nhất; WOL gợi ý thêm rau xào như cải thìa."
    }
  ],
