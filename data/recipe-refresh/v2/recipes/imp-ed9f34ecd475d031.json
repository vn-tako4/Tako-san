  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau sống: tía tô, kinh giới, xà lách nhặt bỏ lá già, rửa sạch, ngâm nước muối loãng khoảng 15-30 phút rồi vớt ra vẩy ráo nước. Dưa chuột rửa sạch, gọt vỏ (tùy thích), thái lát mỏng. Bún lá cắt thành miếng vừa ăn.",
      "tip": "2sao: ngâm rau trong nước muối loãng 30 phút để rau sạch và giòn.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 2,
      "instruction": "Luộc thịt: thịt ba chỉ rửa sạch với nước muối loãng, cho vào nồi cùng 2 lít nước, 1 muỗng cà phê muối và củ gừng đập dập. Luộc khoảng 20-25 phút đến khi thịt chín mềm. Vớt ra để nguội rồi thái lát mỏng.",
      "tip": "phunutoday: luộc với muối và gừng để khử mùi hôi của thịt; 2sao: luộc với 1 lít nước.",
      "timerMinutes": 25
    },
    {
      "stepNumber": 3,
      "instruction": "Chiên đậu: đậu phụ cắt miếng vuông vừa ăn. Đun nóng 300 ml dầu ăn, thả đậu vào chiên đến khi vàng giòn đều các mặt thì vớt ra để ráo dầu.",
      "tip": "phunutoday: chiên vàng giòn đều các mặt; 2sao: đậu chiên giòn là thành phần không thể thiếu."
    },
    {
      "stepNumber": 4,
      "instruction": "Chiên chả cốm (nếu dùng): cắt chả cốm thành miếng vừa ăn, chiên trong dầu nóng đến vàng giòn hai mặt, vớt ra để ráo dầu.",
      "tip": "phunutoday: chả cốm là thành phần tùy chọn; chiên lửa vừa để không bị cháy."
    },
    {
      "stepNumber": 5,
      "instruction": "Sơ chế dồi/lòng non (nếu dùng): rửa sạch với nước muối pha loãng và chút rượu trắng để khử mùi, luộc chín rồi cắt miếng vừa ăn.",
      "tip": "phunutoday: dồi/lòng non là thành phần tùy chọn."
    },
    {
      "stepNumber": 6,
      "instruction": "Pha mắm tôm: cho 4 muỗng canh mắm tôm vào bát, thêm 1 muỗng canh đường, 1 muỗng cà phê rượu trắng, vắt nước cốt 3 quả quất vào. Dùng đũa đánh đều, nhanh tay đến khi mắm sủi bọt.",
      "tip": "eva (bí quyết nhà hàng): rượu trắng giúp mắm tôm giảm mùi nồng, nổi bọt nhanh và thơm dễ chịu hơn; mắm tôm ngon có màu xanh tím mịn."
    },
    {
      "stepNumber": 7,
      "instruction": "Múc 2 muỗng canh dầu đang nóng từ chảo vừa chiên đậu rưới vào bát mắm tôm, khuấy đều. Thêm bột ngọt và ớt băm tùy khẩu vị.",
      "tip": "2sao: dầu nóng giúp mắm tôm béo thơm; phunutoday: có thể thêm chút dầu nóng hoặc mỡ từ đậu chiên cho vị béo."
    },
    {
      "stepNumber": 8,
      "instruction": "Bày mẹt: xếp bún lá, đậu phụ chiên, thịt ba chỉ thái lát, chả cốm, dưa chuột thái lát và các loại rau sống quanh mẹt; đặt bát mắm tôm đã pha ở giữa.",
      "tip": "phunutoday: mỗi người tự chấm và điều chỉnh vị mắm tôm theo sở thích."
    },
    {
      "stepNumber": 9,
      "instruction": "Thưởng thức: gắp bún, đậu, thịt chấm ngập mắm tôm, ăn kèm dưa chuột và rau sống.",
      "tip": "2sao: mắm tôm là linh hồn của món ăn — nên pha vừa miệng trước khi dọn."
    }
  ],
