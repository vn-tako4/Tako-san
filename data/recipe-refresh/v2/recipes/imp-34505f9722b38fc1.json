  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Băm thật nhỏ cà rốt, cần tây và hành tây để làm phần rau nền soffritto.",
      "tip": "Băm càng nhuyễn, rau càng tan vào thịt khi hầm lâu, sốt sánh mịn mà không cần xay.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Thái pancetta thành hạt lựu nhỏ khoảng 5 mm."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng dầu ô liu và bơ trong nồi đáy dày ở lửa vừa; cho pancetta vào đảo 3–4 phút cho ra mỡ và hơi xém cạnh.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 4,
      "instruction": "Cho thịt bò xay và thịt heo xay vào nồi, dàn mỏng; để yên 2–3 phút cho một mặt vàng rồi mới đảo tơi. Nêm muối và tiêu.",
      "tip": "Đừng đảo thịt ngay — để thịt áp chảo vàng một mặt trước sẽ thơm hơn hẳn nhờ phản ứng Maillard.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 5,
      "instruction": "Cho phần rau soffritto đã băm (và tỏi băm nếu dùng) vào, xào 5–6 phút đến khi rau mềm và trong.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ rượu vang đỏ vào, mở lửa to, khuấy 2–3 phút cho cồn bay hơi hết và thịt ngấm vị vang.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cà chua nghiền và cà chua đặc (nếu dùng) vào, nêm thêm chút muối tiêu, đun cho sôi lăn tăn.",
      "tip": "Cà chua đặc giúp sốt có màu đỏ đẹp và vị đậm; nếu không có thì tăng cà chua nghiền thêm 50 g."
    },
    {
      "stepNumber": 8,
      "instruction": "Hạ nhỏ lửa, đậy vung hờ, hầm ít nhất 90 phút; 15–20 phút khuấy một lần. Nếu sốt khô quá thì châm thêm nước dùng từng ít một.",
      "tip": "Ragù càng hầm lâu càng ngon — Ricette della Nonna hầm 1,5 giờ sau khi cho cà chua; GZ/Agrodolce hầm tổng cộng khoảng 2 giờ. Sốt đạt là khi mỡ nổi lên mặt và thịt mềm nhừ.",
      "timerMinutes": 90
    },
    {
      "stepNumber": 9,
      "instruction": "Khi sốt gần xong, luộc spaghetti trong nồi lớn nước sôi già có muối, thời gian theo bao bì trừ đi 1 phút để mì còn hơi cứng (al dente).",
      "tip": "Nước luộc mì phải mặn như nước biển — đây là lần nêm muối chính cho sợi mì.",
      "timerMinutes": 9
    },
    {
      "stepNumber": 10,
      "instruction": "Vớt mì cho thẳng vào nồi sốt cùng khoảng 1 muôi nước luộc mì; đảo nhanh 1–2 phút trên lửa vừa cho sốt bám đều từng sợi mì.",
      "tip": "Tinh bột trong nước luộc mì giúp sốt nhũ hóa, bóng mượt và bám chặt vào mì.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 11,
      "instruction": "Nếm lại và chỉnh muối, tiêu cho vừa miệng."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn mì ra đĩa sâu lòng khi còn nóng hổi, rắc Parmesan bào lên trên nếu thích và dùng ngay."
    }
  ],
