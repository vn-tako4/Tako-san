  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: bóc vỏ, rút chỉ đen ở lưng, rửa sạch rồi thấm thật khô bằng khăn giấy. Ướp nhẹ với một nhúm muối và tiêu.",
      "tip": "Tôm phải thật khô thì xào mới vàng thơm, không ra nước (GZ)."
    },
    {
      "stepNumber": 2,
      "instruction": "Đun một nồi lớn nước cho sôi mạnh, cho 1.5 muỗng canh muối hạt vào khuấy tan.",
      "tip": "Nước phải mặn như nước biển — đây là lần nêm mặn chính cho sợi mì (LKC).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Tỏi thái lát mỏng; ớt hiểm bỏ hạt, thái khoanh nhỏ; mùi tây và húng quế băm nhỏ; bào lấy phần vỏ vàng của 1 quả chanh (tránh cùi trắng).",
      "tip": "Thái tỏi lát mỏng thay vì băm — lát tỏi vàng đều, thơm mà không dễ cháy như tỏi băm."
    },
    {
      "stepNumber": 4,
