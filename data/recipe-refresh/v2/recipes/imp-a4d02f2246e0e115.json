  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế gà: rửa sạch đùi gà, thấm thật khô bằng khăn giấy; đùi lớn thì chặt đôi. Nêm đều muối và tiêu đen lên cả hai mặt.",
      "tip": "Simple Italy: thấm khô kỹ để khi áp chảo gà vàng giòn và không bị bắn dầu."
    },
    {
      "stepNumber": 2,
      "instruction": "Áo bột: rắc 2 muỗng canh bột mì lên gà, xoa đều rồi giũ bỏ phần bột thừa, chỉ giữ một lớp áo thật mỏng.",
      "tip": "Simple Italy: lớp bột mỏng giúp gà vàng đẹp và làm sốt sánh nhẹ."
    },
    {
      "stepNumber": 3,
      "instruction": "Áp chảo gà: đun chảo to lửa vừa-cao, cho dầu ô liu đến khi dầu hơi bốc khói; xếp gà mặt da xuống, áp khoảng 10 phút, trở đều các mặt đến khi vàng nâu; gắp gà ra đĩa, chắt bớt mỡ thừa trong chảo.",
      "tip": "Simple Italy: áp chảo tổng ~10 phút; giữ lại một ít mỡ trong chảo để xào rau củ cho thơm.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Xào rau củ: cho hành tây vào chảo, đậy nắp xào khoảng 2 phút cho bắt đầu mềm; thêm nấm đùi gà thái lát, cần tây, hương thảo, tỏi băm và lá nguyệt quế; xào khoảng 5 phút đến khi nấm ra hết nước và hành mềm trong.",
      "tip": "Simple Italy: đậy nắp giúp hành mau mềm và nấm ra nước nhanh hơn.",
      "timerMinutes": 7
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ rượu vang trắng vào chảo, đun sôi khoảng 2 phút, vừa đun vừa vét hết phần cháy dính đáy chảo, đến khi không còn mùi cồn nồng.",
      "tip": "Simple Italy: đun đến khi hỗn hợp không còn mùi rượu mới cho cà chua vào.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Thêm cà chua chín, nước dùng gà (nếu dùng), oregano và ớt khô; nêm thêm muối, tiêu; đun sôi rồi hạ lửa nhỏ.",
      "tip": "Italy Abroad: dầm nhẹ cà chua bằng muỗng gỗ cho ra nước và hòa vào sốt."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho gà trở lại chảo, múc sốt rưới phủ lên trên từng miếng gà; đậy nắp hờ, rim lửa nhỏ 25-30 phút đến khi gà chín mềm, xiên vào không còn nước hồng.",
      "tip": "Simple Italy rim ~20 phút đậy nắp một phần; Italy Abroad đậy nắp rim ~30 phút — hai nguồn chênh nhau, lấy 25-30 phút và kiểm tra gà chín là chuẩn.",
      "timerMinutes": 28
    },
    {
      "stepNumber": 8,
      "instruction": "Nếu sốt còn loãng: gắp gà ra đĩa, đun sôi sốt vài phút cho sánh lại rồi cho gà trở vào chảo.",
      "tip": "Italy Abroad: cách làm sốt sánh nhanh mà không làm gà bị khô."
    },
    {
      "stepNumber": 9,
      "instruction": "Vớt bỏ lá nguyệt quế; rắc mùi tây tươi băm lên trên. Để món nghỉ 15-30 phút (hoặc đến 1 giờ) rồi hâm lại nhẹ trước khi dọn.",
      "tip": "Simple Italy: cacciatora để nghỉ rồi hâm lại thì hương vị hòa quyện, ngon hơn hẳn lúc mới nấu xong.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn nóng, kèm bánh mì giòn để chấm sốt, hoặc ăn với mì luộc hay polenta.",
      "tip": "Simple Italy gợi ý ăn kèm: rustic bread, cooked pasta hoặc polenta."
    }
  ],
