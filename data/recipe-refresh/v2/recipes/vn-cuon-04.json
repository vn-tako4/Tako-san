  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế gà: rửa sạch gà với nước, chà xát thịt với một ít muối và vài lát gừng để khử mùi hôi, sau đó rửa sạch lại.",
      "tip": "Mẹo của Bách Hóa Xanh: chà muối + gừng là bước khử mùi tanh hiệu quả nhất cho gà luộc."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho gà vào nồi, đổ nước lạnh xâm xấp ngập gà, thêm 1 thìa muối, mấy lát gừng và 1 củ hành tím đập dập. Đun lửa to 5–10 phút đến khi nước sôi (không để sôi sùng sục tránh rách da gà), sau đó hạ lửa nhỏ luộc thêm khoảng 20 phút. Tắt bếp, ngâm gà trong nồi thêm 30 phút rồi vớt ra.",
      "tip": "webtretho: cách luộc – ngâm này giúp thịt gà chín tới, dai ngọt, không bị khô.",
      "timerMinutes": 50
    },
    {
      "stepNumber": 3,
      "instruction": "Trong lúc chờ gà nguội: bắp cải thái sợi thật mỏng, rửa sạch, để ráo nước. Cà rốt gọt vỏ, bào sợi nhỏ.",
      "tip": "Bào sợi càng mỏng, gỏi càng thấm và giòn."
    },
    {
      "stepNumber": 4,
      "instruction": "Hành tây bóc vỏ, cắt đôi, thái lát thật mỏng. Pha chén nước gồm 2 muỗng canh giấm + 1 muỗng canh đường + 1/2 muỗng cà phê muối, cho hành tây vào trộn đều, thêm vài viên đá, cất ngăn mát tủ lạnh; khi nào trộn gỏi mới vớt ra để ráo.",
      "tip": "webtretho: ngâm giấm đá giúp hành tây giòn, bớt hăng. Bách Hóa Xanh chỉ ngâm nước đá 5 phút — hai cách đều được, ngâm giấm đá thơm hơn.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 5,
      "instruction": "Rau răm nhặt lấy lá và ngọn non, rửa sạch, cắt khúc. Lá chanh rửa sạch, thái nhuyễn. Ớt sừng thái sợi; ớt hiểm và tỏi băm nhuyễn. Chanh vắt lấy nước cốt, bỏ hạt. Đậu phộng rang giã dập."
    },
    {
      "stepNumber": 6,
      "instruction": "Pha nước trộn gỏi: cho 3 muỗng canh nước mắm + 2 muỗng canh nước cốt chanh + 2,5 muỗng canh đường vào chén, khuấy cho tan đường, sau đó cho tỏi băm và ớt băm vào trộn đều. Nêm lại cho vừa khẩu vị chua – mặn – ngọt.",
      "tip": "webtretho: hỗn hợp này có vị chua chua ngọt ngọt rất dễ ăn."
    },
    {
      "stepNumber": 7,
      "instruction": "Gà nguội bớt thì xé thịt thành miếng vừa theo thớ (không xé quá nhỏ sẽ mất vị ngọt của thịt — webtretho). Cho thịt gà vào âu lớn, rưới một ít nước trộn vào đảo đều cho thịt thấm trước.",
      "tip": "Ướp thịt trước giúp từng miếng gà đậm đà hơn là trộn chung một lượt.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Cho bắp cải, cà rốt, hành tây (đã vớt ráo) vào âu thịt gà, rưới phần nước trộn còn lại, dùng tay (đeo găng) bóp trộn nhẹ nhàng cho các nguyên liệu hòa quyện.",
      "tip": "Bóp nhẹ tay để bắp cải không ra nước làm gỏi bị nhão."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho rau răm và lá chanh vào, trộn đều lần cuối. Nêm nếm lại cho vừa ăn."
    },
    {
      "stepNumber": 10,
      "instruction": "Bày gỏi ra đĩa, rắc hành phi, đậu phộng rang giã dập và ớt sừng thái sợi lên trên. Thưởng thức ngay.",
      "tip": "Bách Hóa Xanh: gỏi ngon hơn khi ăn kèm cháo gà nóng."
    }
  ],
