  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Đậu phụ rửa nhẹ dưới vòi nước, để ráo, cắt miếng vuông vừa ăn dày khoảng 1.5 cm.",
      "tip": "Để đậu thật ráo nước giúp chiên giòn, không bắn dầu."
    },
    {
      "stepNumber": 2,
      "instruction": "Sả bóc lớp vỏ già, rửa sạch, băm nhỏ phần non. Tỏi bóc vỏ băm nhuyễn; ớt sừng thái lát xéo, ớt cay thái nhỏ."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sốt: cho nước mắm, dầu hào, xì dầu, tương ớt, đường và 2 muỗng canh nước vào chén, khuấy tan.",
      "tip": "Pha sốt trước để khi xào chỉ việc đổ vào — tránh đảo lâu làm đậu nát."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng dầu ăn trên lửa vừa, cho đậu vào chiên vàng giòn các mặt rồi vớt ra để ráo dầu.",
      "tip": "Eva chiên đậu trước, xào sả ớt sau rồi mới cho đậu vào lại — giữ đậu giòn."
    },
    {
      "stepNumber": 5,
      "instruction": "Chắt bớt dầu, chừa lại khoảng 1 muỗng canh trong chảo; cho sả, tỏi, ớt vào phi thơm đến khi sả vàng, dậy mùi.",
      "tip": "VnExpress phi sả-tỏi-ớt riêng cho thơm vàng trước khi làm sốt — không phi cháy sẽ đắng."
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ hỗn hợp sốt vào chảo, đảo đều đến khi sốt sánh lại."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho đậu đã chiên vào, đảo nhẹ tay trên lửa nhỏ khoảng 5 phút cho đậu thấm đều sốt.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm lại cho vừa miệng, rắc tiêu xay, bày ra đĩa, ăn nóng với cơm trắng."
    }
  ],
