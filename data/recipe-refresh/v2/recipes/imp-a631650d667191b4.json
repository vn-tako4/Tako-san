  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế mực: một tay giữ thân, một tay kéo mạnh đầu và nội tạng ra khỏi thân. Loại bỏ túi nội tạng, cắt bỏ phần mắt và mỏ (beak) ở giữa xúc tu. Rút bỏ xương sống trong suốt trong thân mực.",
      "tip": "KB: làm khéo để không làm vỡ túi mực; nếu mực còn da, có thể lột bỏ."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho muối hạt vào chà xát kỹ thân và xúc tu mực cho hết nhớt, rửa lại nhiều lần dưới vòi nước lạnh đến khi không còn trơn, để ráo.",
      "tip": "Maangchi: chà muối vào các giác hút của xúc tu để sạch cát bẩn; rắc muối lên tay để có độ bám khi lột da mực."
    },
    {
      "stepNumber": 3,
      "instruction": "Khía mặt trong của thân mực thành hình caro nông (không cắt thủng). Có thể kê 2 chiếc đũa hai bên thân mực để dao không cắt quá sâu.",
      "tip": "Maangchi: đường khía giúp sốt bám đều, mực nhanh chín và khi nướng sẽ cuộn đẹp mắt. Khía cả xúc tu và vây mực."
    },
    {
      "stepNumber": 4,
      "instruction": "Pha sốt ướp: trộn đều tương ớt, ớt bột, xì dầu, đường, siro, rượu nấu ăn, tỏi băm, gừng băm, tiêu đen và 1/2 lượng hành lá thái nhỏ trong tô lớn, khuấy đến khi mịn."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho mực vào tô sốt, trộn đều cho sốt phủ kín mọi mặt. Bọc lại, ướp trong tủ lạnh 30 phút.",
      "tip": "KB: ướp 30 phút là đủ; không ướp qua đêm vì mực sẽ bị bở.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 6,
      "instruction": "Làm nóng chảo nướng hoặc vỉ nướng ở lửa lớn, phết một lớp dầu ăn thật mỏng.",
      "tip": "Chảo phải thật nóng trước khi cho mực vào thì mực mới săn nhanh và không ra nước."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho mực lên chảo, để mặt khía hướng lên trên. Nướng 1 phút đến khi mặt dưới săn lại và chuyển màu đục.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Lật mực, phết thêm sốt ướp lên trên mặt mực, nướng thêm khoảng 2 phút. Nếu thân mực cuộn lại, dùng kẹp duỗi thẳng ra.",
      "tip": "Maangchi: vừa nướng vừa phết sốt để sốt thấm và tạo lớp bóng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Lật mực lần nữa, phết đều sốt khắp thân mực, nướng thêm 1 phút đến khi sốt keo lại, mực chuyển màu đỏ bóng.",
      "tip": "Maangchi: tổng thời gian nướng chỉ khoảng 4-5 phút — nướng quá lâu mực sẽ dai.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 10,
      "instruction": "Bày mực ra đĩa đã lót lá tía tô thái sợi (hoặc xà lách).",
      "tip": "KB: mực nướng cay ăn kèm lá tía tô rất hợp — có thể dùng lá tía tô để cuốn."
    },
    {
      "stepNumber": 11,
      "instruction": "Rắc nốt 1/2 lượng hành lá và mè rang lên trên, rưới phần dầu mè còn lại, vắt nước cốt chanh lên mực."
    },
    {
      "stepNumber": 12,
      "instruction": "Dùng kéo cắt thân mực thành khoanh, xúc tu cắt miếng vừa ăn ngay trước khi dọn. Ăn nóng.",
      "tip": "Maangchi: cắt mực ngay tại bàn khi còn xèo xèo là cách thưởng thức đúng kiểu quán nhậu Hàn."
    }
