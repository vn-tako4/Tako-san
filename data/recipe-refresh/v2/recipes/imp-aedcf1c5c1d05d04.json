  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Tôm bóc vỏ, bỏ chỉ đen, rửa sạch, để thật ráo. Ướp tôm với một nhúm muối và tiêu, để khoảng 10 phút.",
      "tip": "Nguồn 2 ướp tôm với muối + tiêu trước khi xào; để tôm ráo giúp tôm săn và không ra nước khi xào.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Hành lá cắt khúc 3 cm, để riêng phần đầu trắng và phần lá xanh. Hành tây thái lát mỏng. Tỏi băm nhỏ."
    },
    {
      "stepNumber": 3,
      "instruction": "Làm nóng 1 muỗng canh dầu ăn cùng bơ (nếu dùng) trong chảo lớn trên lửa vừa. Cho tỏi băm vào phi thơm khoảng 30 giây.",
      "tip": "Nguồn 1 phi tỏi + hành lá trong bơ; cẩn thận không để tỏi cháy sẽ đắng."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho tôm vào, tăng lửa lớn, xào 2-3 phút đến khi tôm chuyển hồng và săn lại.",
      "tip": "Nguồn 1: xào đến khi tôm vàng nâu; không xào quá lâu tôm sẽ dai.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Thêm xì dầu, mirin (nếu dùng) và đường vào chảo, đảo nhanh tay 30 giây - 1 phút cho tôm thấm đều sốt.",
      "tip": "Nguồn 1 cho sốt vào sau khi tôm đã vàng; nguồn 2 cho rượu nấu ăn + xì dầu + đường vào cùng lúc với tôm.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Cho hành tây (nếu dùng) và phần đầu trắng hành lá vào, xào thêm 1-2 phút cho vừa chín tới.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nếm lại muối tiêu cho vừa miệng."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho phần lá xanh hành lá vào, đảo nhanh một lượt rồi tắt bếp."
    },
    {
      "stepNumber": 9,
      "instruction": "Dọn tôm ra đĩa, rắc hạt mè rang lên trên. Ăn nóng với cơm trắng.",
      "tip": "Nguồn 1: nghiền nhẹ hạt mè trong lòng bàn tay trước khi rắc để dậy mùi thơm."
    }
  ],
