  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế xương heo: rửa sạch với nước muối loãng để khử mùi, chần sơ qua nước sôi 3-5 phút rồi vớt ra rửa lại bằng nước sạch, để ráo.",
      "tip": "Chần xương giúp nước dùng trong và không bị hôi (Điện máy XANH).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế nguyên liệu hầm: tôm khô rửa sạch, ngâm nước 15 phút cho nở mềm; khô mực nướng sơ trên lửa cho dậy mùi thơm; hành tây và hành tím bóc vỏ, nướng cho cháy xém mặt ngoài; củ cải trắng gọt vỏ, cắt khúc vừa.",
      "tip": "Nướng khô mực và hành là bí quyết tạo mùi thơm đặc trưng cho nước dùng hủ tiếu mực (ĐMX, VinWonders).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Hầm nước dùng: cho 1,5 lít nước vào nồi lớn, thêm xương heo, tôm khô đã ngâm, khô mực nướng, hành tây, hành tím nướng và 1/2 muỗng canh muối. Đun sôi rồi hạ lửa nhỏ, hầm khoảng 1 giờ, thường xuyên vớt bọt để nước trong.",
      "tip": "Luôn giữ lửa nhỏ liu riu; nước sôi mạnh làm nước dùng bị đục (ĐMX).",
      "timerMinutes": 60
    },
    {
      "stepNumber": 4,
      "instruction": "Nêm nước dùng: vớt bỏ hành tây, hành tím đã hầm. Nêm thêm 1/2 muỗng canh muối, 1 muỗng canh đường phèn và 2 muỗng canh nước mắm. Đun sôi trở lại rồi tắt bếp, giữ ấm.",
      "tip": "Nêm nhạt hơn khẩu vị một chút vì khi chan vào tô, nước sẽ đậm thêm."
    },
    {
      "stepNumber": 5,
      "instruction": "Xào thịt băm: đun nóng 1 muỗng canh dầu ăn, cho thịt băm vào đảo đều đến khi săn và chuyển màu. Nêm 1/2 muỗng cà phê muối và 1/2 muỗng cà phê tiêu, đảo thêm 1 phút rồi tắt bếp, để riêng.",
      "tip": "Dùng dầu phi hành tỏi để xào thịt sẽ thơm hơn (mẹo của ĐMX).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Sơ chế và chần mực: mực tươi làm sạch ruột, bỏ túi mực, rửa sạch rồi cắt khoanh vừa ăn. Đun sôi một nồi nước khác, cho mực vào chần vài chục giây đến khi vừa cong lại thì vớt ra ngay.",
      "tip": "Chỉ chần mực vừa chín tới — chần lâu mực sẽ dai và mất độ giòn ngọt (ĐMX nhấn mạnh).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Trụng hủ tiếu và giá: đun sôi nồi nước, cho sợi hủ tiếu vào trụng vài giây đến 1 phút cho mềm rồi vớt ra chia đều vào 4 tô; trụng sơ giá đỗ rồi cho vào tô cùng hẹ và cần tàu.",
      "tip": "VinWonders: trụng giá và hủ tiếu khoảng 1 phút trước khi cho vào tô.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Hoàn thiện và thưởng thức: xếp thịt băm xào và mực đã chần lên mặt tô, chan nước dùng thật nóng ngập mặt. Rắc hành phi, tỏi phi và vài lát ớt tùy khẩu vị. Ăn ngay khi còn nóng.",
      "tip": "Chan nước dùng đang sôi để giữ sợi hủ tiếu nóng và mực không bị tanh."
    }
  ],
