  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Làm sạch cá: mổ bỏ ruột, đánh vảy, rửa sạch dưới vòi nước, thấm thật khô bằng khăn giấy.",
      "tip": "Beyond Kimchee: cá thấm khô thì da mới giòn và không dính vỉ."
    },
    {
      "stepNumber": 2,
      "instruction": "Khía 3-4 đường chéo mỗi bên thân cá để cá chín đều và tránh da bị nổ khi nướng.",
      "tip": "Beyond Kimchee."
    },
    {
      "stepNumber": 3,
      "instruction": "Quét đều dầu ăn lên mình cá, rắc muối biển đều hai mặt cá.",
      "tip": "Beyond Kimchee khuyên phết dầu cả lên da cá để da không dính vỉ nướng."
    },
    {
      "stepNumber": 4,
      "instruction": "Nếu dùng rượu nấu ăn: xoa đều rượu lên cá, để 10 phút cho bớt tanh rồi thấm khô lại.",
      "tip": "Theo nguồn 10000recipe (Hàn); bước tùy chọn.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 5,
      "instruction": "Đun vỉ nướng thật nóng. Phết một lớp dầu mỏng lên vỉ nướng.",
      "tip": "MÂU THUẪN PHƯƠNG PHÁP: Beyond Kimchee nướng trên vỉ nóng; nguồn 10000recipe áp chảo — cho cá vào chảo dầu nóng, đậy nắp lửa vừa cho chín rồi mở nắp lửa lớn cho giòn. Công thức này theo Beyond Kimchee vì đúng 'nướng' trong tên món; có thể áp chảo nếu không có vỉ."
    },
    {
      "stepNumber": 6,
      "instruction": "Đặt cá lên vỉ, nướng mặt đầu 6-8 phút đến khi thịt săn chắc khi ấn nhẹ và da vàng giòn. Lật cá cẩn thận, nướng mặt còn lại đến khi chín hoàn toàn — thịt trắng đục, dễ tách khỏi xương.",
      "tip": "Beyond Kimchee: chỉ lật một lần, không lật đi lật lại nhiều lần.",
      "timerMinutes": 14
    },
    {
      "stepNumber": 7,
      "instruction": "Trong lúc nướng cá, pha nước chấm: trộn xì dầu Hàn, nước cốt chanh, tỏi băm, ớt bột Hàn và nước trong bát nhỏ, khuấy đều.",
      "tip": "Beyond Kimchee."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho hành lá thái nhỏ, muối vừng và dầu mè vào bát nước chấm, trộn đều.",
      "tip": "Theo nguồn 10000recipe (Hàn)."
    },
    {
      "stepNumber": 9,
      "instruction": "Gắp cá nướng ra đĩa. Rưới một nửa nước chấm lên mình cá, rắc rau mùi thái nhỏ lên trên.",
      "tip": "Beyond Kimchee."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn nóng ngay với cơm trắng; nửa nước chấm còn lại để chấm kèm khi ăn.",
      "tip": "Beyond Kimchee: dọn nóng với cơm."
    }
  ],
