  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế sườn: rửa sạch sườn bò, ngâm trong nước lạnh 30-60 phút, thay nước 2 lần để ra bớt máu.",
      "tip": "Maangchi nhấn mạnh: bỏ qua bước ngâm + chần, món thành phẩm có thể bị hôi.",
      "timerMinutes": 45
    },
    {
      "stepNumber": 2,
      "instruction": "Ngâm 5 nấm hương khô trong 500 ml nước lạnh 3-4 giờ cho mềm. Vớt nấm ra, lọc giữ lại nước ngâm.",
      "tip": "Maangchi: đong lấy 2 cups (500 ml) nước ngâm; nếu thiếu thì châm thêm nước lạnh cho đủ.",
      "timerMinutes": 180
    },
    {
      "stepNumber": 3,
      "instruction": "Đun sôi một nồi lớn nước, cho sườn đã ráo vào chần 5 phút, thỉnh thoảng đảo. Vớt sườn ra rửa thật sạch dưới vòi nước lạnh, rửa sạch nồi.",
      "tip": "Maangchi: rửa nồi bằng xà phòng sau khi chần để loại bỏ cặn bẩn, nước hầm sau này trong và thơm.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Pha nước sốt: cho xì dầu, mirin, đường, tiêu đen, tỏi băm, gừng băm, 1/2 củ hành tây xay nhuyễn và 500 ml nước ngâm nấm vào tô, khuấy đều cho tan đường."
    },
    {
      "stepNumber": 5,
      "instruction": "Sơ chế rau củ: nấm hương cắt bỏ chân, cắt mỗi cái làm 4; củ cải và cà rốt cắt khối khoảng 4 cm (có thể bo tròn cạnh cho đẹp mắt); 1/2 củ hành tây còn lại để nguyên; hạt dẻ bóc vỏ; táo tàu bổ đôi bỏ hạt.",
      "tip": "Maangchi bo tròn củ cải/cà rốt thành viên ~2.5 cm cho đẹp mắt ngày lễ — không bắt buộc."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho sườn vào nồi, đổ nước sốt đã pha vào. Đậy nắp, nấu lửa vừa-cao 20 phút.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 7,
      "instruction": "Cho nấm hương, hạt dẻ, củ cải, cà rốt vào nồi, đảo nhẹ. Đậy nắp, hạ lửa nhỏ, hầm 60 phút, thỉnh thoảng mở nắp đảo nhẹ để không bén đáy.",
      "tip": "KB cũng cho rau củ vào giữa chừng (sau khi hầm sườn trước) để rau không bị nát — khớp với cách này.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 8,
      "instruction": "Cho táo tàu và siro gạo vào, đảo đều. Đậy nắp, rim thêm 10 phút cho thịt gần róc xương.",
      "tip": "Maangchi cho táo tàu và siro gạo vào sau cùng vì táo tàu nhanh mềm, cho sớm sẽ nát.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 9,
      "instruction": "Kiểm tra độ mềm: dùng xiên tre chọc vào thịt, xiên xuyên qua dễ dàng là đạt. Nếu chưa mềm, thêm khoảng 240 ml nước và hầm thêm 15-30 phút tùy độ dày của sườn.",
      "tip": "Sườn dày mỏng khác nhau nên thời gian hầm có thể chênh lệch — tin vào xiên tre hơn đồng hồ.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 10,
      "instruction": "Mở nắp, vặn lửa lớn, múc nước sốt dưới đáy nồi rưới lên thịt và rau củ vài phút, đến khi nước sốt cạn sánh lại, thịt và rau bóng đẹp.",
      "tip": "Maangchi: đây là bước tạo lớp sốt bóng đặc trưng của galbi-jjim — đảo nhẹ tay để rau củ không vỡ.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 11,
      "instruction": "Bày sườn và rau củ ra đĩa lớn, rắc hạt thông và bạch quả (nếu dùng) cùng hành lá cắt khúc lên trên. Ăn nóng với cơm trắng.",
      "tip": "KB: rưới thêm dầu mè (nếu dùng) khi vừa tắt bếp để dậy mùi thơm."
    }
  ],
