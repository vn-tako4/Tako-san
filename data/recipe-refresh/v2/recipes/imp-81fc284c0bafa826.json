  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Tôm rửa sạch, bóc vỏ, bỏ chỉ lưng, để ráo. Sả lấy phần gốc trắng, băm nhỏ; tỏi bóc vỏ băm nhỏ; ớt hiểm thái lát mỏng hoặc băm nhỏ; lá chanh xé đôi.",
      "tip": "Băm sả thật nhỏ để khi xào sả thơm và ăn được, không bị xơ."
    },
    {
      "stepNumber": 2,
      "instruction": "Trộn đều trong chén nhỏ: đường dừa, xì dầu, nước tương gia vị, dầu hào, nước mắm, xì dầu đặc và nước lọc để làm sốt xào.",
      "tip": "Pha sẵn sốt giúp xào nhanh, tôm không bị nấu quá chín."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng chảo (hoặc wok) với 2 muỗng canh dầu ăn trên lửa vừa-cao. Cho tỏi, sả và ớt hiểm vào phi thơm khoảng 1–2 phút.",
      "tip": "Nguồn A: phi đến khi thơm nức là được, đừng để tỏi cháy sẽ đắng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 4,
      "instruction": "Cho lá chanh và bột nghệ (nếu dùng) vào, đảo nhanh khoảng 30 giây cho dậy mùi.",
      "tip": "Bột nghệ giúp tôm có màu vàng óng đẹp mắt (nguồn A).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Tăng lửa lớn, cho tôm vào xào nhanh tay, đảo đều cho tôm thấm đều hỗn hợp sả ớt.",
      "tip": "Nguồn A: dàn tôm áp sát mặt chảo, chiên mỗi mặt cho hơi xém vàng rồi mới đảo.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Rưới đều chén sốt đã pha vào chảo, đảo nhanh tay cho sốt bám đều từng con tôm.",
      "tip": "Nguồn A lưu ý: không thêm nước vì tôm sẽ tự ra nước trong quá trình xào.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Xào tiếp đến khi tôm chuyển màu hồng cam, cong lại và sốt sệt lại, bám đều quanh tôm.",
      "tip": "Tôm chỉ cần xào tổng cộng 3–4 phút; xào lâu tôm bị dai, khô.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Nếm lại, điều chỉnh mặn/ngọt theo khẩu vị (thêm đường nếu cần ngọt, nước mắm nếu cần mặn).",
      "tip": "Nguồn B nhấn mạnh: nêm nếm lại cuối cùng vì mỗi loại xì dầu/nước mắm có độ mặn khác nhau."
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, gắp tôm ra đĩa, rưới phần sốt sả ớt trong chảo lên trên. Ăn nóng với cơm trắng.",
      "tip": "Món này ăn kèm cơm nóng là ngon nhất; có thể rắc thêm lá chanh thái sợi nếu thích."
    }
  ],
