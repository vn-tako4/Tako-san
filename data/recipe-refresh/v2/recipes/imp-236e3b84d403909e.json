  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế đùi gà: nhổ sạch lông còn sót, chà xát muối hạt và chanh tươi khắp mặt đùi để khử mùi hôi, rửa sạch lại với nước, để ráo.",
      "tip": "baohaiphong: chà xát chanh + muối hạt là cách khử mùi tanh hiệu quả."
    },
    {
      "stepNumber": 2,
      "instruction": "Gừng đập dập, hành tím đập dập. Hành lá rửa sạch: một nửa cắt khúc 5 cm để cho vào nồi, một nửa thái nhỏ để rắc khi dọn."
    },
    {
      "stepNumber": 3,
      "instruction": "Xếp đùi gà vào nồi, đổ nước lạnh vừa ngập gà. Thêm gừng đập dập, hành tím, hành lá cắt khúc, muối và bột nêm.",
      "tip": "Helen: cho gà vào lúc nước còn lạnh rồi đun nóng từ từ — thả gà vào nước đang sôi da rất dễ rách."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun lửa vừa đến khi sôi, vớt bọt kỹ cho nước trong, sau đó hạ nhỏ lửa.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 5,
      "instruction": "Để sôi lăn tăn 5-6 phút rồi tắt bếp, đậy kín vung và ủ 20-25 phút cho gà chín ngấm từ từ, không bị đỏ xương, không rách da.",
      "tip": "Mâu thuẫn nguồn: Helen ủ 15 phút (30-45 phút nếu muốn mềm); baohaiphong om 25-30 phút sau khi sôi 5 phút. Lấy 20-25 phút cho đùi gà.",
      "timerMinutes": 25
    },
    {
      "stepNumber": 6,
      "instruction": "Kiểm tra độ chín: dùng tăm xiên vào phần dày nhất của đùi, nếu nước chảy ra trong (không còn màu hồng) là gà đã chín.",
      "tip": "Helen: cách thử chín chuẩn bằng tăm."
    },
    {
      "stepNumber": 7,
      "instruction": "Vớt gà ra, ngâm ngay vào âu nước đá 15-20 phút đến khi gà nguội hẳn.",
      "tip": "Cả hai nguồn: đây là bước quyết định độ giòn dai của da và giúp thịt săn, chặt không bị nát.",
      "timerMinutes": 18
    },
    {
      "stepNumber": 8,
      "instruction": "Vớt gà ra để ráo nước. (Tùy chọn) Hòa bột nghệ với một chút mỡ gà rán ra hoặc nước luộc, quết mỏng đều lên da gà cho màu vàng ươm đẹp mắt.",
      "tip": "Helen: rán mỡ gà lấy nước mỡ rồi hòa nghệ; baohaiphong: phết mỡ nghệ tùy chọn."
    },
    {
      "stepNumber": 9,
      "instruction": "Dùng dao sắc chặt đùi gà thành miếng vừa ăn, xếp ngay ngắn ra đĩa.",
      "tip": "Chặt khi gà đã nguội hẳn thì miếng gà không bị vỡ nát."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc hành lá thái nhỏ (và lá chanh thái chỉ nếu dùng) đều lên trên đĩa gà."
    },
    {
      "stepNumber": 11,
      "instruction": "Pha muối chấm: muối hạt + tiêu xay + nước cốt chanh (thêm ớt lát tùy thích). Dọn gà luộc kèm chanh miếng; phần nước luộc có thể nêm lại làm canh hoặc nấu cháo.",
      "tip": "Helen: tận dụng nước luộc gà nấu cháo hoặc trộn gỏi."
    }
  ],
