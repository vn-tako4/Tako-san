  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Lay nuoc cot me: cho me kho vao chen, do nuoc soi vao ngam 5 phut cho mem roi dam nat, loc qua ray bo ba, giu lai nuoc cot.",
      "tip": "Ca hai nguon deu dung me kho lay nuoc cot chu khong dung goi bot me — vi chua thanh tu nhien hon."
    },
    {
      "stepNumber": 2,
      "instruction": "So che dua: dua got vo, bo mat, cat xeo mieng vua an.",
      "tip": "Cat xeo mieng vua an de dua nhanh ra vi chua ngot vao nuoc canh."
    },
    {
      "stepNumber": 3,
      "instruction": "So che rau cu: ca chua rua sach bo mui cau; dau bap rua sach cat lat xeo; doc mung tuoc bo lop vo ngoai, cat xeo khuc vua an.",
      "tip": "phunutoday.vn: doc mung bop voi mot it muoi cho ra het chat ngua roi rua lai that sach truoc khi nau."
    },
    {
      "stepNumber": 4,
      "instruction": "So che dau hu va boa-ro: dau hu non cat mieng vuong vua an, nhe tay de khong vo; hanh boa-ro lay phan dau trang bam nho.",
      "tip": "Dau hu non mem — cat bang dao sac, thao tac nhe nhang."
    },
    {
      "stepNumber": 5,
      "instruction": "Bac noi len bep, cho 1 muong canh dau an vao dun nong, phi thom dau hanh boa-ro bam. Cho ca chua vao xao khoang 2-3 phut cho mem.",
      "tip": "Xao ca chua truoc giup nuoc canh co mau do dep tu nhien.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Do nuoc loc vao noi, dun soi. Cho nuoc cot me vao, nau soi liu riu vai phut cho nuoc canh day vi chua.",
      "tip": "Cho nuoc cot me vao khi nuoc da soi de vi chua hoa quyen deu."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho dau bap vao noi, nau them 5 phut.",
      "tip": "Dau bap cho vao truoc de chin mem nhung van giu mau xanh.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Ha nho lua, cho doc mung va dau hu vao noi, nau them 3-5 phut.",
      "tip": "Cho dau hu vao cuoi cung va khong dao manh de mieng dau khong vo.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 9,
      "instruction": "Nem duong, muoi, hat nem chay vua an (them bot ngot neu thich). Nem nem lai do chua-ngot-man cho hai hoa.",
      "tip": "Canh chua chay ngon o su can bang chua (me, dua, ca chua) — ngot (duong, dua) — man (muoi); nem tung chut mot."
    },
    {
      "stepNumber": 10,
      "instruction": "Muc canh ra to lon, an nong voi com trang hoac bun tuoi.",
      "tip": "Mon nay ngon nhat khi an nong; co the an kem bun tuoi nhu goi y cua phunutoday.vn."
    }
  ],
