  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: bóc vỏ, bỏ đầu, dùng dao xẻ dọc sống lưng lấy bỏ chỉ đen, rửa sạch. Ướp tôm với 1 muỗng cà phê rượu trắng khoảng 5 phút để khử mùi tanh.",
      "tip": "baokhanhhoa: ướp rượu 5 phút trước khi chế biến giúp tôm thơm, không tanh.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Đậu phụ cắt miếng vuông vừa ăn. Cà chua rửa sạch, thái múi cau. Hành lá, ngò rí rửa sạch, thái nhỏ (để riêng phần gốc hành để phi thơm).",
      "tip": "eva: cắt đậu phụ vừa ăn, không quá nhỏ để khi nấu không bị nát."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun sôi một nồi nước, thả đậu phụ vào luộc sơ 1-2 phút rồi vớt ra để ráo.",
      "tip": "baokhanhhoa: luộc sơ giúp loại bớt mùi đậu hũ, món canh thơm ngon hơn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 4,
      "instruction": "Phi thơm phần gốc hành lá (và gừng lát nếu dùng) với 1 muỗng canh dầu ăn, sau đó cho cà chua vào xào đến chín nhuyễn.",
      "tip": "eva: xào cà chua nhuyễn tạo màu đỏ đẹp và vị chua nhẹ cho nước canh."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho tôm đã ướp vào xào cùng đến khi thịt tôm chuyển màu đỏ, săn lại. Nêm thêm một chút hạt nêm.",
      "tip": "eva: xào tôm trước khi đổ nước giúp tôm giữ được độ chắc ngọt."
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ 1.5 lít nước sôi vào nồi, đun cho sôi trở lại. Vớt bọt nếu có để nước canh trong.",
      "tip": "Dùng nước sôi (không dùng nước lạnh) để nước canh ngọt, không bị tanh."
    },
    {
      "stepNumber": 7,
      "instruction": "Khi canh sôi, cho đậu phụ đã luộc sơ vào, hạ lửa nhỏ đun khoảng 5 phút cho đậu ngấm vị.",
      "tip": "eva: đun lửa nhỏ 5 phút; baokhanhhoa lưu ý không dùng đũa đảo mạnh mà lắc nhẹ nồi để đậu không vỡ.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm muối, hạt nêm và bột ngọt cho vừa miệng.",
      "tip": "baokhanhhoa: nêm xì dầu thay muối nếu thích — hai cách nêm khác nhau, file này dùng muối + hạt nêm theo eva."
    },
    {
      "stepNumber": 9,
      "instruction": "Rắc hành lá, ngò rí thái nhỏ và một ít tiêu xay lên trên, tắt bếp. Múc canh ra bát, dùng nóng với cơm.",
      "tip": "eva: cho rau thơm và mì chính ngay trước khi ăn để giữ mùi thơm."
