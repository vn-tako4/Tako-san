  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau củ: khoai tây gọt vỏ, cắt miếng vừa ăn rồi ngâm ngay vào nước lạnh cho ra bớt tinh bột (JOC gọi kỹ thuật gọt cạnh sắc là mentori để khoai không vỡ khi hầm); cà rốt gọt vỏ, cắt xéo kiểu rangiri; hành tây bóc vỏ, bổ múi cau.",
      "tip": "Ngâm khoai trong nước lạnh giúp khoai giữ được hình dáng khi hầm (JOC)."
    },
    {
      "stepNumber": 2,
      "instruction": "Thịt gà rửa sạch, thấm khô, cắt miếng vừa ăn cỡ 3-4 cm."
    },
    {
      "stepNumber": 3,
      "instruction": "Xếp rau củ vào nồi theo thứ tự: hành tây xuống đáy, rồi đến cà rốt, khoai tây lên trên cùng.",
      "tip": "Mẹo của cookpad: củ cứng (hành, cà rốt) cho xuống dưới, khoai mềm để trên cùng thì khoai ít bị nát khi hầm."
    },
    {
      "stepNumber": 4,
      "instruction": "Đổ 500 ml nước vào nồi, thêm rượu sake, mirin, bột dashi và xì dầu, khuấy đều rồi bắc lên bếp đun lửa vừa cho sôi.",
      "tip": "Công thức gốc cho toàn bộ gia vị vào từ đầu để rau củ ngấm vị khi hầm (cookpad)."
    },
    {
      "stepNumber": 5,
      "instruction": "Khi nước sôi, vớt sạch bọt, hạ xuống lửa vừa-nhỏ, đậy nắp (hoặc dùng otoshibuta — nắp thả Nhật) rồi hầm khoảng 15 phút.",
      "tip": "JOC: dùng otoshibuta giữ rau củ không xô đẩy vỡ nát và giúp nước hầm tuần hoàn đều; trong lúc hầm không đảo nhiều.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 6,
      "instruction": "Khi rau củ gần mềm, cho thịt gà vào, đảo nhẹ cho ngập nước hầm, tiếp tục hầm thêm khoảng 5 phút đến khi gà chín hẳn và xiên đũa xuyên qua khoai dễ dàng.",
      "tip": "MÂU THUẪN THỨ TỰ: cookpad (bản gà) hầm rau trước rồi mới cho gà sau; JOC xào hành tây + thịt trước với 1 muỗng canh dầu rồi mới cho khoai, cà rốt và gia vị. Làm theo cookpad vì đúng phiên bản thịt gà của món này.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Nếm nước hầm, điều chỉnh mặn nhạt bằng xì dầu cho vừa miệng. Tắt bếp, để nồi nghỉ 15-30 phút cho rau củ và gà ngấm đều gia vị.",
      "tip": "JOC: để nguội 30-60 phút rồi hâm lại trước khi ăn thì món càng ngấm và ngon hơn; món này để qua đêm ăn càng ngon.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 8,
      "instruction": "Xới nikujaga ra bát sâu cùng một ít nước hầm, rắc hành lá thái nhỏ lên trên. Ăn nóng với cơm trắng.",
      "tip": "Phần thừa bảo quản tủ lạnh 3-4 ngày; không nên đông lạnh cả khoai vì khoai sẽ bị bở (JOC)."
    }
  ],
