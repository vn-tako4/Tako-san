  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Làm nóng lò nướng ở 180°C (350°F)."
    },
    {
      "stepNumber": 2,
      "instruction": "Rửa phi lê cá dưới vòi nước lạnh, dùng khăn giấy thấm thật khô. Xoa đều dầu đậu nành, muối và tiêu đen lên cả hai mặt cá.",
      "tip": "Thấm khô cá giúp gia vị bám tốt và cá không bị tanh khi nướng (nguồn 2)."
    },
    {
      "stepNumber": 3,
      "instruction": "Thái gừng thành sợi chỉ, hành lá cắt khúc dài khoảng 5 cm, tỏi băm nhỏ. Để riêng từng loại."
    },
    {
      "stepNumber": 4,
      "instruction": "Lót một nửa số gừng sợi và hành lá xuống đáy khay nướng vừa khít với cá, xếp các miếng cá lên trên thành một lớp.",
      "tip": "Lớp gừng hành lót dưới giúp cá không dính khay và thấm mùi thơm từ dưới lên (nguồn 1)."
    },
    {
      "stepNumber": 5,
      "instruction": "Khuấy tan đường với xì dầu và nước trong bát nhỏ, rưới đều lên mặt cá. Rắc nốt phần gừng và hành lá còn lại lên trên.",
      "tip": "MÂU THUẪN: nguồn 1 rưới hỗn hợp xì dầu-nước lên cá trước khi nướng; nguồn 2 nướng cá riêng rồi mới rưới xì dầu pha đường sau. Công thức theo nguồn 1."
    },
    {
      "stepNumber": 6,
      "instruction": "Bọc kín khay bằng giấy bạc, cho vào lò nướng 15 phút.",
      "tip": "MÂU THUẪN: nguồn 1 bọc giấy bạc nướng 15 phút ở 350°F; nguồn 2 nướng trần 8-10 phút. Bọc giấy bạc giữ cá mọng nước, phù hợp miếng cá dày.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 7,
      "instruction": "Trong lúc chờ cá nướng, đun nóng dầu mè trong chảo nhỏ, cho tỏi băm vào phi thơm khoảng 30 giây rồi cho hành lá và gừng sợi vào đảo nhanh 1-2 phút, tắt bếp.",
      "tip": "Không phi quá lâu kẻo hành gừng cháy đắng; chỉ cần vừa thơm và hơi mềm (nguồn 2).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Lấy khay cá ra khỏi lò, mở giấy bạc cẩn thận (tránh hơi nóng). Kiểm tra cá chín: thịt đục, dễ tách thớ khi khều nhẹ bằng nĩa."
    },
    {
      "stepNumber": 9,
      "instruction": "Gắp cá ra đĩa sâu lòng, rưới phần nước xốt còn lại trong khay lên trên."
    },
    {
      "stepNumber": 10,
      "instruction": "Rưới hỗn hợp hành, gừng, tỏi phi dầu mè còn nóng lên mặt cá. Dọn ngay với cơm trắng khi còn nóng.",
      "tip": "Dầu mè nóng rưới lên hành gừng sẽ dậy mùi thơm đặc trưng của món cá kiểu Hoa (nguồn 2)."
    }
  ],
