  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế: thịt bò cắt miếng vuông ~5 cm; gừng thái lát; hành lá cắt khúc dài; tỏi đập dập; hành tây thái lát; cà rốt gọt vỏ, cắt khúc vừa ăn.",
      "tip": "Cắt thịt miếng to một chút vì hầm lâu thịt sẽ co lại (Tiffy cắt 2-inch)."
    },
    {
      "stepNumber": 2,
      "instruction": "Chần thịt: cho thịt vào nồi cùng nước lạnh ngập mặt, vài lát gừng, 2 cây hành lá cắt khúc và 1 muỗng canh rượu Thiệu Hưng. Đun sôi 5–10 phút, vớt bọt kỹ. Vớt thịt ra rửa sạch dưới vòi nước lạnh, thấm khô.",
      "tip": "Bước chần với gừng, hành và rượu giúp khử mùi hôi và cho nước hầm trong, vị thịt 'sạch' hơn (Tiffy). Nếu vội có thể bỏ qua bước chần nhưng KHÔNG được bỏ qua bước áp chảo tiếp theo.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng 1 muỗng canh dầu ăn trong nồi lớn trên lửa vừa-cao, cho thịt vào áp vàng đều các mặt khoảng 2–3 phút.",
      "tip": "Áp chảo là bước Tiffy nhấn mạnh 'not to skip' — tạo màu đẹp và vị đậm đà cho món hầm.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Hạ lửa vừa, cho hành tây thái lát vào xào 3–4 phút đến mềm và thơm; cho tỏi đập dập và phần gừng lát còn lại vào đảo thêm 30 giây.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 5,
      "instruction": "Cho tương cà chua, tương đậu cay, xì dầu nhạt, xì dầu đặc và đường phèn vào nồi, đảo đều 2–3 phút cho thịt thấm gia vị và lên màu nâu đỏ.",
      "tip": "Tương đậu cay (doubanjiang) là 'linh hồn' của món theo Tiffy — vị cay chỉ thoang thoảng làm nền, có thể gia giảm nếu không ăn cay được.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ nước dùng bò (hoặc nước lọc) và phần rượu Thiệu Hưng còn lại vào cho ngập thịt; thêm hoa hồi và lá nguyệt quế. Đun sôi rồi hạ lửa thật nhỏ, đậy nắp hầm khoảng 2 giờ, thỉnh thoảng đảo và châm thêm nước nóng nếu nước cạn.",
      "tip": "Tiffy hầm 2–3 giờ đến thịt mềm rục; WOL hầm 1 giờ cho thịt thái miếng nhỏ hơn. Với 900 g thịt miếng 5 cm, hầm 2 giờ rồi thử — thịt xiên đũa qua dễ dàng là đạt.",
      "timerMinutes": 120
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cà rốt vào nồi, đậy nắp hầm thêm khoảng 20 phút đến khi cà rốt mềm vừa, vẫn giữ được hình.",
      "tip": "Cho cà rốt muộn để cà rốt không bị nát bở trong 2 giờ hầm thịt (Tiffy).",
      "timerMinutes": 20
    },
    {
      "stepNumber": 8,
      "instruction": "(Tùy chọn) Nếu thích nước hầm sánh hơn: hòa 1 muỗng canh bột bắp với 2 muỗng canh nước lạnh, rót từ từ vào nồi đang sôi nhẹ, khuấy đều đến khi đạt độ sánh vừa ý."
    },
    {
      "stepNumber": 9,
      "instruction": "Nêm nếm lại với muối, xì dầu hoặc chút đường cho vừa miệng. Vớt bỏ hoa hồi, lá nguyệt quế và các lát gừng nếu muốn nước hầm trong đẹp."
    },
    {
      "stepNumber": 10,
      "instruction": "Múc thịt và cà rốt cùng nước hầm ra tô sâu, rắc hành lá thái nhỏ lên trên. Ăn nóng với cơm trắng.",
      "tip": "Món này để qua đêm trong tủ lạnh càng ngấm gia vị, hôm sau ăn ngon hơn (Tiffy); bảo quản tối đa 3 ngày trong hộp kín."
    }
  ],
