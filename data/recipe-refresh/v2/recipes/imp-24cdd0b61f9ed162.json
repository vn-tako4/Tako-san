  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cua: ngâm cua đồng với nước sạch có pha chút muối, rửa nhiều lần cho hết bùn đất. Tách mai cua, khều lấy phần gạch để riêng. Thân cua cho vào cối/máy xay cùng chút muối hạt, giã/xay thật nhuyễn.",
      "tip": "phunutoday: ấn nhẹ vào yếm cua thấy nổi bọt khí là cua còn tươi; cua cái nhiều gạch, cua đực nhiều thịt."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho cua đã xay vào âu lớn, thêm nước, bóp kỹ rồi lọc qua rây. Gạn lại 2-3 lần để lấy hết thịt cua và loại bỏ sạn vỏ.",
      "tip": "eva: gạn 2-3 lần để nước cua không bị sạn; phunutoday: không lọc quá mạnh tay kẻo vỏ nhỏ lọt xuống."
    },
    {
      "stepNumber": 3,
      "instruction": "Đậu phụ cắt miếng vừa ăn, chiên vàng đều các mặt, vớt ra để ráo dầu.",
      "tip": "eva: đậu chiên vàng các mặt rồi mới thả vào canh."
    },
    {
      "stepNumber": 4,
      "instruction": "Cà chua bổ múi cau. Hành khô bóc vỏ thái mỏng: phi một nửa đến vàng giòn, vớt ra để riêng rắc mặt khi dọn.",
      "tip": "eva: hành phi giòn để riêng rắc lên bát canh khi ăn."
    },
    {
      "stepNumber": 5,
      "instruction": "Phi thơm nửa hành khô còn lại với dầu ăn, cho cà chua vào xào sơ đến mềm và lên màu đẹp, sau đó cho phần gạch cua vào xào cùng.",
      "tip": "eva: xào gạch cua cùng cà chua; phunutoday: gạch phi với hành khô cho màu vàng óng thơm hơn."
    },
    {
      "stepNumber": 6,
      "instruction": "Đặt nồi nước cua lên bếp, nêm 2 thìa cà phê bột nêm và 1/2 thìa cà phê bột canh trước khi đun; khuấy nhẹ một chiều cho thịt cua không bị lắng xuống đáy.",
      "tip": "eva: nêm và khuấy đều trước khi đun giúp riêu đóng tảng chắc, đẹp mắt."
    },
    {
      "stepNumber": 7,
      "instruction": "Đun lửa vừa; khi thấy riêu cua bắt đầu nổi lên thì ngừng khuấy, hạ nhỏ lửa để riêu từ từ kết thành từng mảng. Khi nước sôi, nhẹ nhàng vớt hết riêu ra bát để riêng.",
      "tip": "phunutoday: đây là bí quyết quan trọng — sau khi riêu nổi phải hạn chế khuấy, lửa không quá lớn kẻo riêu vỡ vụn.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Cho cà chua đã xào và nước cốt me (me đun với ít nước đến mềm, dằm nhuyễn chắt lấy nước) vào nồi nước cua, đun sôi. Nêm nước mắm, muối/bột nêm cho vừa miệng, vị chua thanh.",
      "tip": "phunutoday: cho vị chua từng chút một, nêm đến vừa khẩu vị thay vì đổ nhiều ngay từ đầu."
    },
    {
      "stepNumber": 9,
      "instruction": "Thả đậu phụ đã chiên vào nồi, đun sôi nhẹ thêm 2-3 phút cho đậu ngấm nước canh.",
      "tip": "eva: thả đậu rán vào đun tiếp 2-3 phút.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
