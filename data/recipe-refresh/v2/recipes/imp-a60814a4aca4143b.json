  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Chuẩn bị bánh mì: cắt bỏ phần vỏ cứng của ổ bánh mì, lấy 100 g ruột cắt thành khối vuông, cho vào máy xay xay thành vụn mịn.",
      "tip": "GZ: dùng ruột bánh mì tươi (mollica di pane), không phải vụn bánh mì khô đóng gói — ruột tươi giúp viên mềm và kết dính tốt."
    },
    {
      "stepNumber": 2,
      "instruction": "Trộn thịt: cho thịt bò bằm, vụn bánh mì, parmigiano, pecorino, mùi tây băm, trứng, muối, tiêu đen và nhục đậu khấu vào tô lớn; nhào bằng tay đến khi các nguyên liệu quyện đều. (Nếu muốn viên mềm kiểu Toni Brancatisano, thêm 100 ml sữa tươi vào bước này.)",
      "tip": "GZ: nhào kỹ cho đều nhưng không bóp quá lâu để thịt không bị dai."
    },
    {
      "stepNumber": 3,
      "instruction": "Đậy kín tô thịt, để nghỉ trong tủ lạnh khoảng 1 giờ.",
      "tip": "GZ: thời gian nghỉ giúp vụn bánh mì hút ẩm đều, viên kết dính tốt và không bị vỡ khi nấu trong sốt.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 4,
      "instruction": "Làm sốt: cho 5 muỗng canh dầu ô liu vào nồi to, cho hành tây và tỏi băm vào xào lửa nhỏ khoảng 15 phút đến khi hành trong suốt, không để cháy.",
      "tip": "GZ: xào chậm ~15 phút — hành phải trong, không vàng nâu thì sốt mới ngọt.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ passata cà chua vào nồi, nêm muối, đun đến sôi nhẹ; giữ lửa liu riu."
    },
    {
      "stepNumber": 6,
      "instruction": "Viên thịt: lấy khoảng 10 g hỗn hợp thịt, vo tròn bằng hai lòng bàn tay; làm lần lượt đến khi hết hỗn hợp.",
      "tip": "GZ: mỗi viên ~10 g — viên nhỏ chín đều và thấm sốt ngon hơn viên to."
    },
    {
      "stepNumber": 7,
      "instruction": "Khi sốt đang sôi nhẹ, thả từng viên thịt vào nồi một cách nhẹ nhàng; lắc nhẹ nồi cho viên thịt xếp đều trong sốt, không dùng muỗng khuấy mạnh.",
      "tip": "GZ: 'muovendo delicatamente il tegame' — lắc nồi thay vì đảo để viên không bị vỡ."
    },
    {
      "stepNumber": 8,
      "instruction": "Đậy nắp, rim lửa nhỏ 20-30 phút đến khi sốt sánh lại và viên thịt chín thấu.",
      "tip": "GZ: nấu 20-30 phút lửa thấp là viên chín mềm, sốt sánh vừa.",
      "timerMinutes": 25
    },
    {
      "stepNumber": 9,
      "instruction": "Trước khi tắt bếp 5 phút, cho lá húng quế tươi vào nồi.",
      "tip": "GZ: cho húng quế vào cuối để giữ mùi thơm tươi, không bị đắng."
    },
    {
      "stepNumber": 10,
      "instruction": "Tắt bếp, dọn viên thịt còn nóng hổi, rưới nhiều sốt cà chua lên trên.",
      "tip": "GZ: ăn nóng mới ngon; bảo quản trong hộp kín, tủ lạnh tối đa 2 ngày. Sốt thừa có thể trộn với mì Ý thành món pasta."
    }
