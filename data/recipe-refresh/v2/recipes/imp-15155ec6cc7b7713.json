  "steps": [
    {
      "stepNumber": 1,
      "instruction": "So che thit: rua thit ba chi voi nuoc muoi loang (co the them chut nuoc cot chanh de khu mui hoi), rua lai nuoc sach, de rao.",
      "tip": "VOV khuyen chon mieng ba chi co mo va nac deu nhau, thit tuoi mem, an nhe khong ra nuoc."
    },
    {
      "stepNumber": 2,
      "instruction": "Thai thit thanh mieng vua an, day khoang 1-1.5 cm.",
      "tip": "toyenxin.com: thai day 1-1.5 cm de thit chin deu ma khong bi kho khi nuong."
    },
    {
      "stepNumber": 3,
      "instruction": "So che gia vi uop: sa boc bo lop vo ngoai gia, rua sach, dap dap roi bam nhuyen. Toi, hanh tim, gung, ot bam nhuyen.",
      "tip": "Bam cang nhuyen thi gia vi cang tham vao thit."
    },
    {
      "stepNumber": 4,
      "instruction": "Pha hon hop uop: trong to lon cho 2 muong canh nuoc mam, 2 muong canh mat ong, 1 muong canh dau an, 1 muong ca phe duong, 1 muong ca phe tieu xay, 1 muong ca phe muoi (va bot ngot neu dung), tron deu.",
      "tip": "VOV (bao dien tu dai tieng noi VN) xac nhan cong thuc uop mat ong: mat ong + toi bam + nuoc tuong/nuoc mam + hat nem; ban sa: sa + hanh kho + ot + gung + nuoc mam + duong + muoi — khop voi hon hop uop nay."
    },
    {
      "stepNumber": 5,
      "instruction": "Uop thit: cho thit vao to hon hop gia vi, dung tay (deo gang) xoa deu gia vi len tung mieng, boc kin, uop 30-60 phut; neu co thoi gian uop 1-2 gio trong ngan mat tu lanh cang ngon.",
      "tip": "toyenxin.com: uop 30-60 phut; xaydungso.vn: uop 1-2 gio. De qua dem trong tu lanh thi thit cang dam da.",
      "timerMinutes": 45
    },
    {
      "stepNumber": 6,
      "instruction": "Truoc khi nuong 10-15 phut, lay thit ra khoi tu lanh de thit bot lanh, giup chin deu khong bi kho.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 7,
      "instruction": "Lam nong lo nuong o 200 do C khoang 10 phut (hoac chuan bi bep than hoa / noi chien khong dau 180-200 do C).",
      "tip": "toyenxin.com nuong lo 200 do C; co the nuong than hoa hoac noi chien khong dau.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Nuong thit: xep thit len vi/khay, nuong moi mat 15-20 phut roi lat; tong 30-40 phut den khi thit chin vang deu, xem canh.",
      "tip": "Mat ong de chay khe — canh lua va lat deu tay de thit vang dep ma khong dang.",
      "timerMinutes": 35
    },
    {
      "stepNumber": 9,
      "instruction": "Kiem tra do chin: dung que xien vao giua mieng thit day nhat — neu khong con nuoc mau hong chay ra la thit da chin.",
      "tip": "Khong nuong qua ky: ba chi co mo se bi kho va cung neu de lua qua lau."
    },
    {
      "stepNumber": 10,
      "instruction": "Pha nuoc mam chua ngot (tuy chon): hoa tan 2 muong ca phe duong voi 3 muong canh nuoc loc va 1 muong canh giam; cho 1 muong canh nuoc mam vao khuay deu; cuoi cung cho toi ot bam vao. Don thit ra dia, an nong kem bun tuoi, rau song, banh trang cuon.",
      "tip": "samnec.com.vn: pha man/nhat truoc, tiep den chua, sau cung moi ngot; toi ot luon cho vao sau cung de noi len mat bat nuoc cham."
    }
  ],
