  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Luộc gà: cho nước vừa đủ ngập gà vào nồi nhỏ, thêm gừng thái lát và hành lá cắt khúc, đun sôi. Cho ức gà vào, đợi nước sôi lại thì đậy nắp, TẮT BẾP, để yên ủ 20–25 phút cho gà chín bằng hơi nóng.",
      "tip": "Cách ủ tắt bếp cho thịt gà mềm mọng, không bị khô (coquendum). Mala Market đun sôi 3 phút rồi tắt bếp ủ 15 phút — hai cách tương đương; kiểm tra gà chín kỹ, không còn hồng bên trong.",
      "timerMinutes": 25
    },
    {
      "stepNumber": 2,
      "instruction": "Vớt gà ra, để nguội hoàn toàn rồi dùng tay xé thành sợi mỏng vừa ăn, để riêng.",
      "tip": "Xé bằng tay cho sợi gà tơi, bám sốt ngon hơn thái bằng dao (Mala Market)."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha nước sốt: cho tương mè, xì dầu, giấm đen, dầu ớt, dầu mè, tỏi băm, đường, tiêu Tứ Xuyên xay và chút muối vào tô, khuấy đều đến khi sánh mịn. Để yên khoảng 30 phút cho các vị hòa quyện.",
      "tip": "Tương mè đặc khó tan — khuấy thật kỹ, có thể thêm 1–2 muỗng canh nước ấm cho dễ tan. Nêm lại cho vừa miệng: mặn, ngọt, chua, cay cân bằng (coquendum).",
      "timerMinutes": 30
    },
    {
      "stepNumber": 4,
      "instruction": "Đun sôi một nồi nước lớn, cho mì vào luộc theo đúng thời gian trên bao bì đến vừa chín tới.",
      "tip": "Nước phải thật sôi và nhiều để sợi mì không dính nhau."
    },
    {
      "stepNumber": 5,
      "instruction": "Vớt mì xả ngay dưới vòi nước lạnh, để ráo thật kỹ rồi trộn đều với 1 muỗng cà phê dầu ăn để sợi mì không dính nhau.",
      "tip": "Mala Market trải mì ra mặt phẳng cho ráo và nguội hẳn — mì khô ráo thì trộn sốt mới ngon, không bị nhão."
    },
    {
      "stepNumber": 6,
      "instruction": "Dưa leo rửa sạch, thái sợi mỏng vừa ăn, để riêng."
    },
    {
      "stepNumber": 7,
      "instruction": "Chia mì đã nguội ra 3 tô; xếp dưa leo thái sợi và gà xé sợi lên trên mặt mì."
    },
    {
      "stepNumber": 8,
      "instruction": "Rưới đều nước sốt lên mỗi tô; rắc lạc rang giã dập, vừng rang và hành lá thái nhỏ lên trên."
    },
    {
      "stepNumber": 9,
      "instruction": "Trộn đều tất cả khi ăn để sốt bám đều từng sợi mì.",
      "tip": "Món ngon nhất khi mì còn mát lạnh và sốt vừa trộn — không nên trộn sốt trước quá lâu, mì sẽ ỉu và hút hết sốt."
    }
