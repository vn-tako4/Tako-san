  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Chặt sườn thành từng miếng vừa ăn (dẻ sườn). Rửa sạch, thấm thật khô bằng khăn giấy.",
      "tip": "Thấm khô giúp sườn áp chảo xém vàng đẹp thay vì bị luộc trong nước thịt."
    },
    {
      "stepNumber": 2,
      "instruction": "Hành tây bóc vỏ, thái hạt lựu thô; cà rốt (nếu dùng) thái hạt lựu; tỏi bóc vỏ để nguyên tép; hương thảo băm nhỏ; lá nguyệt quế xé nhỏ bằng tay.",
      "tip": "Nguồn A: xé nguyệt quế bằng tay thay vì cắt để tinh dầu thơm hơn."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng dầu ô liu trong nồi hoặc chảo đáy dày ở lửa vừa. Cho tỏi, hương thảo và nguyệt quế vào phi thơm."
    },
    {
      "stepNumber": 4,
      "instruction": "Khi tỏi vừa chuyển vàng, gắp tỏi ra (theo nguồn A) rồi cho sườn vào áp chảo, trở đều các mặt cho xém vàng.",
      "tip": "Nguồn A gắp tỏi ra để tỏi không bị cháy đắng trong lúc áp chảo thịt lâu."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho hành tây (và cà rốt nếu dùng) vào đảo cùng sườn khoảng 10-15 phút, không đậy nắp, đến khi hành mềm và sườn vàng đều.",
      "tip": "Nguồn B nấu sườn cùng hành tây không đậy nắp khoảng 15 phút ở bước này.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 6,
      "instruction": "Rưới rượu vang trắng vào, đun lửa lớn cho cồn bay hơi hết (khoảng 3-5 phút), cạo nhẹ đáy nồi để tan phần xém vàng.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cà chua vào (bóp nát nếu dùng pelati nguyên quả). Nêm muối và tiêu, đảo đều.",
      "tip": "Nguồn A lưu ý: nếu trong nồi còn nhiều nước thịt tiết ra, chắt bớt trước khi cho cà chua để sốt sánh."
    },
    {
      "stepNumber": 8,
      "instruction": "Hạ lửa nhỏ, đậy nắp, om liu riu khoảng 30-40 phút đến khi thịt mềm, róc xương và sốt sánh lại. Thỉnh thoảng đảo để không bén đáy; nếu sốt quá đặc, thêm chút nước nóng.",
      "tip": "Sườn đạt là khi thịt dễ dàng róc khỏi xương (nguồn A).",
      "timerMinutes": 35
    },
    {
      "stepNumber": 9,
      "instruction": "Trước khi tắt bếp khoảng 2 phút, cho ô liu đen vào đảo đều.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 10,
      "instruction": "Nếm lại, chỉnh muối tiêu. Dọn sườn thật nóng cùng sốt, ăn kèm bánh mì, polenta hoặc khoai tây nghiền.",
