  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thịt bò thái lát mỏng ngang thớ (dày khoảng 2–3 mm). Ớt dài thái lát xéo; ớt hiểm thái lát; tỏi băm nhỏ; hành tây thái múi cau; hành lá cắt khúc 3–4 cm; mộc nhĩ (nếu dùng) ngâm nở, rửa sạch, thái miếng vừa.",
      "tip": "Nguồn A: để thịt vào ngăn đá 20–30 phút trước khi thái sẽ thái mỏng dễ hơn (mẹo áp dụng cho cả hai nguồn).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Hòa tan 1 muỗng canh bột ngô với 3 muỗng canh nước lọc trong chén nhỏ, khuấy đều đến khi không còn vón cục.",
      "tip": "Nguồn A: hỗn hợp này giúp sốt sánh lại và bám đều vào thịt, rau."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng chảo/wok với 2 muỗng canh dầu ăn trên lửa lớn. Cho thịt bò vào áp chảo nhanh, dàn đều một lớp, đến khi thịt vừa xém nâu hai mặt.",
      "tip": "Nguồn A: không xếp thịt chồng lên nhau; chia 2 mẻ nếu chảo nhỏ để thịt xém thay vì bị luộc.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Hạ lửa vừa, cho tỏi băm (và ớt hiểm nếu dùng) vào đảo nhanh đến khi tỏi vàng thơm.",
      "tip": "Nguồn B: phi tỏi với ớt hiểm khoảng 1 phút trước khi cho thịt; đảo nhanh tay kẻo tỏi cháy đắng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Rưới hỗn hợp bột ngô–nước vào, rồi cho dầu hào, xì dầu, xì dầu đặc, nước mắm, đường và tiêu trắng vào. Đảo đều, đun liu riu khoảng 1 phút cho thịt thấm gia vị.",
      "tip": "Nguồn A: để lửa nhỏ cho thịt ngấm sốt; nếm lại và chỉnh mặn/ngọt lúc này.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho ớt dài, hành tây (và mộc nhĩ nếu dùng) vào, xào lửa lớn thêm 1–2 phút đến khi rau củ vừa chín tới, còn giòn.",
      "tip": "Nguồn B: chỉ xào đến khi ớt hơi héo là dừng — xào lâu ớt mất màu và nhũn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Nếu sốt quá đặc, thêm nước dùng gà (hoặc nước lọc) từng ít một đến độ sánh vừa ý.",
      "tip": "Nguồn B dùng 1⁄4 cup nước dùng để tạo sốt; nguồn A điều chỉnh bằng nước hòa bột ngô."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho hành lá cắt khúc vào, đảo nhanh 15–20 giây rồi tắt bếp.",
      "tip": "Nguồn A: cho hành lá cuối cùng để giữ màu xanh và mùi thơm."
    },
    {
      "stepNumber": 9,
      "instruction": "Gắp ra đĩa, ăn ngay với cơm trắng nóng.",
      "tip": "Nguồn B gợi ý: ăn kèm cơm trắng và có thể thêm trứng ốp la như món ăn Thái truyền thống."
    }
  ],
