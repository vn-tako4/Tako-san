  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Ngâm nấm hương khô trong nước lạnh qua đêm (ít nhất vài giờ) cho nở mềm hoàn toàn.",
      "tip": "RHS: ngâm qua đêm là tốt nhất; KHÔNG thay nấm khô bằng nấm tươi vì mất vị umami đặc trưng của món."
    },
    {
      "stepNumber": 2,
      "instruction": "Vớt nấm ra, vắt nhẹ bớt nước, cắt bỏ phần chân cứng; nấm to bổ đôi, nấm nhỏ để nguyên.",
      "tip": "Chân nấm hương khô rất dai, không ăn được — bỏ đi."
    },
    {
      "stepNumber": 3,
      "instruction": "Chặt đùi gà thành miếng vừa ăn, cho vào tô trộn lớn.",
      "tip": "RHS thích dùng đùi gà rút xương không da vì nhanh chín và thơm béo vừa phải; cánh gà giữa cũng hợp."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho 8 lát gừng, xì dầu nhạt, xì dầu đặc, dầu hào, rượu Thiệu Hưng, dầu mè, tiêu trắng và bột ngô vào tô gà. Trộn thật đều, để ướp khoảng 10 phút.",
      "tip": "RHS ướp 10 phút; Chinarecipes ướp 30 phút — mâu thuẫn nhỏ, ướp lâu hơn thịt đậm vị hơn nhưng 10 phút đã đủ vì gia vị nhẹ.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nấm hương đã ngâm và ớt hiểm (nếu dùng) vào tô gà, trộn đều lần nữa."
    },
    {
      "stepNumber": 6,
      "instruction": "Chuyển toàn bộ gà và nấm ra đĩa sâu lòng, dàn đều một lớp.",
      "tip": "RHS: bắt buộc dùng đĩa sâu lòng vì gà ra nhiều nước khi hấp; nhưng không dùng tô sâu vì gà sẽ lâu chín, chín không đều."
    },
    {
      "stepNumber": 7,
