  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Nấu nước dashi: đun sôi 900 ml nước, cho bột dashi (hoặc 1–2 túi dashi) vào, đun lửa vừa 2–3 phút rồi vớt túi bã ra, vắt kiệt nước.",
      "tip": "JOC: dùng túi dashi cho nhanh; muốn nấu từ đầu thì ninh kombu + katsuobushi theo cách làm dashi cơ bản.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 2,
      "instruction": "Nêm nước dùng: cho xì dầu, mirin, đường và muối vào nồi dashi đang nóng, khuấy tan hoàn toàn. Nếm thử, chỉnh vị mặn-ngọt vừa miệng rồi đậy nắp giữ ấm, tắt bếp.",
      "tip": "JOC: muối giúp dậy vị mà không cần thêm xì dầu/đường; nước dùng phải hơi đậm một chút vì khi chan vào mì sẽ loãng ra."
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế: thịt bò nếu lát quá to thì cắt đôi thành miếng vừa ăn; hành tây thái lát mỏng; gừng thái sợi nhỏ; hành lá thái xéo mỏng.",
      "tip": "JOC: cắt lát thịt bò thành miếng rộng 3.8–5 cm để dễ gắp; hành lá thái xéo để rắc mặt đẹp mắt."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng dầu ăn trong chảo to lửa vừa, cho thịt bò vào xào, dàn đều một lớp, đến khi thịt chuyển màu hết đỏ.",
      "tip": "JOC: dùng chảo rộng để thịt áp chảo thay vì bị hấp hơi; thịt thái mỏng chín chỉ trong vài chục giây — vớt/xử lý ngay khi hết màu hồng để không bị dai.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Thêm gừng thái sợi và hành tây vào chảo, xào đến khi hành mềm, trong.",
      "tip": "japanesecooking101: cho gừng vào cùng lúc với hành để dậy mùi thơm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho đường, xì dầu, mirin, sake và nước lọc vào chảo thịt, đảo đều, nấu 2–3 phút cho thịt thấm gia vị và sốt hơi sánh lại; tắt bếp, để thịt nghỉ trong chảo.",
      "tip": "japanesecooking101: để thịt nguội dần trong chảo giúp thấm vị sâu hơn; không nấu quá lâu kẻo thịt dai.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Đun sôi một nồi nước to, cho mì udon đông lạnh vào luộc theo hướng dẫn trên bao bì (mì đông lạnh thường chỉ cần 1 phút), dùng đũa gỡ tơi cho mì không vón.",
      "tip": "JOC: mì đông lạnh chỉ cần trụng nóng lại, không luộc lâu sẽ mất độ dai; vớt ra để ráo kỹ để nước dùng không bị loãng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Chia mì đã ráo vào 3 tô lớn."
    },
    {
      "stepNumber": 9,
      "instruction": "Chan nước dùng đang nóng vào từng tô, ngập mặt mì.",
      "tip": "Nước dùng phải thật nóng khi chan để cả tô giữ nhiệt."
    },
    {
      "stepNumber": 10,
      "instruction": "Xếp thịt bò xào cùng phần sốt lên trên mỗi tô mì.",
      "tip": "Xếp thịt gọn lên mặt mì, rưới thêm chút sốt xào thịt cho đậm đà."
    },
    {
      "stepNumber": 11,
      "instruction": "Rắc hành lá thái xéo lên trên; ai ăn cay thì rắc thêm một nhúm bột ớt shichimi."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn ngay khi còn nóng hổi.",
      "tip": "JOC: có thể bảo quản riêng thịt, nước dùng và mì trong tủ lạnh tối đa 3 ngày; khi ăn hâm nóng nước dùng + thịt trước, trụng mì sau cùng để giữ độ dai."
    }
  ],
