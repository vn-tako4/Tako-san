  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thái thịt bò thành miếng mỏng vừa ăn. Ướp với 1 muỗng canh xì dầu Hàn, 1 muỗng cà phê tỏi băm, 1 nhúm tiêu và 1 muỗng cà phê dầu mè (thêm vừng rang nếu dùng). Để ngấm trong lúc sơ chế rau.",
      "tip": "KB: ướp thịt với xì dầu súp + tỏi + tiêu + dầu mè trước khi xào — đây là cách tạo nền nước dùng nhanh đặc trưng của canh Hàn."
    },
    {
      "stepNumber": 2,
      "instruction": "Cải thảo tách từng lá, rửa sạch, cắt khúc dài 4–5 cm. Hành lá cắt khúc 3–4 cm."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng nồi vừa trên lửa lớn, cho thịt bò đã ướp vào xào đến khi các mặt thịt chuyển nâu và săn lại.",
      "tip": "KB: xào đến khi tất cả các mặt thịt chuyển nâu — bước này tạo vị đậm cho nước dùng.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Đổ 6 cups nước vào nồi, đun sôi lửa lớn, vớt sạch bọt nổi trên mặt."
    },
    {
      "stepNumber": 5,
      "instruction": "Đậy nắp, hạ lửa vừa-cao, đun 10 phút cho nước dùng ngọt thịt.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cải thảo vào nồi, đun sôi lại rồi hạ lửa vừa, đậy nắp nấu 10–12 phút đến khi cải mềm trong.",
      "tip": "KB nấu củ cải 10–15 phút đến khi trong và mềm; cải thảo mềm nhanh hơn nên 10–12 phút là đủ (ghi chú của worker).",
      "timerMinutes": 12
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nốt 1 muỗng canh xì dầu Hàn còn lại, 1 muỗng cà phê tỏi băm còn lại và hành lá vào nồi."
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm muối và tiêu vừa ăn. Nếm lại: canh phải trong, vị thanh, KHÔNG quá sẫm màu.",
      "tip": "KB: 'The soup should not look too dark.' Không thay xì dầu Hàn bằng xì dầu thường — sẽ quá ngọt và sẫm màu; có thể thay bằng chút nước mắm nếu không có xì dầu Hàn."
    },
    {
      "stepNumber": 9,
      "instruction": "Đun thêm 5 phút cho các vị hòa quyện.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 10,
      "instruction": "Múc canh ra bát, ăn nóng với cơm trắng và kim chi.",
      "tip": "KM: chỉ cần cơm + canh + kim chi là đủ một bữa đơn giản, ấm bụng."
    }
  ],
