  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Ngâm bánh phở khô trong nước nguội cho đến khi mềm dẻo hoàn toàn (không còn sức kháng khi bẻ cong), vớt ra để ráo. Dùng kéo cắt đôi sợi mì cho dễ đảo.",
      "tip": "HTK: ngâm nước nguội 1 giờ (có thể ngâm trước vài ngày, giữ kín trong tủ lạnh); SheSimmers: ngâm ~30 phút là đủ. Tuyệt đối không luộc mì trước.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 2,
      "instruction": "Làm sốt pad thai: băm nhuyễn đường thốt nốt, cho vào nồi nhỏ đun lửa vừa cho tan chảy và chuyển màu nâu sậm (caramen). Ngay lập tức thêm nước để dừng caramen (sẽ sủi mạnh), rồi cho nước mắm và me vào, đun liu riu rồi tắt bếp. Để yên trong lúc sơ chế nguyên liệu cho đường tan hết, kiểm tra tan hoàn toàn trước khi xào.",
      "tip": "Có thể nấu sốt dư, bảo quản trong lọ kín để tủ lạnh dùng dần.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế nguyên liệu: tôm khô rửa qua nước rồi băm thô; tỏi và hành tím băm nhỏ; đậu phụ thái miếng nhỏ; củ cải muối băm nhuyễn; hẹ thái khúc 5cm; đậu phộng rang giã thô; chanh cắt múi cau.",
      "tip": "Chuẩn bị sẵn mọi thứ cạnh bếp vì khi xào mọi thao tác diễn ra rất nhanh."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun chảo sâu lòng hoặc wok trên lửa lớn, tráng một lớp dầu mỏng. Áp chảo tôm đến khi chín vàng một mặt rồi lật mặt còn lại; tôm chín thì vớt ra đĩa riêng.",
      "tip": "Không xào quá 2-3 phần một lần kẻo chảo bị chật, mì sẽ nhão.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Vẫn chảo đó, lửa vừa, thêm chút dầu nếu cần. Cho hành tím, tỏi, đậu phụ, tôm khô, củ cải muối và ớt khô vào xào vài phút đến khi tỏi bắt đầu chuyển vàng, hành mềm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Tăng lửa lớn, cho bánh phở đã ráo và sốt pad thai vào. Đảo liên tục đến khi toàn bộ sốt ngấm hết vào mì, không còn nước sốt đọng lại.",
      "tip": "Pad thai chuẩn không được sũng nước sốt — sốt phải ngấm hết vào mì."
    },
    {
      "stepNumber": 7,
      "instruction": "Tắt bếp, nếm thử một sợi mì. Nếu mì còn cứng, thêm một ít nước lọc và nấu tiếp đến khi nước ngấm hết (không thêm sốt, sẽ bị mặn).",
      "tip": "Thêm nước từng chút một, kẻo mì nhão."
    },
    {
      "stepNumber": 8,
      "instruction": "Bật lửa lớn trở lại, gạt mì sang một bên chảo, thêm chút dầu vào khoảng trống rồi đập trứng vào. Dùng xẻng đánh tan lòng đỏ, phủ mì lên trên trứng, để yên 20-30 giây.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Lật mì và đảo đều để trứng tơi ra, quyện vào mì."
    },
    {
      "stepNumber": 10,
      "instruction": "Cho tôm đã áp chảo trở lại chảo cùng nước tôm tiết ra, thêm một nửa đậu phộng, giá đỗ và hẹ. Tắt bếp, đảo nhanh tay cho giá đỗ vừa chín tới, quyện đều.",
      "tip": "Tắt bếp trước khi cho giá đỗ để giá giữ được độ giòn, tươi."
    },
    {
      "stepNumber": 11,
      "instruction": "Dọn ngay ra đĩa, đặt tôm lên trên, rắc thêm đậu phộng. Ăn kèm múi chanh, giá đỗ sống, hẹ tươi và ớt khô. Vắt chanh lên trước khi ăn.",
      "tip": "Pad thai ngon nhất khi ăn nóng ngay, để lâu mì sẽ dính cục."
    }
  ],
