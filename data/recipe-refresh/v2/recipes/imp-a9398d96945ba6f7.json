  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Ướp thịt ba chỉ đã thái miếng vừa ăn với rượu mirin và tiêu đen xay, để khoảng 15 phút cho ngấm (theo My Korean Kitchen).",
      "tip": "Nếu không có mirin, có thể bỏ qua bước ướp mà cho thịt trực tiếp vào nồi như cách của Maangchi.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Nấu nước dùng cá cơm (tùy chọn): cho cá cơm khô, củ cải Hàn thái lát mỏng, rong biển khô và gốc hành lá vào nồi với 4 cups nước. Đun sôi lửa vừa-lớn 20 phút, hạ nhỏ lửa thêm 5 phút rồi lọc bỏ bã, giữ lại nước dùng (theo Maangchi).",
      "tip": "Nước dùng cá cơm cho vị đậm đà nhất, nhưng nước dùng gà/bò hoặc nước lọc cũng dùng được.",
      "timerMinutes": 25
    },
    {
      "stepNumber": 3,
      "instruction": "Cắt kim chi thành miếng vừa ăn. Thái đậu phụ thành lát dày khoảng 1 cm. Hành tây thái lát mỏng. Hành lá xắt chéo.",
      "tip": "Dùng kim chi đã lên men chua kỹ (ít nhất 2-3 tuần) — kim chi tươi mới làm chưa đủ chua để nấu canh."
    },
    {
      "stepNumber": 4,
      "instruction": "Xào sơ kim chi trong chảo nóng cho đến khi mềm (theo My Korean Kitchen). Nếu nồi đủ to, có thể làm trực tiếp trong nồi nấu canh.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Trộn đều hỗn hợp gia vị nền trong một bát nhỏ: ớt bột gochugaru, tương ớt gochujang, đường, muối (hoặc nước tương) và tỏi băm nếu dùng."
    },
    {
      "stepNumber": 6,
      "instruction": "Xếp thịt ba chỉ đã ướp ở đáy nồi nông. Cho kim chi, hành tây, nấm hương (nếu dùng), đậu phụ và hỗn hợp gia vị vào nồi. Đổ nước dùng cá cơm vào, trừ hành lá để lại sau."
    },
    {
      "stepNumber": 7,
      "instruction": "Rưới dầu mè rang lên trên. Đậy nắp và nấu lửa vừa-lớn khoảng 10 phút.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Mở nắp, dùng muỗng khuấy nhẹ để gia vị hòa tan đều vào nước canh. Xếp lại các lát đậu phụ lên trên cho đẹp.",
      "tip": "Thỉnh thoảng múc nước canh chan lên các nguyên liệu để vị thấm đều."
    },
    {
      "stepNumber": 9,
      "instruction": "Đậy nắp lại, nấu thêm 10-15 phút ở lửa vừa cho đến khi thịt chín mềm và kim chi thấm vị.",
      "tip": "Thịt ba chỉ chín là canh đạt; kim chi chua càng nấu lâu càng mềm ngon.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc hành lá đã xắt chéo lên trên, đảo nhẹ rồi tắt bếp."
    },
    {
      "stepNumber": 11,
      "instruction": "Múc canh ra từng chén nhỏ, dùng muỗng lớn múc từ nồi chung. Ăn nóng ngay với cơm trắng.",
      "tip": "Kiểu ăn truyền thống là đặt nồi canh ở giữa bàn, mỗi người tự múc vào chén riêng."
    }
