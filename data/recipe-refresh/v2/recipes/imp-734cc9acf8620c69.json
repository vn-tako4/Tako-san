  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Đậu phụ non rửa nhẹ tay với nước (đậu non mềm, dễ nát), cắt khối vuông nhỏ khoảng 2 cm vừa ăn.",
      "tip": "toyenxin.com: vì đậu phụ non rất mềm nên sơ chế phải nhẹ tay."
    },
    {
      "stepNumber": 2,
      "instruction": "Cà chua rửa sạch, bổ múi cau. Trứng gà đập ra bát, dùng đũa khuấy cho lòng đỏ và lòng trắng tan đều. Hành tím lột vỏ, thái lát mỏng hoặc băm nhỏ. Hành lá, ngò rí nhặt bỏ lá hư, rửa sạch, cắt khúc khoảng 1 cm."
    },
    {
      "stepNumber": 3,
      "instruction": "Bắc nồi lên bếp, cho 1,5 muỗng canh dầu ăn vào, đun nóng rồi cho hành tím vào phi đến khi vàng thơm và dậy mùi.",
      "tip": "khoeplus: đợi hành thơm vàng mới cho cà chua, canh vừa có màu đẹp vừa không bị mùi hăng của cà chua sống."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho cà chua vào xào sơ khoảng 3 phút, có thể dằm nhẹ cho cà chua mềm và ra màu đẹp mắt."
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ 1 lít nước lọc vào nồi, đun lửa lớn cho sôi mạnh. Hớt bọt để nước canh trong hơn.",
      "tip": "toyenxin.com: hớt bọt khi nước sôi giúp nước canh trong, không bị đục."
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm 1⁄2 muỗng cà phê muối, 1⁄2 muỗng cà phê bột ngọt, 1 muỗng cà phê hạt nêm, 1⁄2 muỗng cà phê đường và 1 muỗng canh nước mắm; khuấy tan, nếm thử cho vừa miệng."
    },
    {
      "stepNumber": 7,
      "instruction": "Nhẹ nhàng cho đậu phụ đã cắt vào nồi, hạ lửa nhỏ, đun thêm khoảng 3–5 phút cho đậu ngấm gia vị."
    },
    {
      "stepNumber": 8,
      "instruction": "Khuấy chén trứng cho tan lại, rồi từ từ rót trứng vào nồi canh theo hình xoáy tròn hoặc vừa rót vừa dùng đũa khuấy nhẹ một chiều để trứng tạo thành những sợi vân đẹp mắt; đun thêm 1–2 phút cho trứng chín hoàn toàn."
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, cho hành lá và ngò rí vào, khuấy đều. Múc canh ra tô, rắc thêm ít tiêu xay (tùy ý) và thưởng thức khi còn nóng.",
      "tip": "khoeplus: rắc thêm ít tiêu sẽ thơm; ăn nóng với cơm rất ngon."
    }
  ],
