  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế sườn: rửa sạch sườn non, chặt thành miếng vừa ăn (khúc 3-4 cm).",
      "tip": "Chọn dẻ sườn có xương nhỏ, dẹt, nhiều thịt, màu hồng tươi — tránh sườn màu sậm, mùi hôi hoặc thịt nhão (Chợ Lái Thiêu)."
    },
    {
      "stepNumber": 2,
      "instruction": "Chần sườn để khử mùi: đun một nồi nước sôi có pha chút muối, cho sườn vào chần 2-3 phút, vớt ra rửa lại bằng nước sạch.",
      "tip": "Bước chần giúp nước canh trong, ngọt, không bị đục hay hôi (Chợ Lái Thiêu).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 3,
      "instruction": "Ninh sườn: cho sườn đã chần vào nồi cùng 1,3 lít nước và 1 củ hành khô đập dập. Đun sôi rồi hạ lửa nhỏ, hầm 30-40 phút cho đến khi sườn mềm và ra nước ngọt. Thường xuyên vớt bọt để nước dùng trong.",
      "timerMinutes": 35
    },
    {
      "stepNumber": 4,
      "instruction": "Trong lúc ninh sườn, sơ chế rau củ: gọt vỏ su su (nên gọt dưới vòi nước đang chảy để mủ nhựa trôi đi, không dính tay), thái miếng vừa ăn rồi ngâm ngay vào nước muối loãng 5-10 phút. Cà rốt gọt vỏ, thái miếng vừa ăn.",
      "tip": "Chà xát hai nửa su su đã bổ đôi vào nhau cho mủ trắng tiết ra rồi rửa sạch cũng giúp chống dính (Chợ Lái Thiêu). Ngâm nước muối loãng giữ su su giòn, không thâm đen."
    },
    {
      "stepNumber": 5,
      "instruction": "Khi sườn đã mềm, vớt củ hành khô ra bỏ đi. Vặn lửa lớn cho nước sôi bùng lên, cho cà rốt vào nấu trước 3-5 phút (nếu dùng).",
      "timerMinutes": 4
    },
    {
      "stepNumber": 6,
      "instruction": "Cho su su vào nồi, đun thêm 5-7 phút cho rau củ vừa chín mềm.",
      "tip": "Su su rất nhanh chín — không nấu quá lâu sẽ bị nhũn, mất độ giòn ngọt tự nhiên và giảm vitamin (Chợ Lái Thiêu).",
      "timerMinutes": 6
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nếm: nêm muối và hạt nêm cho vừa miệng (nêm chính sau khi cho rau củ vào), rồi nêm 1 muỗng canh nước mắm ở bước cuối cùng trước khi tắt bếp cho dậy mùi thơm.",
      "tip": "Bản thân su su và sườn đã có vị ngọt tự nhiên — nêm vừa phải, tránh lạm dụng bột ngọt/đường để giữ vị thanh mát nguyên bản (Chợ Lái Thiêu)."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho hành lá và ngò rí cắt nhỏ vào nồi, đảo nhẹ rồi tắt bếp."
    },
    {
      "stepNumber": 9,
      "instruction": "Múc canh ra tô, rắc một ít tiêu xay lên trên và dùng nóng với cơm.",
      "tip": "Không nên nấu quá nhiều để qua đêm — hâm đi hâm lại làm mất chất dinh dưỡng (Chợ Lái Thiêu)."
    }
  ],
