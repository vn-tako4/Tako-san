  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cà chua rửa sạch, cắt múi cau hoặc miếng nhỏ vừa ăn. Hành tím bóc vỏ, băm nhỏ. Hành lá, ngò rí rửa sạch, thái nhỏ.",
      "tip": "Muốn cà chua nhanh tan trong canh, có thể trụng qua nước sôi 15-30 giây rồi bóc vỏ trước khi cắt (nhathuoclongchau)."
    },
    {
      "stepNumber": 2,
      "instruction": "Đập 3 quả trứng ra bát, thêm một chút muối, đánh tan đều, để riêng.",
      "tip": "eva.vn: đánh trứng trước với chút muối giúp trứng đậm vị và khi cho vào canh sẽ nổi vân đẹp, không bị tanh. TUYỆT ĐỐI không đập trứng trực tiếp vào nồi nước đang sôi mạnh."
    },
    {
      "stepNumber": 3,
      "instruction": "Đặt nồi lên bếp, cho 1 muỗng canh dầu ăn vào đun nóng. Phi thơm hành tím băm (và tỏi thái lát nếu dùng) khoảng 30 giây.",
      "tip": "Phi vừa thơm tới, không để hành tỏi cháy vàng sẽ đắng."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho cà chua vào xào cùng 1 muỗng canh nước mắm, đảo khoảng 2 phút đến khi cà chua mềm, ra màu đỏ đẹp.",
      "tip": "Xào cà chua với nước mắm trước giúp canh thơm và có màu đỏ hấp dẫn (nhathuoclongchau, pharmacity).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Thêm 1,25 lít nước vào nồi, đun sôi. Nêm 1/2 muỗng cà phê muối và 1 muỗng cà phê hạt nêm (nếu dùng), nếm cho vừa miệng.",
      "tip": "Đun sôi bùng rồi hạ lửa vừa trước khi cho trứng vào để trứng không bị vỡ vụn.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Hạ lửa vừa-nhỏ, rót từ từ trứng đã đánh tan vào nồi theo dòng mỏng, chờ vài giây cho trứng hơi đông lại rồi mới khuấy nhẹ một chiều để tạo vân trứng đẹp.",
      "tip": "Bí quyết của eva.vn: rót chậm, đợi trứng se mặt rồi khuấy nhẹ một chiều — vân trứng nổi đẹp, không vón cục, không tanh."
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nếm lại lần cuối cho vừa ăn, đun thêm khoảng 1 phút cho trứng chín hoàn toàn.",
      "tip": "Không đun quá lâu sau khi cho trứng để vân trứng không bị nát.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Rắc hành lá và ngò rí thái nhỏ vào nồi, thêm chút tiêu xay nếu thích.",
      "tip": "Cho rau thơm vào lúc tắt bếp để giữ màu xanh và mùi thơm tươi."
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, múc canh ra tô lớn."
    },
    {
      "stepNumber": 10,
      "instruction": "Dùng nóng với cơm trắng.",
      "tip": "Canh trứng cà chua ngon nhất khi dùng nóng — giữ trọn hương vị và dưỡng chất (nhathuoclongchau)."
    }
  ],
