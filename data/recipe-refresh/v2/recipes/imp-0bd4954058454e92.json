  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế gà: xát muối và gừng đập dập lên đùi gà để khử mùi tanh, rửa sạch, để ráo, chặt miếng vừa ăn.",
      "tip": "Pao Quán: xát muối hoặc gừng là bước khử tanh bắt buộc.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế nấm: cắt bỏ gốc nấm đùi gà và nấm hương, ngâm nước muối loãng khoảng 3 phút, rửa sạch, để ráo. Chẻ đôi nấm đùi gà.",
      "tip": "Pao Quán: ngâm nước muối 3 phút khử mùi hôi; chẻ đôi nấm đùi gà cho dễ chín và đẹp.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Bắp cải, rau muống, hành lá rửa sạch, cắt khúc vừa ăn, xếp ra đĩa. Gừng cạo vỏ xắt lát; tỏi bằm nhuyễn; hành tím băm nhỏ; sả băm nhỏ; ớt thái lát; cà chua cắt múi cau.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc chảo lên bếp, phi thơm tỏi bằm, cho thịt gà vào xào đến khi thịt săn lại, nêm sơ 1 muỗng canh nước mắm.",
      "tip": "Pao Quán: xào gà săn trước khi hầm giúp thịt thơm và nước dùng trong hơn.",
      "timerMinutes": 7
    },
    {
      "stepNumber": 5,
      "instruction": "Trút gà đã xào vào nồi, đổ 2 lít nước, thêm gừng lát, sả băm, hành tím và vài cái nấm hương. Đun sôi rồi hạ lửa nhỏ hầm.",
      "tip": "Pao Quán: cho nấm đông cô/hương vào hầm cùng để nước dùng ngọt thơm."
    },
    {
      "stepNumber": 6,
      "instruction": "Hầm gà lửa nhỏ, vớt bọt thường xuyên để nước dùng trong. Nêm 1 muỗng canh nước mắm, 1 muỗng cà phê muối, 2 muỗng cà phê đường, 2 muỗng cà phê hạt nêm, 1 muỗng cà phê bột ngọt cho vừa ăn.",
      "tip": "MÂU THUẪN thời gian: ngoi sao nấu gà 15-20 phút; Pao Quán hầm 40 phút lửa nhỏ. Gà ta nên hầm 30-40 phút cho mềm; gà công nghiệp thì 15-20 phút đủ.",
      "timerMinutes": 35
    },
    {
      "stepNumber": 7,
      "instruction": "Khi gà đã mềm, cho cà chua cắt múi vào nồi, nếm lại cho vừa miệng.",
      "tip": "ngoi sao: cà chua tạo vị chua thanh cho nước lẩu.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Chuyển gà và nước dùng sang nồi lẩu, đặt lên bếp. Khi nước sôi, cho nấm đùi gà và nấm hương vào, đun 5-10 phút cho nấm chín.",
      "tip": "ngoi sao: cho nấm vào khi gà đã chín mềm, đun thêm 5-10 phút.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 9,
      "instruction": "Nhúng bắp cải, rau muống, hành lá vào nồi lẩu đến khi chín tới thì gắp ra ăn ngay.",
      "tip": "Rau nhúng chín tới giữ được độ giòn ngọt; có thể thay rau muống bằng cải cúc/xà lách xoong theo Pao Quán.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Ăn nóng kèm bún tươi hoặc mì, chấm nước mắm trong pha vài lát ớt.",
      "tip": "Pao Quán: chấm nước mắm trong thêm ớt rất ngon. Lẩu ngon nhất khi ăn nóng."
    }
