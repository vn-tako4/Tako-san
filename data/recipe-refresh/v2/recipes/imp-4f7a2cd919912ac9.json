  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế: hành lá thái nhỏ, chia làm hai phần — một phần làm mỡ hành, một phần để rắc lên mặt; hành tím bóc vỏ, băm nhỏ."
    },
    {
      "stepNumber": 2,
      "instruction": "Làm mỡ hành: đun nóng 1 muỗng canh dầu ăn đến bốc khói nhẹ, rưới đều vào chén hành lá thái nhỏ, trộn nhanh tay.",
      "tip": "Dầu phải thật nóng thì hành mới thơm và giữ màu xanh; không để dầu cháy khét."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha nước trộn trong tô lớn: khuấy tan xì dầu, nước mắm, đường (thêm giấm gạo và dầu vừng nếu dùng) đến khi đường tan hết.",
      "tip": "afamily: có thể đun sôi nhẹ nước trộn để đường tan nhanh và sốt sánh hơn."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun sôi một nồi nước; cho 2 gói mì vào chần 30 giây đến 3 phút tùy loại mì, vớt ra xả ngay qua nước lạnh rồi để thật ráo.",
      "tip": "saigonesebaguette: trụng đúng kỹ thuật (xả nước lạnh ngay) giúp sợi mì dai, không bở nát khi trộn.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Chiên trứng ốp la: đun nóng 1 muỗng canh dầu ăn còn lại trên chảo, đập 2 quả trứng vào, chiên lửa vừa đến độ chín mong muốn — lòng đào hoặc chín kỹ tùy khẩu vị.",
      "tip": "Có thể phi thơm hành tím băm trước khi cho trứng vào để trứng thơm hơn (theo saigonesebaguette).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Cho mì đã ráo nước vào tô nước trộn, dùng đũa trộn đều cho từng sợi mì thấm gia vị.",
      "tip": "Trộn lúc mì còn nóng thì gia vị thấm nhanh và đều hơn."
    },
    {
      "stepNumber": 7,
      "instruction": "Thêm mỡ hành vào tô mì, trộn đều lần nữa."
    },
    {
      "stepNumber": 8,
      "instruction": "Chia mì ra 2 tô/phần; đặt 1 quả trứng ốp la lên trên mỗi phần."
    },
    {
      "stepNumber": 9,
      "instruction": "Rắc hành lá thái nhỏ còn lại, vừng rang và một chút tiêu xay lên mặt."
    },
    {
      "stepNumber": 10,
      "instruction": "Trộn đều khi ăn; dùng ngay khi còn nóng để mì không bị khô và trứng không bị tanh.",
      "tip": "afamily: món ngon nhất khi ăn ngay sau khi chế biến."
    }
  ],
