  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Tách bông cải thành những hoa nhỏ đều nhau, rửa sạch, để ráo nước.",
      "tip": "Hoa đều nhau giúp chín đều, không bị chỗ sống chỗ nhừ."
    },
    {
      "stepNumber": 2,
      "instruction": "Tỏi băm nhỏ, gừng băm nhuyễn, để riêng."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sốt: cho 2 muỗng canh nước, xì dầu nhạt, xì dầu đặc, đường và bột bắp vào chén, khuấy tan hoàn toàn.",
      "tip": "Trước khi đổ vào chảo nhớ khuấy lại vì bột bắp dễ lắng xuống đáy."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun sôi một nồi nước lớn với một nhúm muối. Cho bông cải vào chần đúng 1 phút rồi vớt ra, để ráo.",
      "tip": "China Sichuan: chần trước giúp bông cải giữ màu xanh giòn và rút ngắn thời gian xào.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng chảo (wok) với dầu đậu phộng ở lửa vừa-cao."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho gừng và tỏi vào phi khoảng 30 giây đến khi thơm.",
      "tip": "Không để tỏi chuyển nâu sậm — tỏi cháy sẽ làm món ăn bị đắng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Cho bông cải đã chần vào, đảo nhanh tay khoảng 1 phút.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Rót đều hỗn hợp sốt vào chảo, đảo liên tục khoảng 1 phút đến khi sốt sánh lại, bao đều từng hoa bông cải.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Rưới dầu mè lên, đảo lại một lượt rồi tắt bếp."
    },
    {
      "stepNumber": 10,
      "instruction": "Bày ra đĩa, dùng nóng ngay với cơm.",
      "tip": "Món xào kiểu Quảng Đông ngon nhất khi ăn ngay — để lâu bông cải sẽ mất độ giòn."
    }
  ],
