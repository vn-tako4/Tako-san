  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: cắt bỏ đầu, lột vỏ, rút đường chỉ lưng, rửa sạch rồi để ráo. Ướp tôm với 1/2 muỗng cà phê hạt nêm trong 5-10 phút cho thấm (theo Knorr).",
      "tip": "Tôm tươi chọn con vỏ trong, thân cong, đầu dính chặt thân (mẹo chọn tôm của DMX).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Bông cải tách thành nhánh nhỏ vừa ăn, rửa sạch dưới vòi nước. Cà rốt (nếu dùng) gọt vỏ, thái lát mỏng."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun sôi khoảng 2 lít nước với 1 muỗng canh muối. Cho bông cải (và cà rốt) vào chần 2-3 phút rồi vớt ra ngâm ngay vào tô nước đá khoảng 5 phút, sau đó vớt ra để ráo.",
      "tip": "Knorr và DMX đều chần 3 phút; ngâm nước đá giúp bông cải xanh mướt và giữ độ giòn (mẹo của DMX). Không chần quá lâu kẻo rau bị nhũn.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Tỏi băm nhỏ. Hành tây thái múi cau mỏng."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng chảo với 2 muỗng canh dầu ăn trên lửa lớn. Cho tôm đã ướp vào xào nhanh khoảng 1 phút cho tôm săn lại và hơi xém cạnh, rồi vớt ra để riêng.",
      "tip": "Knorr xào tôm riêng 1 phút lửa lớn rồi vớt ra để tôm không bị dai; DMX xào tôm 1 phút lửa lớn rồi nêm gia vị xào tiếp — hai nguồn hơi khác nhau, lấy theo Knorr vì tôm còn được xào lại ở bước sau.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Dùng lại chảo (thêm chút dầu nếu cần), phi thơm tỏi băm và hành tây trên lửa vừa đến khi dậy mùi.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Cho bông cải (và cà rốt) đã chần vào chảo, đảo trên lửa lớn. Nêm 1.5 muỗng cà phê hạt nêm còn lại, 1 muỗng cà phê muối và 1/2 muỗng cà phê bột ngọt (nếu dùng); xào 2-3 phút cho rau thấm gia vị (theo Knorr).",
      "tip": "Xào lửa lớn và nhanh tay để bông cải giữ được độ giòn, không ra nước.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Cho tôm đã xào trở lại chảo. Hòa tan 1/2 muỗng cà phê bột bắp với 2 muỗng canh nước, rưới đều vào chảo, đảo thêm khoảng 1 phút cho sốt hơi sánh lại.",
      "tip": "Hòa bột bắp với nước lạnh trước khi cho vào chảo nóng để không bị vón cục (theo Knorr).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Nêm nếm lại cho vừa miệng (thêm 1 muỗng cà phê nước mắm nếu muốn dậy mùi). Rưới 1/2 muỗng cà phê dầu mè vào, đảo đều rồi tắt bếp.",
      "tip": "Dầu mè cho vào cuối cùng, không đun lâu để giữ mùi thơm (theo Knorr)."
    },
    {
      "stepNumber": 10,
      "instruction": "Trình bày món ăn ra đĩa, rắc tiêu xay và mè trắng rang lên trên. Dùng nóng với cơm trắng.",
      "tip": "Món xào ngon nhất khi ăn ngay — để lâu bông cải sẽ mềm và mất độ giòn (DMX)."
    }
  ],
