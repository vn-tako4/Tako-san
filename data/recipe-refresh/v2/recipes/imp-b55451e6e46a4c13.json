  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thịt heo xay cho vào tô, ướp với tỏi băm, 2 cây hành lá băm nhỏ, 1 muỗng canh nước mắm, 1 muỗng cà phê hạt nêm và 1/2 muỗng cà phê tiêu xay. Trộn đều, để ướp 10-15 phút cho thấm.",
      "tip": "thitsachnhapkhau.net: ướp 10 phút. Ướp thịt đậm một chút vì bắp cải nhạt, khi hấp sẽ cân bằng (cookpad Nguyệt Anh).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Mộc nhĩ ngâm nước nóng cho nở mềm, cắt bỏ chân, rửa sạch rồi băm nhỏ.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Cà rốt gọt vỏ, băm nhỏ, trộn đều vào tô thịt đã ướp cùng mộc nhĩ."
    },
    {
      "stepNumber": 4,
      "instruction": "Bắp cải tách riêng từng lá to, cẩn thận không để rách. Rửa sạch, để ráo. Dùng dao cắt mỏng hoặc bỏ phần cuống cứng ở đầu lá.",
      "tip": "Chọn cây bắp cải cuộn lỏng, cầm nhẹ tay để tách lá dễ (bepmina.vn)."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nồi nước sôi, thả vào vài hạt muối. Chần nhanh lá bắp cải khoảng 1 phút cho mềm rồi vớt ngay ra chậu nước lạnh.",
      "tip": "Chần 1 phút rồi ngâm nước lạnh giúp lá mềm dễ cuộn mà vẫn giữ màu xanh (bepmina.vn).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Chần thêm vài cọng hành lá dài khoảng 30 giây trong nước sôi rồi vớt ra nước lạnh — dùng làm dây buộc.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Trải 1 lá bắp cải ra thớt, xúc một muỗng nhân thịt đặt vào giữa. Gập 2 mép lá rồi cuộn lại như cuốn nem, dùng cọng hành lá đã chần buộc cố định.",
      "tip": "Không cuộn quá chặt vì thịt còn nở ra trong quá trình hấp (bepmina.vn). Cuốn nhỏ vừa để thịt nhanh chín."
    },
    {
      "stepNumber": 8,
      "instruction": "Xếp các cuộn bắp cải vào xửng hấp (hoặc đĩa sâu lòng đặt trong nồi hấp)."
    },
    {
      "stepNumber": 9,
      "instruction": "Hấp cách thủy tính từ khi nước sôi khoảng 20 phút cho thịt chín hẳn.",
      "tip": "Hai nguồn mâu thuẫn về thời gian: bepmina.vn hấp 20-25 phút; thitsachnhapkhau.net hấp 15 phút. Lấy 20 phút cho cuộn cỡ vừa; kiểm tra bằng cách dùng tăm xiên qua phần thịt — không còn nước hồng chảy ra là chín (thitsachnhapkhau.net).",
      "timerMinutes": 20
    },
    {
      "stepNumber": 10,
      "instruction": "Xếp bắp cải cuộn thịt ra đĩa, rắc thêm chút tiêu xay lên trên."
    },
    {
      "stepNumber": 11,
      "instruction": "Dọn nóng, chấm cùng nước tương, tương ớt hoặc nước mắm nguyên chất.",
      "tip": "bepmina.vn: chấm nước tương hoặc tương ớt; cookpad Nguyệt Anh: chấm nước mắm nguyên chất."
    }
  ],
