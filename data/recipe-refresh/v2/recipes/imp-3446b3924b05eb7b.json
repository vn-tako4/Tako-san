  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thịt bò rửa sạch, để ráo, thái lát mỏng. Ướp thịt với tỏi băm, một chút tiêu, muối và nước mắm trong 15–20 phút cho ngấm gia vị.",
      "tip": "tomate: có thể thêm một chút dầu ăn khi ướp để thịt mềm, không bị khô khi xào.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Bắp cải tách lá, rửa nhiều lần cho sạch bụi bẩn rồi cắt miếng vừa ăn. Cà rốt gọt vỏ, rửa sạch, thái khoanh hoặc lát vừa ăn. Hành lá rửa sạch, cắt nhỏ.",
      "tip": "afamily thái cà rốt hạt lựu cho thịt viên; món này thái khoanh/lát để hợp với thịt bò thái lát."
    },
    {
      "stepNumber": 3,
      "instruction": "Bắc nồi lên bếp, cho 1 muỗng canh dầu ăn vào đun nóng, phi thơm phần tỏi băm còn lại.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 4,
      "instruction": "Cho thịt bò đã ướp vào xào nhanh trên lửa lớn đến khi thịt vừa chín tới thì trút ra tô riêng.",
      "tip": "tomate: xào nhanh lửa lớn để giữ độ mềm và vị ngọt của thịt; không xào kỹ vì thịt còn nấu tiếp trong canh.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Dùng chính nồi vừa xào thịt, đổ 1.5 lít nước lọc vào, đun sôi.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Khi nước sôi, cho cà rốt vào trước, hạ lửa vừa nấu khoảng 5 phút cho cà rốt bắt đầu mềm.",
      "tip": "Cà rốt lâu chín hơn bắp cải nên cho vào trước.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Thả bắp cải vào nồi, nấu đến khi bắp cải vừa mềm nhưng vẫn giữ được độ giòn, khoảng 5–7 phút.",
      "tip": "tomate: không nấu bắp cải quá lâu sẽ bị nhừ, mất vị giòn ngọt.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 8,
      "instruction": "Cho thịt bò đã xào trở lại nồi, nêm hạt nêm, muối, đường và một ít nước mắm cho vừa ăn, đun sôi lại khoảng 2 phút.",
      "tip": "Nêm nhẹ tay để giữ vị thanh của bắp cải và ngọt tự nhiên của thịt bò (tomate).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, cho hành lá cắt nhỏ vào, múc canh ra tô, rắc thêm tiêu xay nếu thích. Dùng nóng với cơm trắng."
    }
  ],
