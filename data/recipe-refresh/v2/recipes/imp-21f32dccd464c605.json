  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế gà: xát muối hạt và gừng đập dập khắp mình gà (cả trong bụng), để khoảng 5 phút rồi rửa sạch lại với nước, để ráo.",
      "tip": "afamily: bước xát gừng + muối giúp khử mùi hôi của gà."
    },
    {
      "stepNumber": 2,
      "instruction": "Nướng hành tây (bổ đôi), gừng và hành tím trên bếp đến khi xém cạnh, dậy mùi thơm; cạo bỏ phần cháy đen. Rang hạt mùi khô (và quế, hoa hồi nếu dùng) trên chảo khô lửa vừa đến thơm.",
      "tip": "Helen: cho gia vị phở vào túi lọc trà, chỉ thả vào nồi khoảng 30 phút trước khi dùng chứ không ninh từ đầu để tránh nước dùng bị nồng."
    },
    {
      "stepNumber": 3,
      "instruction": "Cho gà, xương gà (nếu dùng) và 3 lít nước lạnh vào nồi to, thêm 1 thìa canh muối. Đun lửa vừa để nước sôi lên từ từ; khi sôi lăn tăn thì hớt bọt kỹ, mở hé vung, hạ nhỏ lửa.",
      "tip": "afamily: muốn nước trong thì đừng bật lửa to nhất; để sôi bùng bục nước dùng sẽ bị đục."
    },
    {
      "stepNumber": 4,
      "instruction": "Luộc gà đến chín: khoảng 30-45 phút tùy loại gà. Thử bằng cách xiên đũa vào đùi — không thấy nước màu hồng chảy ra là chín.",
      "tip": "Helen: gà ta thả vườn có thể mất đến 60 phút.",
      "timerMinutes": 40
    },
    {
      "stepNumber": 5,
      "instruction": "Vớt gà ra, xả ngay qua nước lạnh cho da khỏi thâm, để nguội. Cho túi gia vị đã nướng/rang vào nồi, tiếp tục ninh lửa nhỏ tổng cộng khoảng 2-3 giờ tính từ đầu để nước dùng ngọt.",
      "tip": "afamily: trung bình 3 tiếng từ lúc cho gà vào là có nồi nước dùng ngon ngọt; ninh càng lâu càng ngọt.",
      "timerMinutes": 120
    },
    {
      "stepNumber": 6,
      "instruction": "Vớt bỏ hết xương và túi gia vị. Lọc nước dùng qua rây cho trong."
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm lại nước dùng với muối, đường phèn, bột nêm và nước mắm cho vừa miệng, đun sôi trở lại.",
      "tip": "afamily: nêm nếm lần cuối sau khi vớt hết xương và gia vị."
    },
    {
      "stepNumber": 8,
      "instruction": "Lọc lấy thịt gà, thái miếng hoặc xé sợi vừa ăn. Có thể bóp nhẹ thịt gà với chút muối tiêu cho thơm.",
      "tip": "Helen: bóp thịt gà với tí muối tiêu và lá chanh thái chỉ."
    },
    {
      "stepNumber": 9,
      "instruction": "Chần bánh phở qua nước sôi cho mềm tơi, sau đó xả nước lạnh rồi tráng lại nước nóng.",
      "tip": "Helen: cách này giúp sợi phở không bị khô vón mà tơi hơn."
    },
    {
      "stepNumber": 10,
      "instruction": "Chuẩn bị rau ăn kèm: hành lá (phần xanh thái nhỏ, phần trắng chẻ dọc, đầu hành chần qua), hành tây thái mỏng ngâm nước lạnh, lá chanh thái chỉ, giá đỗ trụng sơ, rau mùi thái nhỏ.",
      "tip": "afamily: đầu hành đem chần qua, phần lá thái nhỏ."
    },
    {
      "stepNumber": 11,
      "instruction": "Trình bày: cho bánh phở vào khoảng 1/3 bát, xếp thịt gà lên trên, thêm hành lá, rau mùi, lá chanh thái chỉ và vài lát hành tây, rồi chan nước dùng thật sôi ngập bát."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn nóng kèm giá đỗ, chanh miếng, ớt tươi và nước mắm (hoặc tỏi ớt) để nêm thêm; có thể ăn kèm quẩy như gợi ý của afamily.",
      "tip": "Ăn ngay khi còn nóng."
    }
  ],
