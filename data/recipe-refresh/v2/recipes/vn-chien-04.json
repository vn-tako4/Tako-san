  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau thơm: thì là rửa sạch, để ráo, cắt nhuyễn; đầu hành hoa rửa sạch cắt nhỏ; hành khô bóc vỏ, băm nhuyễn.",
      "tip": "Thì là và đầu hành phải để thật ráo nước rồi mới cắt, tránh nhân chả bị ướt."
    },
    {
      "stepNumber": 2,
      "instruction": "Mỡ heo luộc chín tới, vớt ra để ráo, cắt hạt lựu nhỏ. Ướp mỡ với 1/2 muỗng cà phê đường, trộn đều, để 10 phút cho mỡ trong.",
      "tip": "Báo Khánh Hòa: ướp mỡ heo với đường giúp mỡ trong, khi chiên chả có độ mọng mà không bị khô.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Cho phi lê cá thác lác đã lạnh vào tô lớn. Ướp với nước mắm, muối, hạt nêm, bột ngọt và 1/2 muỗng canh hạt tiêu. Trộn sơ rồi để vào ngăn mát tủ lạnh 15 phút cho cá thấm gia vị và giữ lạnh.",
      "tip": "MN MN: giữ cá thật lạnh trước khi quết giúp chả dai, không bị bở.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 4,
      "instruction": "Lấy cá đã ướp ra, dùng muôi gỗ hoặc tay (đeo găng) quết mạnh, đều tay 10-15 phút đến khi thịt cá dẻo quánh, có độ kết dính.",
      "tip": "Điện máy Xanh: nhồi chả khoảng 10 phút đến khi hỗn hợp dai, dẻo là đạt.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thịt nạc dăm xay vào tô cá, tiếp tục quết thêm 3-5 phút cho hai loại thịt quyện đều.",
      "tip": "Chỉ MN MN dùng thịt nạc dăm; bước này giúp miếng chả mọng và mềm hơn.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 6,
      "instruction": "Thêm mỡ heo hạt lựu đã ướp đường, lòng trắng trứng, bột năng, thì là cắt nhuyễn, đầu hành hoa và hành khô băm vào tô. Trộn đều và quết thêm 3-5 phút, rắc nốt 1/2 muỗng canh hạt tiêu còn lại, trộn đều.",
      "tip": "Cholaithieu/Báo Khánh Hòa: trộn thì là ở bước cuối để giữ mùi thơm; quết quá lâu làm nhân nóng lên, mất độ dai.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 7,
      "instruction": "Thoa một lớp dầu ăn mỏng lên lòng bàn tay. Múc từng phần hỗn hợp, nặn thành miếng dẹt vừa ăn (hoặc vo viên tròn rồi ấn dẹt), xếp ra đĩa.",
      "tip": "MN MN và Điện máy Xanh: thoa dầu lên tay/muỗng để chả không dính khi nặn."
    },
    {
      "stepNumber": 8,
      "instruction": "Bắc chảo lên bếp, đổ dầu ăn đủ ngập đáy chảo dày, đun lửa vừa đến khi dầu nóng già (nhúng đầu đũa vào thấy sủi tăm)."
    },
    {
      "stepNumber": 9,
      "instruction": "Thả từng miếng chả vào chiên, không xếp quá chật. Chiên 5-7 phút, trở đều tay đến khi hai mặt vàng ươm thì vớt ra.",
      "tip": "Điện máy Xanh: chiên lửa vừa khoảng 5 phút vàng đều 2 mặt; lửa to cháy ngoài sống trong, lửa nhỏ chả ngấm dầu.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 10,
      "instruction": "Vớt chả ra đĩa có lót giấy thấm dầu. Dọn nóng, ăn kèm cơm trắng, chấm tương ớt hoặc nước mắm pha chua ngọt.",
      "tip": "MN MN gợi ý chấm xốt mayonnaise chua ngọt; Báo Khánh Hòa gợi ý nước mắm ngọt hoặc tương ớt."
    }
  ],
