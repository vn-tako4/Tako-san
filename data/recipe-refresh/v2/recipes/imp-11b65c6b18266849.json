  "steps": [
    {
      "stepNumber": 1,
      "instruction": "So che dau phu: rua nhe dau qua nuoc sach, dung khan/giay tham that kho. Cat moi bia dau thanh mieng vuong vua an, day chung 1 dot ngon tay.",
      "tip": "Esheep Kitchen: tham dau that kho truoc khi ran giup dau khong ban dau, mieng dau cung chac khong buc vo. Chon bia dau mau trang kem, be mat mem muot, con thom mui dau nanh; dau cung, mui hoi chua la dau cu, an bo."
    },
    {
      "stepNumber": 2,
      "instruction": "So che dua: 1/2 qua dua got vo, bo mat, cat mieng vua an.",
      "tip": "Esheep Kitchen goi y: thich vi chua thanh thi chon dua uong (hoi xanh), thich ngot nhe thi chon dua chin vang."
    },
    {
      "stepNumber": 3,
      "instruction": "So che hanh toi ot: toi bam nho 1 muong canh; hanh tim bam nho; hanh la rua sach, dau hanh trang che doi, la xanh cat khuc; ot thai lat (neu dung)."
    },
    {
      "stepNumber": 4,
      "instruction": "Pha xot kho: trong bat cho 3 muong canh xi dau, 1 muong canh dau hao chay (neu dung), 1/2 muong canh duong va 1/2 chen nuoc loc, khuay cho duong tan. (Neu dung bot nang: hoa rieng 1 muong canh bot nang voi 2 muong canh nuoc.)",
      "tip": "Lay dung ti le xot cua tripi.vn cho 3-4 nguoi an; khong tu them giam/chanh — hai nguon deu khong dung chat chua ngoai dua."
    },
    {
      "stepNumber": 5,
      "instruction": "Ran dau: dun nong dau an, doi dau soi gia moi cho dau vao ran vang deu cac mat roi vot ra de rao dau.",
      "tip": "Esheep Kitchen: dau soi gia moi tha dau vao thi mieng dau vang gion, khong bi nat.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 6,
      "instruction": "Phi thom: chua lai 1-2 muong canh dau trong chao, cho toi bam va hanh tim bam vao phi thom.",
      "tip": "tripi.vn phi thom hanh toi truoc khi cho dua vao — buoc tao mui thom dac trung cua mon kho."
    },
    {
      "stepNumber": 7,
      "instruction": "Xao dua: cho dua vao chao, dao deu 5-7 phut cho dua mem, ra nuoc ngot.",
      "tip": "Esheep Kitchen nau dua voi xot 5-7 phut truoc khi cho dau vao de dua tham vi.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 8,
      "instruction": "Kho: cho dau da ran vao chao, do bat xot vao, dao nhe cho xot phu deu. Dun liu riu 10-15 phut cho dau tham xot.",
      "tip": "Esheep Kitchen rim 10-15 phut o lua nho; tro dau nhe tay de mieng dau khong vo.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 9,
      "instruction": "Neu dung bot nang: do tu tu nuoc bot nang vao, dao nhe den khi xot sanh lai thi tat bep.",
      "tip": "Chi lam buoc nay neu muon xot sanh kieu Esheep Kitchen; ban tripi.vn khong can bot nang."
    },
    {
      "stepNumber": 10,
      "instruction": "Cho hanh la va ot lat vao, dao deu roi tat bep. Muc ra dia, an nong voi com trang.",
      "tip": "tripi.vn goi y them hanh la va chut ot bam khi hoan thien de mon an day mau sac va thom hon."
    }
