  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Ngâm cua đồng trong nước 1-2 giờ cho nhả hết đất cát, xả lại nước sạch. Lột yếm cua, tách mai; dùng thìa nhỏ nạo phần gạch cua cho vào bát, ướp với một ít tiêu xay và hạt nêm.",
      "tip": "vietnamlike khuyên chọn cua cái sẽ béo và nhiều gạch hơn."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho phần thân cua vào cối xay hoặc giã nhuyễn cùng vài hạt muối."
    },
    {
      "stepNumber": 3,
      "instruction": "Trút cua xay vào tô lớn, hòa nước vào rồi dùng tay bóp nhẹ cho thịt cua tan vào nước. Gạn nhẹ nhàng phần nước lẫn thịt cua vào nồi. Lặp lại thao tác hòa nước - bóp nhẹ - gạn khoảng 2 lần, đến khi trong tô chỉ còn vỏ cua cứng ráp là được.",
      "tip": "Thanh Niên lưu ý: không cho quá nhiều nước, cua sẽ khó đóng cục."
    },
    {
      "stepNumber": 4,
      "instruction": "Hòa vào nồi nước cua vừa lọc một ít muối, hạt nêm và đường. Đặt nồi lên bếp đun lửa vừa, khuấy nhẹ tay để riêu cua kết lại và nổi lên mặt nước thì vớt ra để riêng ra bát.",
      "tip": "Để lửa to quá gạch cua dễ bị cháy hoặc trào ra ngoài.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 5,
      "instruction": "Đậu phụ cắt thành miếng vuông vừa ăn, cho vào chảo dầu nóng chiên vàng đều các mặt rồi vớt ra để ráo dầu.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 6,
      "instruction": "Cà chua cắt múi cau. Đun nóng dầu ăn với màu điều, vớt bỏ hạt điều. Cho hành tím thái nhỏ vào phi thơm, sau đó cho cà chua vào xào qua.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cà chua đã xào vào nồi nước cua, thêm nước vừa ăn, nêm một thìa mắm tôm. Đun sôi rồi hạ lửa nhỏ cho nước dùng thấm vị."
    },
    {
      "stepNumber": 8,
      "instruction": "Phi thơm hành khô đến khi vàng thì trút phần gạch cua đã ướp vào, đảo đều đến khi gạch tan hết. Đây là phần nước màu — có thể cho luôn vào nồi nước riêu hoặc để riêng chan vào từng bát khi ăn.",
      "tip": "Bước làm nước màu theo vietnamlike; Thanh Niên không có bước này."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho đậu phụ đã chiên vào nồi nước riêu, đun sôi trở lại. Khi gần ăn, cho giấm bỗng vào từ từ, nêm nếm lại cho vừa miệng (chua thanh, mặn vừa).",
      "tip": "Lượng giấm bỗng tùy khẩu vị — cho từng ít một rồi nếm."
    },
    {
      "stepNumber": 10,
      "instruction": "Rau sống nhặt rửa sạch để ráo. Rau muống chẻ sợi ngâm nước cho giòn; hoa chuối thái mỏng ngâm ngay vào nước có vắt chanh cho trắng, vớt ra để ráo."
    },
    {
      "stepNumber": 11,
      "instruction": "Chia bún tươi ra 4 bát, gắp riêu cua đặt lên trên mỗi bát.",
      "tip": "Có thể chần nhanh bún qua nước sôi nếu muốn ăn nóng."
    },
    {
      "stepNumber": 12,
      "instruction": "Chan nước dùng nóng cùng đậu phụ và cà chua vào từng bát, rắc hành lá cắt khúc lên trên. Dọn kèm đĩa rau sống, chén mắm tôm, chanh cắt miếng và ớt tươi.",
      "tip": "Bún riêu ăn nóng mới ngon; mắm tôm cho thêm vào bát tùy khẩu vị."
    }
  ],
