  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Ép đậu phụ cho ráo: đặt miếng đậu lên rổ hoặc khay có lót khăn sạch, chèn vật nặng lên trên, để yên 15–20 phút cho nước trong đậu thoát ra hết.",
      "tip": "Đậu càng ráo thì khi chiên càng giòn, vàng đều và ít bị bắn dầu.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 2,
      "instruction": "Cắt đậu phụ thành miếng vuông vừa ăn, mỗi miếng khoảng 3 cm.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế rau củ: tỏi băm nhuyễn; hành tây băm nhỏ; cà rốt thái sợi mỏng; ớt hiểm thái lát; ngò rí và hành lá cắt nhỏ để riêng.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 4,
      "instruction": "Pha nước sốt cay: cho đường thốt nốt, tom yum paste, nước mắm và nước cốt chanh vào bát, khuấy đều đến khi đường tan hoàn toàn.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 5,
      "instruction": "Nếm thử sốt và điều chỉnh cho cân bằng bốn vị chua – cay – mặn – ngọt theo khẩu vị: thêm chanh nếu muốn chua, thêm ớt nếu muốn cay, thêm đường nếu muốn dịu.",
      "tip": "Sốt ngon phải hơi đậm một chút vì khi rưới lên đậu nhạt sẽ vừa ăn.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 6,
      "instruction": "Đun nóng dầu đậu phộng trong chảo sâu lòng đến khoảng 180–190°C. Thử bằng cách thả đầu đũa vào: thấy bọt sủi đều quanh đũa là dầu đã đủ nóng.",
      "tip": "Không để dầu quá nóng (bốc khói) sẽ làm đậu cháy xém bên ngoài mà bên trong chưa giòn.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 7,
      "instruction": "Thả nhẹ từng miếng đậu vào chảo, chiên thành nhiều mẻ, mỗi mẻ 3–5 phút đến khi đậu vàng giòn đều các mặt. Vớt ra để ráo dầu trên giấy thấm.",
      "tip": "Không thả quá nhiều đậu một lúc để nhiệt dầu không bị tụt, đậu sẽ bị mềm thay vì giòn.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Tùy chọn: phi thơm một nửa phần tỏi băm với một ít dầu nóng đến vàng rồi trộn vào bát sốt để dậy mùi thơm.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 9,
      "instruction": "Xếp đậu chiên ra đĩa, rưới đều nước sốt cay lên trên. Hoặc bày đậu ra đĩa riêng và để sốt chấm bên cạnh tùy sở thích.",
      "timerMinutes": 0
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc ngò rí, hành lá và vài lát ớt lên mặt, dọn ra dùng ngay khi đậu còn nóng giòn.",
      "timerMinutes": 0
    }
  ],
