  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Lột vỏ và đầu tôm, giữ lại toàn bộ vỏ và đầu để nấu nước dùng. Rạch lưng tôm lấy chỉ đen, rửa sạch để ráo.",
      "tip": "Tôm có đầu càng tốt — gạch tôm trong đầu cho nước dùng thêm béo và đậm vị."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho vỏ và đầu tôm vào nồi cùng dầu ăn và củ cải trắng băm (nếu dùng). Phi trên lửa vừa-lớn, dùng xẻng dằm đầu tôm cho gạch chảy ra, đến khi vỏ chuyển đỏ hết và đáy nồi hơi xém nâu thì thêm nước vào.",
      "tip": "Phi vỏ tôm cho xém nhẹ là bí quyết để nước dùng thơm mùi tôm nướng.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Đun sôi rồi hạ lửa liu riu 5 phút, sau đó vớt bỏ hết vỏ tôm. Đong lấy 4 chén nước dùng; nếu thiếu thì chêm thêm nước lọc.",
      "tip": "Nếu không có tôm còn vỏ, thay bằng nước dùng gà không muối ngon (tự nấu càng tốt).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Sơ chế thảo mộc: sả đập dập, cắt khúc 5cm; riềng thái lát mỏng; lá chanh kaffir xé nhỏ bỏ gân giữa; ớt giã dập hoặc băm nhuyễn.",
      "tip": "Chỉ dùng nửa dưới của cây sả (phần non thơm nhất); sả khô bột không dùng được cho món này."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho sả, riềng, lá chanh, ớt và nấm vào nồi nước dùng, đun liu riu 5 phút cho thảo mộc tiết mùi thơm.",
      "tip": "Sả, riềng, lá chanh để nguyên miếng to trong canh chỉ để lấy mùi, không ăn được — nhớ dặn người ăn hoặc vớt ra trước khi cho nấm vào.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm nước mắm và tương ớt Thái vào nồi. Múc một ít nước dùng ra chén, khuấy tan tương ớt trước rồi đổ lại vào nồi cho dễ hòa đều.",
      "tip": "Không nhầm tương ớt Thái (nam prik pao) với gói gia vị tom yum ăn liền."
    },
    {
      "stepNumber": 7,
      "instruction": "Đun cho canh sôi trở lại rồi cho tôm vào, nấu 30-45 giây đến khi tôm mới chín một nửa.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Tắt bếp ngay, để nhiệt dư của canh làm chín tôm hoàn toàn trong khoảng 1 phút.",
      "tip": "Không nấu tôm quá lâu — tôm dai là hỏng cả nồi canh.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Cho nước cốt chanh vào, nếm và chỉnh vị: canh tom yum phải chua dẫn đầu, mặn vừa, cay the thé; nếu quá chua thì thêm đường. Nếu ăn không với cơm thấy quá đậm, pha loãng bằng ít nước nóng.",
      "tip": "Tuyệt đối tắt bếp rồi mới cho nước chanh — chanh đun sôi sẽ bị đắng và mất vị chua tươi (lưu ý quan trọng của Mark Wiens)."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc ngò rí thái nhỏ lên trên, dọn nóng cùng cơm lài. Có thể ăn kèm trứng chiên kiểu Thái."
    }
