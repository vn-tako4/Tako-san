  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: rửa sạch, bóc vỏ, rút chỉ đen trên lưng, để ráo.",
      "tip": "Dùng tôm tươi còn vỏ để canh ngọt nước hơn; có thể giữ vỏ nấu lấy nước dùng riêng nếu muốn."
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế rau củ: bắp cải thái miếng vừa ăn, rửa sạch để ráo; cà chua bổ múi cau; tỏi băm nhỏ; hành lá thái nhỏ, phần đầu hành trắng để riêng.",
      "tip": "mytour.vn: bắp cải thái miếng vừa ăn, rửa sạch; cà chua thái lát mỏng."
    },
    {
      "stepNumber": 3,
      "instruction": "Bắc nồi lên bếp, cho 1 muỗng canh dầu ăn vào, phi thơm tỏi băm và đầu hành trắng.",
      "tip": "recipes.net: phi tỏi 1 phút cho mềm thơm rồi mới cho xì dầu vào xào đến khi xì dầu sôi lăn tăn.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 4,
      "instruction": "Cho tôm vào nồi, đảo nhanh tay 1-2 phút đến khi tôm săn lại, hơi chuyển hồng.",
      "tip": "mytour.vn: đảo đầu hành và tôm cho thơm trước khi thêm nước — giúp tôm không tanh và canh thơm hơn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ 1.5 lít nước vào nồi, đun sôi; vớt bọt kỹ để nước canh trong.",
      "tip": "Vớt bọt là bước quan trọng của tom chuet — canh phải trong, vị thanh (foodstyla)."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cà chua vào, nấu 2-3 phút cho cà chua hơi mềm, ra màu đẹp.",
      "tip": "mytour.vn: cho cà chua vào trước bắp cải để cà chua kịp mềm và lên màu.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho bắp cải vào, nấu thêm 3-4 phút đến khi bắp cải vừa chín tới, còn giữ độ giòn ngọt.",
      "tip": "mytour.vn: nấu đến khi bắp cải chín tới thì tắt bếp — nấu nhừ sẽ mất vị ngọt giòn.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm 2 muỗng canh xì dầu, 1 muỗng cà phê muối, 1 muỗng cà phê đường và 1⁄2 muỗng cà phê tiêu; khuấy tan, nếm và điều chỉnh vừa khẩu vị.",
