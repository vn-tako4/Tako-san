  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: rửa sạch tôm dưới vòi nước lạnh. Dùng tăm xiên vào đốt thứ 2-3 từ đuôi để lấy chỉ lưng, dùng kéo cắt bỏ râu dài, chân và đầu nhọn của đuôi cho gọn (theo cách sơ chế của cookpad えびのうま煮).",
      "tip": "Xát nhẹ tôm với 1 muỗng cà phê muối rồi rửa lại giúp khử mùi tanh."
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế gừng: gọt vỏ (nếu muốn), lấy 1 nửa thái lát mỏng khoảng 5 mm để om cùng, 1 nửa còn lại thái sợi mỏng để rắc lên món ăn khi dọn (theo macaro-ni)."
    },
    {
      "stepNumber": 3,
      "instruction": "Hành lá rửa sạch, thái nhỏ để riêng làm đồ trang trí."
    },
    {
      "stepNumber": 4,
      "instruction": "Pha nước om: cho 300 ml nước, 3 muỗng canh sake, 3 muỗng canh mirin, 1.5 muỗng canh đường và 3 muỗng canh xì dầu vào nồi, khuấy cho đường tan bớt.",
      "tip": "Tỉ lệ nước om theo macaro-ni (2 phần: nước 200 ml, mỗi loại gia vị 2 muỗng canh, đường 1 muỗng canh) nhân 1.5 cho 3 phần."
    },
    {
      "stepNumber": 5,
      "instruction": "Đặt nồi nước om lên bếp lửa vừa, đun sôi rồi cho phần gừng thái lát vào."
    },
    {
      "stepNumber": 6,
      "instruction": "Khi nước om sôi lại, nhẹ nhàng xếp tôm vào nồi thành một lớp, đậy nắp rớt (otoshibuta) hoặc đậy hé vung.",
      "tip": "Xếp tôm một lớp để chín đều; không đảo nhiều làm nát tôm."
    },
    {
      "stepNumber": 7,
      "instruction": "Om lửa vừa khoảng 5 phút, trong lúc om dùng muôi vớt bọt nổi trên mặt nước.",
      "tip": "MÂU THUẪN NGUỒN: macaro-ni om cá iwashi tổng 15 phút (5+10 phút); cookpad えびのうま煮 chỉ om tôm 2 phút vì tôm chín rất nhanh, om lâu thịt sẽ dai. Món này lấy 5 phút — đủ để tôm chín và ngấm vị nhưng không bị dai.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Tắt bếp, để nguyên tôm trong nước om khoảng 5-10 phút cho nguội bớt và ngấm gia vị (theo cookpad: để nguội trong nước om rồi mới dọn).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 9,
      "instruction": "Gắp tôm ra đĩa sâu lòng, rưới lên trên 2-3 muỗng canh nước om còn ấm."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc gừng thái sợi và hành lá thái nhỏ lên trên mặt. Dọn nóng, ăn kèm cơm trắng.",
      "tip": "Gừng thái sợi lúc cuối tạo điểm nhấn vị cay thơm tươi, đúng kiểu 生姜煮 của macaro-ni."
    }
  ],
