  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Đùi gà chặt miếng vừa ăn, rửa sạch. Đun sôi một nồi nước, cho rượu nấu ăn vào, chần gà 2-3 phút cho ra hết bọt bẩn rồi vớt ra rửa lại bằng nước lạnh, để ráo.",
      "tip": "Chần sơ giúp khử mùi hôi và nước hầm trong hơn (nguồn 1 và nguồn 3 đều làm vậy).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 2,
      "instruction": "Kim chi cắt miếng to bản (không cắt quá nhỏ để hầm lâu không bị nát). Hành tây thái múi cau, tỏi băm nhỏ, hành lá cắt khúc.",
      "tip": "Nguồn 2 nhấn mạnh: món này càng nhiều kim chi càng ngon."
    },
    {
      "stepNumber": 3,
      "instruction": "Trộn đều trong bát nhỏ: tương ớt Hàn, ớt bột Hàn, xì dầu, đường, tỏi băm, tiêu xay và dầu mè thành hỗn hợp sốt sánh."
    },
    {
      "stepNumber": 4,
