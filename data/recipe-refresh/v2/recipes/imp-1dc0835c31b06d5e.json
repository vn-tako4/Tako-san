  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thấm khô tôm bằng khăn giấy; ướp tôm với muối, bột ớt paprika, tiêu đen và 1 muỗng canh dầu; trộn đều, để riêng.",
      "tip": "Thấm khô giúp tôm săn và không ra nước khi xào lửa lớn."
    },
    {
      "stepNumber": 2,
      "instruction": "Cắt bông cải thành miếng vừa ăn. Băm nhỏ tỏi và gừng; ớt khô cắt khúc nếu dùng.",
      "tip": "Công thức gợi ý tận dụng cuống bông cải: gọt vỏ, bổ tư rồi muối chua như dưa leo, ăn rất ngon."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sẵn nước sốt trước khi bật bếp: khuấy đều nước, đường, tương hàu, xì dầu, tương hoisin, bột bắp và xì dầu đen trong một bát.",
      "tip": "Pha sốt trước vì bước xào diễn ra rất nhanh, không kịp pha giữa chừng."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun wok/chảo trên lửa lớn đến bốc khói; rưới dầu, tráng đều đáy chảo. Cho tôm vào đảo nhanh khoảng 2 phút đến khi tôm vừa chuyển hồng; gắp tôm ra (bên trong còn hơi trong).",
      "tip": "Tôm chưa cần chín hẳn vì sẽ được nấu tiếp với sốt ở bước sau; xào quá tay tôm sẽ bị dai.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Nghiêng chảo giữ dầu lại trong chảo. Vặn lửa vừa, cho tỏi, gừng, ớt khô (nếu dùng) và bông cải vào đảo 1-2 phút.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Rưới 3 muỗng canh nước từ thành chảo vào, nhanh tay đậy nắp để giữ hơi nước, ủ cho bông cải chín tới.",
      "tip": "Nguồn chính xào bông cải rồi hấp nửa chừng bằng hơi nước, cho rằng cách này ngon hơn chần luộc. Omnivore's Cookbook hấp sơ bông cải trước khi xào — khác biệt kỹ thuật, lấy theo nguồn chính.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Mở nắp, đổ nước sốt vào, cho tôm trở lại chảo; đảo vài phút đến khi sốt sánh lại và bám đều.",
      "tip": "Nếu sốt quá đặc có thể thêm chút nước; nếu loãng, đun thêm cho cạn bớt."
    },
    {
      "stepNumber": 8,
      "instruction": "Trút ra đĩa, dọn nóng ngay với cơm trắng.",
      "tip": "Công thức gốc cho 2 phần ăn trong khoảng 15 phút; đã nhân 1,5 cho 3 phần."
    }
