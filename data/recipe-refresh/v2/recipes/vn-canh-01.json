  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá: cá lóc làm sạch, chà xát muối (hoặc chanh và muối) để khử nhớt và mùi tanh, rửa sạch, để ráo rồi cắt khúc vừa ăn."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp cá: cho cá vào âu, ướp với chút muối, tiêu xay và ớt bột cho thấm vị (theo Helen's Recipes).",
      "tip": "Ướp khoảng 10-15 phút, thỉnh thoảng lật mặt cá cho ngấm đều.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Lấy nước cốt me: ngâm cơm me chín trong nước ấm cho mềm, dằm nhuyễn rồi lọc qua rây lấy nước cốt, bỏ bã và hạt.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Sơ chế rau củ: cà chua cắt múi cau; thơm cắt lát vừa ăn; đậu bắp bỏ cuống, cắt xéo; dọc mùng (bạc hà) tước vỏ, cắt xéo; giá đỗ rửa sạch để ráo; rau ngổ, ngò gai, hành lá cắt khúc ngắn khoảng 2cm.",
      "tip": "Dọc mùng dễ gây ngứa — nên đeo găng tay khi tước vỏ và có thể bóp qua muối, rửa sạch."
    },
    {
      "stepNumber": 5,
      "instruction": "Phi tỏi: đun nóng dầu ăn, cho 20g tỏi băm vào phi đến hơi vàng thì vớt ra để ráo, giữ lại phần dầu tỏi để nấu canh.",
      "tip": "Tỏi phi vàng để riêng, rắc lên tô canh lúc dọn cho bắt mắt và dậy mùi (theo Netspace)."
    },
    {
      "stepNumber": 6,
      "instruction": "Xào thơm nền canh: dùng nồi nấu canh, cho 10g tỏi băm và ớt hiểm đập dập vào phần dầu tỏi còn lại, phi thơm ở lửa vừa."
    },
    {
      "stepNumber": 7,
      "instruction": "Nấu nước canh: đổ 1.5 lít nước vào nồi, đun sôi. Khi nước sôi, cho chén gia vị đã cân sẵn (hạt nêm, nước mắm, muối, đường, nước cốt me) vào, khuấy tan và nêm nếm cho hài hòa vị chua mặn ngọt.",
      "tip": "Cho nước me từ từ và nêm lại — vị chua nên thanh, không gắt."
    },
    {
      "stepNumber": 8,
      "instruction": "Nấu cá: khi nước canh sôi lại, cho cá lóc đã ướp vào, nấu khoảng 5 phút cho cá chín tới thì vớt cá ra tô để riêng. Hớt bọt để nước canh trong.",
      "tip": "Vớt cá ra trước khi cho rau củ vào để cá không bị nát và nước canh được trong.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 9,
      "instruction": "Nấu rau củ: cho cà chua, thơm và đậu bắp vào nồi nước đang sôi; nấu đến khi đậu bắp gần chín thì cho dọc mùng (bạc hà) vào, nấu chín tới. Nêm nếm lại cho vừa ăn rồi tắt bếp.",
      "tip": "Cho dọc mùng vào sau cùng vì rất nhanh chín; không nấu quá lâu rau sẽ mất màu xanh và độ giòn."
    },
    {
      "stepNumber": 10,
      "instruction": "Trình bày: múc canh ra tô, cho giá đỗ vào, gắp cá đặt lên trên. Rắc rau ngổ, ngò gai, hành lá, ớt sừng cắt lát và tỏi phi vàng. Dùng nóng với cơm trắng."
    }
  ],
