  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cơm nguội bóp nhẹ cho tơi từng hạt. Nếu có thời gian, cho cơm vào tủ lạnh khoảng 1 giờ trước khi rang.",
      "tip": "PasGo: cơm để tủ lạnh giúp hạt cơm tơi, rang ngon hơn; nhưng không để quá lâu kẻo cơm bị cứng, khó ăn.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 2,
      "instruction": "Nấm đùi gà cắt bỏ phần gốc, ngâm nước muối loãng khoảng 15 phút, xả sạch lại với nước, để ráo rồi cắt hạt lựu.",
      "tip": "Cách sơ chế nấm của Điện Máy Xanh cho cơm chiên chay.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Đậu phụ cắt hạt lựu; cà rốt gọt vỏ, cắt hạt lựu; hành lá thái nhỏ; tỏi bóc vỏ, băm nhỏ.",
      "tip": "Cắt các nguyên liệu cỡ hạt lựu đều nhau để chín đều và đẹp mắt."
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc chảo lên bếp, cho 1 muỗng canh dầu ăn vào đun nóng, phi thơm tỏi băm."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nấm đùi gà và cà rốt vào chảo, xào ở lửa vừa khoảng 2-3 phút đến khi vừa chín tới.",
      "tip": "Điện Máy Xanh: xào khoảng 2 phút cho nguyên liệu vừa chín tới; Eva: chiên 3-5 phút, đảo liên tục cho nóng đều.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm vào chảo 1 muỗng cà phê hạt nêm chay (nếu dùng) và 1 muỗng cà phê đường (nếu dùng), đảo đều cho thấm.",
      "tip": "Điện Máy Xanh nêm 1 muỗng canh hạt nêm + 1 muỗng canh đường khi xào nấm; ở đây giảm liều cho 3 phần."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho đậu phụ cắt hạt lựu vào, đảo nhẹ tay thêm khoảng 2 phút cho đậu phụ và cà rốt chín đều.",
      "tip": "Điện Máy Xanh: cho đậu hũ trắng và cà rốt vào đảo đều 2 phút. Đảo nhẹ để đậu không nát.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Hạ nhỏ lửa, cho cơm nguội vào chảo, rưới 1 muỗng canh dầu ăn còn lại lên mặt cơm, dùng giá và đũa xóc đều cho hạt cơm tơi ra.",
