  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thái thịt bò ngang thớ thành lát mỏng khoảng 6 mm.",
      "tip": "WOL: thái lát dày 1/4 inch (6 mm); thái ngang thớ giúp thịt mềm, không dai."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp thịt: cho thịt bò vào tô cùng 1 tbsp nước, 2 tsp bột bắp, 1/4 tsp baking soda, 1 tsp dầu ăn và 1,5 tsp dầu hào; trộn đều, để 30 phút đến 1 giờ.",
      "tip": "WOL: ướp 30 phút–1 giờ để baking soda làm mềm và nước + bột bắp giữ ẩm cho thịt (kỹ thuật velveting).",
      "timerMinutes": 30
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sốt: trộn xì dầu, đường, dầu mè, tiêu trắng trong một bát nhỏ. Pha riêng 1 tsp bột bắp với 1 tbsp nước trong chén khác.",
      "tip": "Pha sẵn sốt và bột bắp trước khi bật bếp vì các bước xào diễn ra rất nhanh."
    },
    {
      "stepNumber": 4,
      "instruction": "Sơ chế rau củ: cà chua bổ múi cau; tỏi băm nhỏ; gừng thái lát mỏng; hành khô thái lát mỏng; hành lá cắt khúc 5 cm, tách riêng phần trắng và phần xanh.",
      "tip": "Cắt cà chua thành miếng vừa ăn để khi xào nhanh vẫn giữ được hình dạng."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng wok/chảo với 1 tbsp dầu đến vừa bốc khói; trải thịt bò ra khắp mặt chảo, áp chảo khoảng 1 phút đến khi thịt chín khoảng 80% thì múc ra để riêng.",
      "tip": "WOL: xào thịt riêng trước, chỉ đến 80% chín vì thịt sẽ chín tiếp khi trộn lại — xào quá tay thịt sẽ dai.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Cho 1 tbsp dầu còn lại vào chảo lửa vừa; cho gừng lát vào phi khoảng 10 giây cho xém cạnh; vặn lửa lớn, cho tỏi băm, hành khô và phần trắng hành lá vào đảo 10 giây.",
      "tip": "WOL: để gừng hơi cháy cạnh (caramelize) 10 giây cho dậy mùi thơm đặc trưng."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho tương cà (và bột cà chua nếu dùng) vào, xào 30 giây cho thơm; cho cà chua vào, trải đều một lớp, áp chảo 15 giây; rưới rượu Shaoxing quanh thành chảo, xào thêm 10 giây.",
      "tip": "WOL: xào ketchup trước cho dậy mùi rồi mới cho cà chua; rưới rượu quanh thành chảo nóng để hương rượu bốc lên.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Gạt hỗn hợp cà chua sang một bên chảo, đổ chén sốt vào khoảng trống, khuấy đến khi sốt sôi lăn tăn hòa quyện.",
      "tip": "WOL: nấu sốt riêng trong khoảng trống của chảo để các vị kịp hòa quyện trước khi trộn thịt vào."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho thịt bò (cả phần nước thịt trong bát) trở lại chảo, xào lửa lớn khoảng 20 giây cho mọi thứ quyện đều.",
      "tip": "WOL cảnh báo: đừng xào cà chua quá lâu kẻo cà nát thành sốt — giữ miếng cà còn nguyên hình."
    },
    {
      "stepNumber": 10,
      "instruction": "Cho phần xanh hành lá vào; rưới từ từ hỗn hợp bột bắp pha nước, vừa rưới vừa đảo đến khi sốt sánh vừa ý; để sôi thêm 15 giây cho bột bắp chín hẳn.",
      "tip": "WOL: cho bột bắp từng chút một đến độ sánh mong muốn; đun thêm 15 giây sau lần cho cuối để bột không còn mùi sống."
    },
    {
      "stepNumber": 11,
      "instruction": "Nêm lại muối cho vừa ăn, dọn ngay ra đĩa, ăn nóng với cơm trắng.",
      "tip": "Cả hai nguồn đều dặn dọn ngay khi còn nóng; AS gợi ý ăn kèm rau xanh luộc/xào đơn giản."
    }
  ],
