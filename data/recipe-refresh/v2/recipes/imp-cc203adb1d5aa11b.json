  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá: đánh vảy, bỏ ruột nếu dùng cá nguyên con, rửa sạch. Xát đều muối hạt lên mình cá rồi rửa lại bằng nước sạch để khử mùi tanh, cắt khúc vừa ăn, thấm khô.",
      "tip": "Hungry in Thailand khuyên xát muối rồi rửa lại giúp giảm mùi tanh của cá nước ngọt."
    },
    {
      "stepNumber": 2,
      "instruction": "Sả bóc bỏ lớp già bên ngoài, đập dập, cắt khúc dài khoảng 5 cm. Cà chua bổ múi cau. Hành lá rửa sạch, cắt khúc 2 cm. Chanh vắt lấy nước cốt để riêng."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun 2 lít nước trên lửa vừa cho sôi, thả sả đập dập vào, nấu 5 phút cho nước dùng dậy mùi thơm.",
      "tip": "Hungry in Thailand: ninh các loại thơm (sả, riềng...) khoảng 5 phút trước khi cho cá.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Nêm 3 muỗng canh nước mắm, 2 muỗng cà phê muối và 1 muỗng cà phê đường vào nồi, khuấy tan, nếm thử nước dùng."
    },
    {
      "stepNumber": 5,
      "instruction": "Thả nhẹ từng khúc cá vào nồi nước đang sôi liu riu, nấu khoảng 3 phút cho cá se mặt.",
      "tip": "Thả cá khi nước đang sôi để cá không tanh.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cà chua bổ múi cau vào, nấu thêm 3–4 phút đến khi cá chín tới (thịt cá tách nhẹ là rời) và cà chua vừa mềm. Vớt bọt nếu có.",
      "tip": "Hungry in Thailand: không đảo mạnh sau khi cho cá để cá không bị nát.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nếm lại cho vừa miệng: vị mặn của nước mắm, chua nhẹ của cà chua, ngọt thanh của nước dùng."
    },
    {
      "stepNumber": 8,
      "instruction": "Tắt bếp, rưới nước cốt 2 quả chanh vào nồi, khuấy nhẹ một vòng.",
      "tip": "Cho nước chanh sau khi tắt bếp để giữ mùi thơm tươi — kỹ thuật nêm tom yum của Hot Thai Kitchen."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho hành lá cắt khúc vào, múc canh ra tô lớn."
    },
    {
      "stepNumber": 10,
      "instruction": "Ăn nóng với cơm trắng. Có thể dọn kèm ớt tươi cắt lát cho người thích ăn cay."
    }
  ],
