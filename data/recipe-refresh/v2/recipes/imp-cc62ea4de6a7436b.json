  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Tôm bóc vỏ, bỏ đầu, dùng tăm hoặc dao khía dọc sống lưng lấy bỏ chỉ đen, rửa sạch, để ráo."
    },
    {
      "stepNumber": 2,
      "instruction": "Đun một nồi nước cho sôi già, thả tôm vào luộc 30–60 giây đến khi tôm cong lại, chuyển màu đỏ cam thì vớt ra ngay, để ráo và để nguội.",
      "tip": "Yam Saparot Phuket: luộc tôm chỉ 30 giây–1 phút tùy cỡ tôm; luộc lâu tôm bị dai.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 3,
      "instruction": "Dứa gọt vỏ, bỏ mắt, cắt thành miếng vuông cạnh 1–1,5 cm.",
      "tip": "Gastrofun: cắt các nguyên liệu cùng cỡ để mỗi miếng gỏi đều có đủ vị."
    },
    {
      "stepNumber": 4,
      "instruction": "Hành tím bóc vỏ thái lát mỏng; hành lá xắt nhỏ; ớt hiểm xắt lát mỏng; bạc hà xắt rối."
    },
    {
      "stepNumber": 5,
      "instruction": "Pha nước trộn gỏi: cho 2 muỗng canh nước cốt chanh, 2 muỗng canh nước mắm và 1 muỗng canh đường vào chén, khuấy đều đến khi đường tan hết."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho dứa, tôm luộc, hành tím, hành lá và ớt hiểm vào tô lớn."
    },
    {
      "stepNumber": 7,
      "instruction": "Rưới đều nước trộn lên, trộn nhẹ tay cho các nguyên liệu thấm đều gia vị."
    },
    {
      "stepNumber": 8,
      "instruction": "Để gỏi nghỉ 10 phút cho ngấm vị, sau đó nếm lại và điều chỉnh chua–mặn–ngọt–cay cho vừa miệng.",
      "tip": "Gastrofun: để gỏi nghỉ 10 phút cho các vị hòa quyện; dứa ngọt quá thì thêm chút nước cốt chanh (mẹo của Yam Saparot Phuket).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 9,
      "instruction": "Rắc đậu phộng rang giã dập và lá bạc hà xắt rối lên trên.",
      "tip": "Trộn đậu phộng vào sát lúc ăn để giữ độ giòn (Gastrofun)."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn ngay khi còn tươi mát, dùng làm món khai vị hoặc ăn kèm cơm.",
      "tip": "Gỏi dứa ra nước nếu để lâu — nên trộn và ăn trong ngày (Gastrofun)."
    }
  ],
