  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sườn rửa sạch, chặt khúc khoảng 4 cm. Nếu mua sườn cây, nhờ người bán chặt sẵn.",
      "tip": "Chọn sườn non còn sụn mềm, thịt hồng tươi."
    },
    {
      "stepNumber": 2,
      "instruction": "Đun sôi một nồi nước, cho sườn vào chần 8 phút cho ra hết bọt bẩn. Vớt ra, rửa lại dưới vòi nước sạch, để ráo.",
      "tip": "Chần và rửa giúp nước sốt trong, sườn không bị hôi.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 3,
      "instruction": "Dứa gọt vỏ, bỏ mắt, thái miếng tam giác vừa ăn. Cà chua bổ múi cau. Tỏi đập dập. Gừng thái lát mỏng."
    },
    {
      "stepNumber": 4,
      "instruction": "Pha sốt chua ngọt: cho ketchup, giấm trắng, đường, xì dầu nhạt, xì dầu đặc, rượu nấu ăn và 300 ml nước vào tô, khuấy cho đường tan."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng dầu ăn trong nồi hoặc chảo sâu lòng, cho tỏi và gừng vào phi thơm khoảng 30 giây.",
      "tip": "Không để tỏi cháy vàng quá sẽ đắng."
    },
    {
      "stepNumber": 6,
