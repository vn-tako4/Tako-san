  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau củ: nhặt rửa sạch xà lách, húng quế, hẹ, giá đỗ; dưa leo rửa sạch, chẻ dọc thành miếng dài vừa cuốn. Ngâm tất cả qua nước muối loãng 5 phút rồi rửa lại, để thật ráo.",
      "tip": "Rau phải ráo nước thì cuốn mới chắc, không bị nhão bánh tráng (thewaterman).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Làm dưa chua ăn kèm: cà rốt và củ cải trắng bào sợi, cho vào tô cùng 3 muỗng canh đường, 1/2 chén giấm, 1/2 chén nước lọc, 1/2 muỗng cà phê muối; trộn đều và để yên cho ngấm đến lúc ăn.",
      "tip": "Để tối thiểu 15 phút cho dưa thấm vị chua ngọt (thewaterman).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Luộc thịt: cho 1 lít nước vào nồi cùng 1 củ hành tím đập dập và 1/4 muỗng cà phê muối, đun sôi rồi thả thịt ba chỉ vào luộc 15–20 phút. Dùng đũa xiên thấy không còn nước hồng là chín. Vớt thịt ra để nguội rồi thái lát mỏng vừa ăn.",
      "tip": "naungon: luộc thịt với nước pha chút giấm và muối cho thịt trắng; ngâm nước lạnh 15 phút sau khi vớt để thịt giòn, không thâm.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 4,
      "instruction": "Luộc tôm: dùng lại nồi nước luộc thịt, thả tôm vào luộc khoảng 5 phút đến khi tôm chuyển đỏ đều. Vớt ra để nguội, bóc vỏ, bỏ chỉ đen trên lưng, chẻ đôi tôm theo chiều dọc.",
      "tip": "naungon: tôm luộc chín vớt ra ướp nước đá 15 phút cho thịt tôm giòn. Ướp tôm với chút muối, đường, rượu trước khi luộc giúp tôm đậm đà, không tanh (eva.vn).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 5,
      "instruction": "Làm nước chấm tương đậu phộng: cho 2 muỗng cà phê dầu ăn vào chảo, phi thơm tỏi băm. Cho 100 ml tương đen, 2 muỗng canh bơ đậu phộng, 1 muỗng canh đường và chút nước vào, khuấy đều đến khi hỗn hợp sánh mịn thì tắt bếp.",
      "tip": "naungon: nêm tương hơi ngòn ngọt vì khi chấm sẽ dùng nhiều; cuối cùng thêm ít giấm cho vị chua cân bằng.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Đậu phộng rang giã dập vừa (không giã nát để giữ độ bùi); ớt băm nhỏ để riêng."
    },
    {
      "stepNumber": 7,
      "instruction": "Làm mềm bánh tráng: nhúng nhanh từng tấm bánh tráng qua nước sạch hoặc dùng khăn ẩm vuốt nhẹ cho bánh dẻo lại, trải lên mặt phẳng sạch.",
      "tip": "Không ngâm lâu, bánh sẽ nhão và rách khi cuốn (thewaterman)."
    },
    {
      "stepNumber": 8,
      "instruction": "Cuốn gỏi: xếp lên bánh tráng lần lượt xà lách, rau thơm, giá đỗ, dưa leo, bún và thịt luộc; cuộn 2 vòng rồi xếp tôm (đặt mặt đỏ xuống cho đẹp) xen kẽ cọng hẹ, cuộn chặt tay đến hết bánh. Làm lần lượt đến hết nguyên liệu.",
      "tip": "Cho lượng nhân vừa phải, cuộn chắc nhưng không quá mạnh tay để bánh không rách (thewaterman, naungon)."
    },
    {
      "stepNumber": 9,
      "instruction": "Múc tương đậu phộng ra chén nhỏ, rắc đậu phộng giã nhỏ và ớt băm lên trên. Dọn gỏi cuốn ra đĩa cùng dưa chua."
    },
    {
      "stepNumber": 10,
      "instruction": "Thưởng thức: chấm từng cuốn gỏi vào chén tương đậu phộng, ăn kèm dưa chua cho đỡ ngán.",
      "tip": "Gỏi cuốn ngon nhất khi ăn ngay sau khi cuốn; để lâu bánh tráng sẽ dai cứng (thewaterman)."
    }
  ],
