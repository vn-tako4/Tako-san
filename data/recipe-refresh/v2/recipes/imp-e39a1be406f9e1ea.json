  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thái nhỏ hành lá. Cho hành lá, nước mắm, dầu mè, đường và hạt tiêu vào bát nhỏ, trộn đều, để nghỉ vài phút cho ngấm.",
      "tip": "Kimchimari."
    },
    {
      "stepNumber": 2,
      "instruction": "Đập 4 quả trứng vào tô lớn, đánh tan đều bằng phới hoặc nĩa."
    },
    {
      "stepNumber": 3,
      "instruction": "Thêm 200 ml nước vào tô trứng, khuấy đều.",
      "tip": "Kimchimari: đánh trứng với nước cho hòa quyện."
    },
    {
      "stepNumber": 4,
      "instruction": "Đổ hỗn hợp hành lá-nước mắm ở bước 1 vào tô trứng, trộn đều."
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ hỗn hợp trứng vào nồi đất Hàn (ttukbaegi) hoặc nồi đáy dày nhỏ có nắp đậy kín. Đậy nắp, nấu trên lửa vừa 7-8 phút.",
      "tip": "Nồi đất giữ nhiệt tốt giúp trứng bông xốp; không có nồi đất có thể dùng nồi inox đáy dày (Maangchi).",
      "timerMinutes": 8
    },
    {
      "stepNumber": 6,
      "instruction": "Mở nắp: lúc này trứng đã chín một nửa, phần giữa còn loãng — dùng thìa khuấy nhẹ từ đáy lên trên cho chín đều, rồi đậy nắp lại.",
      "tip": "Bước khuấy giữa chừng giúp trứng chín đều, không cháy đáy — Kimchimari."
    },
    {
      "stepNumber": 7,
      "instruction": "Giảm xuống lửa nhỏ, nấu thêm 3 phút cho trứng chín hẳn, bông xốp như souffle.",
      "tip": "Kimchimari.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Nếu thích lớp đáy hơi cháy xém như ở quán thịt nướng Hàn, nấu thêm 1-2 phút — không quá 2 phút kẻo đắng.",
      "tip": "Kimchimari: đây là phần ngon nhất với nhiều người; tùy chọn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, rắc thêm chút tiêu, ớt bột (nếu dùng) và hành lá lên trên. Dọn ngay khi còn bốc hơi, ăn kèm cơm nóng.",
      "tip": "Maangchi: trứng hấp ngon nhất khi ăn nóng ngay."
    }
  ],
