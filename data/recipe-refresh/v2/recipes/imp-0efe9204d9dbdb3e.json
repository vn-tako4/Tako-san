  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cắt ớt khô thành đoạn ngắn, bỏ hạt, cho vào ngâm nước 15 phút rồi vớt ra để ráo.",
      "tip": "CSF: ngâm nước giúp ớt không bị cháy khi phi lửa nhỏ và dậy mùi thơm hơn. GSS không ngâm mà phi ớt lửa nhỏ 1-2 phút — hai nguồn khác nhau, lấy theo CSF (nguồn chính).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Lọc xương đùi gà, cắt thịt thành miếng vuông khoảng 2 cm. Cho vào tô lớn, ướp với xì dầu, rượu nấu ăn, tiêu trắng, muối và bột bắp (nếu dùng); trộn đều, để yên khoảng 10 phút.",
      "tip": "CSF ướp ~10 phút. GSS ướp ít nhất 1 giờ và giữ lại nước ướp để xào sau — mâu thuẫn; lấy 10 phút theo CSF vì công thức này không tái sử dụng nước ướp.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng dầu chiên nông trong chảo hoặc wok cho thật nóng (cắm đũa vào thấy sủi bọt). Cho gà vào chiên từng mẻ đến vàng giòn rồi vớt ra để ráo dầu.",
      "tip": "CSF: chiên nông tiết kiệm dầu hơn chiên ngập; chiên từng mẻ để gà tiếp xúc đáy chảo, chín nhanh và giòn. Sau khi cho gà vào, để yên 40 giây-1 phút cho một mặt vàng rồi mới đảo mặt còn lại."
    },
    {
      "stepNumber": 4,
      "instruction": "Dùng chảo sạch, cho 1/2 muỗng canh dầu, phi ớt khô trên lửa nhỏ nhất 1-2 phút đến khi hầu hết ớt chuyển màu đỏ sẫm.",
      "tip": "CSF: chỉ cắt một phần ớt thành đoạn, giữ phần còn lại nguyên quả; có thể giảm còn 15-20 quả nếu không ăn cay được. Phi lửa nhỏ nhất để ớt dậy mùi mà không cháy.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Cho hoa tiêu Tứ Xuyên vào chảo, tiếp tục phi thêm 1 phút trên lửa nhỏ nhất.",
      "tip": "Hoa tiêu tạo vị tê 'ma' đặc trưng của món; cẩn thận không để cháy sẽ bị đắng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Gạt ớt và hoa tiêu sang một bên chảo, thêm 1/2 muỗng canh dầu, phi thơm gừng thái lát, đầu hành trắng và tỏi.",
      "tip": "CSF tách riêng đầu hành trắng (phi thơm ở bước này) và lá hành (cho vào cuối để giữ màu xanh)."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho gà chiên trở lại chảo, rắc mè trắng rang, đường, muối và phần lá hành cắt khúc; đảo đều cho thấm gia vị.",
      "tip": "Đảo nhanh tay rồi dọn ngay để gà giữ độ giòn; nêm nếm lại muối/đường cho vừa miệng."
    },
    {
      "stepNumber": 8,
      "instruction": "Trút ra đĩa, dọn nóng ngay.",
      "tip": "Quy tắc số 1 của CSF: ớt khô chỉ để tạo mùi vị, không ăn — thực khách gắp thịt trong 'biển ớt'. GSS mô tả đây là món ăn nhâm nhi: vừa trò chuyện vừa gắp thịt, không nên ăn vội."
    }
  ],
