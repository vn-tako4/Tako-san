  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: cắt bỏ râu, dùng dao khía nhẹ sống lưng rút bỏ chỉ đen, rửa sạch, để ráo.",
      "tip": "Đầu và vỏ tôm có thể giữ lại ninh với ít nước để lấy nước ngọt cho nồi canh (mẹo của bepminhha/ngoisao)."
    },
    {
      "stepNumber": 2,
      "instruction": "Sả bóc bỏ lớp già bên ngoài, đập dập rồi cắt khúc khoảng 5 cm. Cà chua rửa sạch, bổ múi cau. Chanh vắt lấy nước cốt, bỏ hạt. Hành lá rửa sạch, cắt nhỏ. Ớt hiểm cắt lát."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng 1 muỗng canh dầu ăn trong nồi, cho tôm vào xào nhanh tay đến khi tôm chuyển màu hồng thì vớt ra đĩa.",
      "tip": "Chỉ xào chín tới, tôm còn nấu tiếp trong nồi canh — xào kỹ quá tôm sẽ bị bở, mất vị ngọt (naungon.com).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 4,
      "instruction": "Cho 1,2 lít nước lọc vào nồi cùng sả đập dập, đun sôi.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 5,
      "instruction": "Khi nước sôi, cho cà chua bổ múi cau vào, nêm 3 muỗng canh nước mắm, 1 muỗng cà phê muối và 2 muỗng cà phê đường."
    },
    {
      "stepNumber": 6,
      "instruction": "Nước sôi lại thì cho tôm đã xào sơ vào, nấu vừa sôi bùng lên.",
      "tip": "Không đun tôm quá lâu — tôm chín tới là ngon nhất.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nếm lại cho vừa khẩu vị chua-mặn-ngọt, cho ớt hiểm cắt lát vào."
    },
    {
      "stepNumber": 8,
      "instruction": "Tắt bếp, cho nước cốt chanh vào khuấy đều.",
      "tip": "Cho chanh sau khi tắt bếp để nước canh không bị đắng và giữ mùi thơm."
    },
    {
      "stepNumber": 9,
      "instruction": "Rắc hành lá cắt nhỏ lên trên."
    },
    {
      "stepNumber": 10,
      "instruction": "Múc canh ra tô, dùng nóng với cơm trắng."
    }
  ],
