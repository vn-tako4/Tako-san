  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế mực: rút bỏ túi mực, nội tạng, mắt và răng ở đầu mực; lột bỏ lớp da ngoài nếu muốn món kho lên màu đẹp.",
      "tip": "olasquid: lột da giúp màu kho đẹp hơn; khứa nhẹ thân mực hình caro để gia vị thấm sâu."
    },
    {
      "stepNumber": 2,
      "instruction": "Khử tanh: pha 1 muỗng canh rượu trắng với nước, ngâm mực khoảng 10 phút, sau đó rửa lại bằng nước sạch và để ráo.",
      "tip": "olasquid: ngâm rượu trắng 10 phút là bước khử tanh chính; cũng có thể thay bằng nước muối loãng hoặc gừng.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Cắt mực thành miếng vừa ăn; phần đầu và râu cắt gọn."
    },
    {
      "stepNumber": 4,
      "instruction": "Trụng nhanh mực qua nước sôi 1-2 phút rồi vớt ra ngay, để ráo.",
      "tip": "olasquid: trụng sơ giúp mực săn lại, giữ độ giòn và hạn chế ra nước khi kho.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Tỏi và hành tím bóc vỏ, băm nhỏ; ớt thái lát; hành lá cắt khúc khoảng 2-3 cm."
    },
    {
      "stepNumber": 6,
      "instruction": "Ướp mực: cho mực vào tô, trộn đều với nước mắm, đường, tiêu xay, hạt nêm, nước màu và ớt thái lát; để 15-20 phút cho thấm.",
      "tip": "olasquid: ướp 15-20 phút trước khi kho để món đậm đà; cho tiêu vào cả lúc ướp và lúc hoàn thành để dậy mùi.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 7,
      "instruction": "Làm nóng 3 muỗng canh dầu ăn trong chảo/nồi, cho hành tỏi băm vào phi đến vàng nhẹ, dậy mùi thơm.",
      "tip": "Không để hành tỏi cháy, sẽ làm món kho bị đắng."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho toàn bộ mực đã ướp vào, đảo nhanh tay trên lửa lớn cho mực săn lại.",
      "tip": "olasquid: bắt đầu lửa lớn để mực săn, sau đó mới hạ nhỏ lửa.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 9,
      "instruction": "Hạ nhỏ lửa, kho liu riu đến khi nước kho sánh lại, áo đều quanh từng miếng mực.",
      "tip": "olasquid: hạn chế thêm nước ngay từ đầu, tận dụng nước mực tự tiết ra; không kho quá lâu vì mực sẽ dai, mất ngọt. baomoi kho 10-15 phút lửa nhỏ.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 10,
      "instruction": "Nêm nếm lại cho vừa ăn; rắc thêm tiêu xay và hành lá cắt khúc lên trên rồi tắt bếp."
    },
    {
      "stepNumber": 11,
      "instruction": "Múc mực ra đĩa, dùng nóng với cơm trắng. Có thể ăn kèm rau sống, dưa leo và một bát canh nhạt.",
      "tip": "olasquid: món kho tiêu ăn cùng cơm trắng nóng là đưa cơm nhất."
    }
  ],
