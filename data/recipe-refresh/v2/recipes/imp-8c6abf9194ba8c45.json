  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thịt gà thấm khô, cắt miếng vừa ăn cỡ 3 cm.",
      "tip": "Nadia cắt miếng khoảng 3 cm để vừa chín đều vừa giữ được độ mọng."
    },
    {
      "stepNumber": 2,
      "instruction": "Giá đỗ rửa sạch dưới vòi nước, để ráo hoàn toàn.",
      "tip": "Giá phải thật ráo nước, nếu không khi xào sẽ ra nhiều nước làm món bị nhão (cả hai nguồn đều nhấn mạnh xào nhanh)."
    },
    {
      "stepNumber": 3,
      "instruction": "Bắc chảo lên bếp lửa vừa, láng đều dầu mè. Xếp thịt gà vào chảo, mặt da úp xuống, đậy nắp và áp chảo.",
      "tip": "Đậy nắp khi áp mặt da giúp gà chín hơi đều mà da vẫn giòn (Nadia). Trong lúc chờ, tranh thủ rửa giá.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Khi mặt dưới của gà đã trắng và se lại thì trở mặt, áp tiếp đến khi vàng đều hai mặt thì gắp gà ra đĩa.",
      "tip": "Không cần áp gà chín hẳn ở bước này vì gà còn được xào lại với giá sau.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Trộn đều gà vừa áp chảo với xì dầu và tỏi mài trong một tô riêng, để gà thấm gia vị.",
      "tip": "Nadia trộn sốt vào gà TRƯỚC khi xào chung — đây là điểm khác với cách xào thông thường (đổ sốt vào chảo), giúp từng miếng gà đậm vị hơn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Vẫn chiếc chảo đó (giữ nguyên mỡ gà), cho giá đỗ và bột nêm gà vào, đảo nhanh tay trên lửa lớn.",
      "tip": "Mẹo quan trọng của Nadia: giá đỗ chỉ xào sơ cho vừa chín tới để giữ độ giòn; xào quá lâu giá sẽ ra nước và mất độ giòn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Cho gà cùng toàn bộ nước sốt tỏi-xì dầu trở lại chảo, đảo nhanh cho sốt áo đều giá và gà rồi tắt bếp ngay.",
      "tip": "oishi-kenko hạ nhỏ lửa khi cho sốt vào để sốt sánh lại; với công thức Nadia không dùng bột năng nên chỉ đảo nhanh là đủ.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Dọn ra đĩa, rắc hành lá băm nhỏ lên trên, thêm tiêu đen xay tùy thích. Ăn nóng với cơm.",
      "tip": "Món này ngon nhất khi ăn ngay — giá đỗ để lâu sẽ mềm và ra nước."
    }
  ],
