  "steps": [
    {
      "stepNumber": 1,
      "instruction": "So che tom: boc vo, bo dau, rut chi den o lung tom. Giu lai dau va vo tom de nau nuoc dung.",
      "tip": "bepmina.vn: loc dau tom lay nuoc — nuoc dung tu dau/vo tom giup canh ngot tu nhien, khong can nhieu hat nem."
    },
    {
      "stepNumber": 2,
      "instruction": "Uop thit tom: uop phan thit tom voi mot chut muoi va tieu xay, de 15 phut cho tham.",
      "tip": "bepmina.vn uop thit tom 15 phut truoc khi xao — tom dam da hon.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "So che bi do: got vo, bo hat, rua sach, cat mieng vua an.",
      "tip": "Cat mieng vua an, khong qua nho de bi khong bi nat khi nau."
    },
    {
      "stepNumber": 4,
      "instruction": "So che hanh toi: hanh tim va toi bam nho; hanh la rua sach cat khuc; ngo ri thai nho (neu dung)."
    },
    {
      "stepNumber": 5,
      "instruction": "Nau nuoc dung tom: cho dau va vo tom vao noi voi 1 lit nuoc loc, dun soi vai phut cho ra het chat ngot roi vot bo dau/vo, loc lay nuoc trong.",
      "tip": "bepmina.vn loc dau tom lay nuoc dung — vot ky bop de nuoc canh trong."
    },
    {
      "stepNumber": 6,
      "instruction": "Phi thom hanh toi: dun nong 1 muong canh dau an, cho hanh tim va toi bam vao phi thom, cho thit tom da uop vao xao san.",
      "tip": "Xao tom vua san toi de tom ngot, khong xao ky tom se bi kho."
    },
    {
      "stepNumber": 7,
      "instruction": "Do nuoc dung tom vao noi, dun soi lai roi cho bi do vao, nau 7-8 phut den khi bi chin mem.",
      "tip": "MAU THUAN thoi gian: bepmina.vn nau bi 7-8 phut; saigonesebaguette.vn nau 15-20 phut. Voi mieng bi cat vua an, 7-8 phut la du chin mem ma khong nat — kiem tra bang dua: xien thay mem la duoc.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 8,
      "instruction": "Nem muoi, hat nem va tieu xay vua an.",
      "tip": "Nem nem truoc khi cho rau thom vao; vi tom va bi da ngot san nen nem nhe tay."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho hanh la (va ngo ri neu dung) vao noi, tat bep ngay. Muc canh ra to, an nong voi com.",
      "tip": "Cho hanh la vao cuoi cung roi tat bep ngay de hanh giu mau xanh va mui thom."
    }
  ],
