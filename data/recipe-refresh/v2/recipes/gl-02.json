  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Giã tiêu Tứ Xuyên thành bột (dùng cối chày hoặc máy xay), giữ riêng khoảng 1/4 muỗng cà phê để rắc lên mặt cuối cùng.",
      "tip": "WOL lưu ý: chỉ giã phần vỏ, bỏ hạt đen bên trong vì hạt gây đắng; tiêu xay cháy sẽ đắng nên khi xào phải rất cẩn thận."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp thịt băm với muối và một nhúm tiêu trắng xay (theo CSF), trộn đều, để riêng."
    },
    {
      "stepNumber": 3,
      "instruction": "Cắt đậu phụ thành khối vuông khoảng 2cm, cố gắng cắt đều tay.",
      "tip": "Đừng đảo nhiều khi nấu — đậu non rất dễ vỡ; dùng lưng thìa đẩy nhẹ."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun sôi một nồi nước lớn, cho một nhúm muối, nhẹ nhàng thả đậu phụ vào chần 1-2 phút rồi vớt ra để ráo.",
      "tip": "CSF: chần giúp khử mùi đậu nành sống và giúp đậu chắc hơn, ít vỡ khi nấu.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "(Tùy chọn, theo WOL) Làm dầu ớt: đun nhỏ lửa dầu ăn, cho ớt khô và ớt tươi vào, đảo thỉnh thoảng khoảng 5 phút cho thơm, tuyệt đối không để cháy; tắt bếp để riêng.",
      "tip": "Có dầu ớt làm sẵn thì bỏ qua bước này.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Đun nóng wok/chảo với khoảng 2 muỗng canh dầu; cho thịt băm vào xào đến khi săn và hơi giòn cạnh, vớt thịt ra, giữ lại dầu trong chảo.",
      "tip": "CSF: xào thịt trước rồi vớt ra — thịt giữ được độ giòn, cho lại vào sau.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Thêm 1 muỗng canh dầu, cho doubanjiang (đã băm nhuyễn) vào xào lửa nhỏ khoảng 1 phút đến khi dầu chuyển màu đỏ; cho đậu tương đen lên men, tỏi, gừng, phần trắng hành lá vào đảo 30 giây cho thơm.",
      "tip": "CSF: doubanjiang phải xào đến khi dầu đỏ mới đúng vị 'mapo'; bột ớt (nếu dùng) cho vào cuối vì dễ cháy.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Cho bột tiêu Tứ Xuyên vào đảo 15-30 giây cho thơm.",
      "tip": "WOL: tiêu cháy sẽ đắng — cách an toàn là cho tiêu vào sau khi thịt đã chín, không xào quá lâu."
    },
    {
      "stepNumber": 9,
      "instruction": "Đổ nước dùng gà vào, nêm xì dầu và đường; cho một nửa lượng thịt băm đã xào vào, đun sôi rồi hạ lửa nhỏ om 2-3 phút.",
      "tip": "CSF: cho nửa thịt vào om trước để nước dùng ngấm vị thịt.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Nhẹ nhàng cho đậu phụ vào, om lửa nhỏ 6-8 phút cho đậu ngấm gia vị.",
      "tip": "Không đảo mạnh; om càng lâu đậu càng thấm gia vị (CSF).",
      "timerMinutes": 7
    },
    {
      "stepNumber": 11,
      "instruction": "Hòa bột bắp với nước; khuấy lại rồi đổ một nửa vào nồi đang sôi nhẹ, đẩy nhẹ đậu phụ, chờ 30 giây rồi đổ nốt; nêm thử, thêm muối nếu cần; cho nốt nửa thịt còn lại vào cho giòn, rưới dầu mè, trộn đều.",
      "tip": "CSF: chia nước bột làm 2 lần để sốt sánh đều, bám đẹp.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 12,
      "instruction": "Khi sốt đã sánh và bám hết vào miếng đậu thì dọn ra đĩa sâu lòng, rắc bột tiêu Tứ Xuyên giữ riêng và phần xanh hành lá (hoặc hành tỏi) lên mặt; ăn nóng với cơm trắng.",
      "tip": "WOL: sau khi bày ra, nếu thấy chưa đủ tê có thể rắc thêm tiêu trực tiếp."
    }
  ],
