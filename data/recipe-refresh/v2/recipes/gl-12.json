  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Rửa sạch cà chua: 3 quả cắt múi cau, 1 quả thái hạt lựu; hành lá thái nhỏ; gừng thái lát mỏng.",
      "tip": "daigasikfaan: cà chua thái hạt lựu giúp ra nước nhanh, tạo phần sốt sánh."
    },
    {
      "stepNumber": 2,
      "instruction": "Đập 3 quả trứng vào tô, thêm một ít sữa đặc (khoảng 1 muỗng canh), đánh đều.",
      "tip": "Mẹo của daigasikfaan: sữa đặc giúp trứng có kết cấu mềm mượt, béo nhẹ hơn."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng chảo với một ít dầu ăn trên lửa vừa-cao."
    },
    {
      "stepNumber": 4,
      "instruction": "Đổ trứng vào chảo, xào nhanh đến khi vừa đông lại thì xúc ra để riêng.",
      "tip": "Không xào trứng quá kỹ — trứng bị dai, khô (daigasikfaan).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thêm một chút dầu vào chảo, cho gừng lát vào phi thơm 1–2 phút.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cà chua múi cau vào xào 3–4 phút, sau đó thêm cà chua thái hạt lựu; nấu thêm vài phút đến khi cà chua mềm, ra nước.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm vào chảo: tương cà, nước tương nhạt, nước tương sò, đường và tiêu trắng; đảo đều cho gia vị hòa quyện.",
      "tip": "Đây là bước tạo vị mặn-ngọt đặc trưng của bản có nước tương (khác với gl-03 dùng rượu Thiệu Hưng + dầu mè)."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho trứng đã xào trở lại chảo, trộn đều cho sốt bám quanh từng miếng trứng."
    },
    {
      "stepNumber": 9,
      "instruction": "Nếm và điều chỉnh vị mặn-ngọt cho vừa khẩu vị."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc hành lá thái nhỏ lên trên, dọn nóng với cơm trắng."
    }
  ],
