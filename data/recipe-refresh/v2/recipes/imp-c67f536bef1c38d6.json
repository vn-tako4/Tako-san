  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Bắp cải tách từng lá, cắt miếng vừa ăn; ngâm vào nước muối loãng, rửa lại nước sạch, để ráo.",
      "tip": "nhaxinhplaza: ngâm nước muối loãng giúp bắp cải sạch và giòn.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Nấm đùi gà cắt bỏ những chỗ hư, thâm đen; ngâm nước muối loãng khoảng 10 phút, vớt ra rửa lại bằng nước lạnh, để ráo rồi cắt lát hoặc khúc vừa ăn.",
      "tip": "DMX (củ cải kho): không rửa nấm quá lâu, nấm thấm nước sẽ mất ngọt.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Cà rốt gọt vỏ, cắt miếng vừa ăn (tỉa hoa nếu thích); đậu phụ chiên cắt miếng nhỏ vừa ăn; hành boa rô băm nhỏ; hành lá cắt nhỏ.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc nồi lên bếp, cho 1 muỗng canh dầu ăn, phi thơm hành boa rô băm.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nấm đùi gà vào xào săn trước khoảng 2 phút cho dậy mùi thơm.",
      "tip": "nhaxinhplaza/cholaithieu: xào nấm trước rồi mới cho bắp cải vào, nấm thấm gia vị và không ra nước làm nhạt món kho.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho bắp cải, cà rốt, đậu phụ chiên vào nồi; nêm 3 muỗng canh nước tương, 1 muỗng canh đường, 1 muỗng cà phê hạt nêm chay, 1/4 muỗng cà phê muối; thêm 200 ml nước, đảo đều cho gia vị tan.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Đậy nắp, kho lửa vừa khoảng 20 phút cho các nguyên liệu thấm vị và nước kho sệt lại; nêm nếm lại cho vừa khẩu vị rồi tắt bếp.",
      "tip": "cholaithieu: trong quá trình kho hạn chế dùng đũa đảo nhiều để tránh nát nguyên liệu — cầm quai nồi lắc nhẹ thay vì đảo.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 8,
      "instruction": "Múc bắp cải kho nấm ra đĩa, rắc tiêu xay và hành lá lên trên; dọn ăn nóng với cơm trắng.",
      "tip": "nhaxinhplaza: món kho đạt là bắp cải mềm thấm vị, nấm ngọt, nước kho sệt đậm đà, rất đưa cơm."
    }
