  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế nấm kim châm: cắt bỏ phần gốc, tách nấm thành từng sợi nhỏ, rửa sạch dưới vòi nước, ngâm nước muối pha loãng 10 phút rồi vớt ra để ráo.",
      "tip": "toyenxin (bài 2): ngâm nước muối loãng giúp nấm sạch và bớt mùi hăng; chỉ ngâm khi sắp chế biến, nấm ngâm lâu bị nhũn và nhạt.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế các nguyên liệu còn lại: cà chua rửa sạch, bổ múi cau; hành tím và tỏi bóc vỏ, băm nhỏ; hành lá rửa sạch, thái nhỏ; trứng gà đập ra bát, thêm chút nước mắm, đánh tan đều.",
      "tip": "Đánh trứng tan kỹ trước giúp khi rót vào canh tạo vân mỏng đẹp, không bị vón cục (ehosital).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Phi thơm: bắc nồi lên bếp, cho 1 muỗng canh dầu ăn vào đun nóng, cho hành tím và tỏi băm vào phi đến khi vàng thơm.",
      "tip": "MÂU THUẪN NHỎ: toyenxin (bài 1) phi tỏi + hành tây; ehosital phi đầu hành lá. Lấy cách phi hành tím + tỏi — nền thơm phổ biến nhất cho canh trứng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 4,
      "instruction": "Xào cà chua: cho cà chua đã bổ múi cau vào, đảo đều đến khi cà chua chín mềm, ra màu đỏ đẹp.",
      "tip": "ehosital: xào cà chua chín mềm trước rồi mới đổ nước giúp nước canh có màu đẹp tự nhiên, không cần màu thực phẩm.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 5,
      "instruction": "Chế nước: đổ 1,2 lít nước lọc vào nồi, đun sôi.",
      "tip": "Nếu có sẵn nước dùng gà hoặc nước luộc rau củ, có thể thay nước lọc để canh ngọt hơn (ehosital).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Nấu nấm: khi nước sôi, cho nấm kim châm vào, nấu khoảng 4 phút cho nấm chín.",
      "tip": "MÂU THUẪN NGUỒN: ehosital nấu nấm 2-3 phút; toyenxin (bài 1) nấu khoảng 5 phút. Lấy 4 phút — nấm chín mà vẫn giữ độ giòn sựt đặc trưng, không bị nhũn.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 7,
      "instruction": "Tạo vân trứng: hạ nhỏ lửa, từ từ rót trứng đã đánh tan vào nồi, vừa rót vừa khuấy nhẹ theo vòng tròn để trứng tạo thành những vân mỏng đẹp mắt.",
      "tip": "toyenxin (bài 1) và ehosital: rót trứng khi lửa nhỏ và khuấy nhẹ theo một chiều — trứng sẽ thành sợi vân mịn thay vì vón cục.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm nếm: cho muối, hạt nêm, nước mắm vào, khuấy đều, nếm lại cho vừa ăn rồi thêm tiêu xay.",
      "tip": "Nêm sau khi cho trứng để vị chuẩn xác nhất, vì trứng làm vị canh nhạt đi đôi chút.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Đun thêm 1-2 phút cho trứng chín hẳn rồi tắt bếp.",
      "tip": "toyenxin (bài 1): KHÔNG đun quá lâu sau khi cho trứng — trứng sẽ bị cứng, mất vân đẹp và mất vị béo.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 10,
