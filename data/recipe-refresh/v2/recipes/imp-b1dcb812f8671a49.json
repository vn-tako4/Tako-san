  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Hành lá rửa sạch, cắt nhỏ cho vào chén. Đun nóng 1 muỗng canh dầu ăn cho sôi lăn tăn rồi rưới vào chén hành, trộn đều làm mỡ hành.",
      "tip": "Cách làm mỡ hành của Helen's Recipes: đổ dầu nóng trực tiếp vào hành lá cắt nhỏ."
    },
    {
      "stepNumber": 2,
      "instruction": "Xúc xích thái lát mỏng (nếu dùng). Phô mai mozzarella bào sợi hoặc thái lát mỏng. Ớt hiểm thái lát mỏng."
    },
    {
      "stepNumber": 3,
      "instruction": "Đặt chảo chống dính lên bếp, để lửa nhỏ đến vừa, cho chảo nóng khô rồi đặt 1 cái bánh tráng vào.",
      "tip": "Không cho dầu vào chảo — bánh tráng nướng trên chảo khô mới giòn (cooky.vn)."
    },
    {
      "stepNumber": 4,
      "instruction": "Đập 1 quả trứng gà lên mặt bánh tráng, dùng mặt dưới của muỗng dàn trứng đều khắp bề mặt bánh.",
      "tip": "Dàn nhanh tay khi chảo còn chưa quá nóng để trứng phủ đều, không vón cục (Helen's Recipes)."
    },
    {
      "stepNumber": 5,
      "instruction": "Rưới đều mỡ hành lên trên lớp trứng."
    },
    {
      "stepNumber": 6,
      "instruction": "Xếp xúc xích thái lát lên mặt bánh, rắc đều phô mai mozzarella."
    },
    {
      "stepNumber": 7,
      "instruction": "Nướng trên lửa nhỏ, thỉnh thoảng xoay bánh bằng kẹp cho chín đều, đến khi trứng chín, phô mai chảy ra và đáy bánh vàng giòn.",
      "tip": "Xoay bánh liên tục để không bị cháy một chỗ (Helen's Recipes).",
      "timerMinutes": 4
    },
    {
      "stepNumber": 8,
      "instruction": "Rắc ớt hiểm thái lát và hành tím phi (nếu dùng) lên mặt bánh."
    },
    {
      "stepNumber": 9,
      "instruction": "Gấp đôi miếng bánh tráng lại như quesadilla hoặc cắt thành miếng như pizza.",
      "tip": "Helen's Recipes: gấp đôi hoặc cắt lát tùy thích."
    },
    {
      "stepNumber": 10,
      "instruction": "Lấy bánh ra đĩa, lặp lại với 2 cái bánh còn lại. Dọn và ăn ngay khi còn nóng giòn.",
      "tip": "Bánh tráng nướng phải ăn nóng mới giòn — để nguội sẽ bị mềm, dai."
    }
  ],
