  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế: hành tây băm nhỏ; tỏi, gừng, sả băm nhuyễn; cà rốt thái hạt lựu hoặc lát mỏng; bắp cải thái sợi; hành lá cắt khúc; ớt jalapeño thái lát; chanh vắt lấy nước cốt; ngò rí băm nhỏ.",
      "tip": "Bắp cải thái sợi đều để chín cùng lúc; sả chỉ lấy phần non băm thật nhỏ kẻo xơ.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Đặt nồi lớn (hoặc nồi gang) lên bếp lửa vừa. Cho thịt bò xay vào, dùng muỗng dằm tơi, xào đến khi thịt nâu vàng đều.",
      "tip": "Xào thịt đến vàng nâu để tạo vị đậm đà cho nước dùng; gạn bớt mỡ thừa nếu thịt ra nhiều mỡ.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 3,
      "instruction": "Cho hành tây băm và tỏi băm vào nồi, đảo đều, xào 2–3 phút đến khi hành mềm và thơm.",
      "tip": "Không để tỏi cháy kẻo nước dùng bị đắng.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Cho gừng băm, sả băm, cà rốt, ớt jalapeño, nước mắm, dầu mè, nước dùng bò, nước tương và đường nâu vào nồi. Khuấy đều.",
      "tip": "Cho sả và gừng vào lúc này để tinh dầu thơm ngấm dần vào nước dùng trong quá trình hầm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Đun sôi rồi hạ nhỏ lửa, hầm liu riu 20–25 phút đến khi cà rốt mềm.",
      "tip": "Hớt bọt nếu có để nước canh trong. Nếm thử: vị mặn của nước mắm, ngọt nhẹ của đường nâu, thơm của sả gừng.",
      "timerMinutes": 22
    },
    {
      "stepNumber": 6,
      "instruction": "Cho bắp cải thái sợi, hành lá cắt khúc và nước cốt chanh vào nồi. Đun thêm 5–10 phút đến khi bắp cải vừa mềm.",
      "tip": "Cho bắp cải vào sau để giữ độ giòn ngọt; nước cốt chanh cho vào cuối để giữ vị chua tươi.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 7,
      "instruction": "Nếm lại và điều chỉnh: thêm nước mắm nếu nhạt, thêm chanh nếu muốn chua hơn, bớt ớt nếu cay quá.",
      "tip": "Nguồn lưu ý: nước mắm có thể là vị lạ với một số người và món có thể cay — gia giảm theo khẩu vị gia đình.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Tắt bếp, cho ngò rí băm vào khuấy đều. Múc canh ra bát, dùng nóng.",
      "tip": "Ngò rí cho vào sau khi tắt bếp để giữ hương thơm tươi. Món ăn ấm bụng, giàu đạm và chất xơ — hợp cho bữa tối se lạnh."
    }
  ],
