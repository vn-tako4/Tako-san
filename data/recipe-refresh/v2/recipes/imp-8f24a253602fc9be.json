  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá: cạo vảy, bỏ ruột, rửa sơ. Dùng muối hạt và gừng cắt lát chà xát khắp thân và bụng cá khoảng 5 phút để khử mùi tanh, rửa lại thật sạch, cắt khúc vừa ăn.",
      "tip": "FPT: chà muối + gừng 5 phút là bước khử tanh quan trọng nhất với cá nước ngọt.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp cá: cho cá vào tô, ướp với 1/2 lượng tỏi băm, 2 muỗng cà phê hạt nêm, 1 muỗng cà phê đường và vài lát ớt; trộn đều, để 10–15 phút cho ngấm.",
      "tip": "FPT ướp cá 10 phút với tỏi phi, hạt nêm, đường, ớt cắt lát.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế rau củ: dứa gọt vỏ, bỏ mắt, cắt miếng nhỏ; cà chua bổ múi cau; sả đập dập, cắt khúc 5 cm; chanh vắt lấy nước cốt; ớt cắt lát; hành tím, tỏi, gừng băm nhỏ.",
      "tip": "FPT: dứa cắt miếng tam giác nhỏ, cà chua thái múi cau — miếng nhỏ giúp nhanh ra vị chua."
    },
    {
      "stepNumber": 4,
      "instruction": "Nhặt rửa các loại rau nhúng, để ráo. Nấm đùi gà cắt chân, rửa nhanh, thái lát. Hành lá, ngò gai, rau ngổ cắt khúc ngắn."
    },
    {
      "stepNumber": 5,
      "instruction": "Phi thơm: đun nóng dầu ăn, cho hành tím, tỏi băm và sả đập dập vào phi thơm. Cho cà chua và dứa vào xào 2–3 phút đến khi cà chua mềm, ra màu.",
      "tip": "FPT + Lorca: xào cà chua, dứa với dầu cho săn và dậy mùi trước khi đổ nước — nước lẩu sẽ thơm và có màu đẹp.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ 2 lít nước vào nồi, đun sôi. Vắt nước cốt chanh vào nồi, hạ lửa vừa, đun liu riu khoảng 10 phút cho cà chua và dứa tiết vị chua ngọt tự nhiên.",
      "tip": "Lorca đun nhỏ lửa 30 phút để cà chua, dứa ra hết vị chua; với 5 người và cá cắt khúc, 10 phút là đủ rồi thả cá — tránh đun quá lâu làm nước đục.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 7,
      "instruction": "Nêm nước lẩu: 2 muỗng canh đường, 1 muỗng canh hạt nêm, 1 muỗng cà phê muối, 2–3 muỗng canh nước mắm và 1 muỗng canh sa tế (tùy độ cay). Khuấy đều, nếm lại cho vừa vị chua – mặn – ngọt.",
      "tip": "FPT nêm: 2 muỗng canh đường, 1 muỗng canh hạt nêm, 1 muỗng cà phê muối, 2 muỗng canh sa tế; Lorca nêm sa tế, nước mắm, đường phèn cho vừa miệng."
    },
    {
      "stepNumber": 8,
      "instruction": "Thả cá đã ướp vào nồi nước đang sôi, đun 5–7 phút đến khi cá chín. Không đảo mạnh tay để cá không bị nát.",
      "tip": "FPT: thả cá khi nước sôi lần nữa, đun khoảng 5 phút — cá diêu hồng chín nhanh, đun lâu thịt bở.",
      "timerMinutes": 7
    },
    {
      "stepNumber": 9,
      "instruction": "Thả nấm đùi gà thái lát vào, đun thêm 3 phút cho nấm vừa chín tới.",
      "tip": "Nấm đùi gà chín nhanh; đun quá lâu nấm ra nước, mất giòn.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Tắt bếp hoặc hạ lửa liu riu; rắc hành lá, ngò gai, rau ngổ cắt khúc, mè rang và ớt lát lên trên.",
      "tip": "Lorca: rắc mè rang vàng và vài lát ớt khi hoàn thiện cho thơm."
    },
    {
      "stepNumber": 11,
      "instruction": "Dọn nồi lẩu ra bàn, giữ sôi liu riu trên bếp cồn/bếp từ trong lúc ăn."
    },
    {
      "stepNumber": 12,
      "instruction": "Khi ăn: nhúng rau và nấm vào nồi lẩu đang sôi, ăn kèm bún tươi; thịt cá chấm nước mắm dầm ớt.",
      "tip": "FPT + Lorca: món này ăn nóng với bún tươi, chấm nước mắm ớt là đúng vị."
    }
  ],
