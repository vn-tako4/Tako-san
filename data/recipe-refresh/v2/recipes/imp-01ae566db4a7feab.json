  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thấm khô thịt bò bằng khăn giấy, thái lát mỏng 2–3 mm, thái ngang thớ thịt để thịt mềm.",
      "tip": "Thịt bò thái ngang thớ sẽ không bị dai khi nấu nhanh (food.com)."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp thịt bò với 15 g xì dầu, dầu mè và một nửa lượng tiêu trắng; để 15 phút cho thấm.",
      "tip": "Không ướp muối vào thịt lúc này để thịt không bị ra nước.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Nấm đùi gà rửa sạch, cắt bỏ phần gốc già, thái lát dọc dày khoảng 0,5 cm."
    },
    {
      "stepNumber": 4,
      "instruction": "Gừng thái lát, tỏi băm nhỏ, hành lá cắt khúc 3–4 cm; phần gốc hành trắng đập dập để riêng."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun sôi 1,2 lít nước trong nồi; cho gừng, gốc hành trắng và tỏi vào, đun 5 phút cho nước thơm.",
      "tip": "Vớt bỏ gừng và gốc hành sau bước này nếu muốn nước canh trong.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Cho thịt bò vào nồi nước đang sôi, đun 2–3 phút, vớt bọt để nước trong.",
      "tip": "simplechinesefood.com ninh thịt bò miếng to 2–2,5 giờ cho mềm rục; công thức này theo food.com dùng thịt thái lát nấu nhanh ~2 phút để giữ độ mềm ngọt.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho nấm đùi gà vào, nấu thêm 8–10 phút đến khi nấm chín mềm, ngấm vị.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm phần xì dầu còn lại, muối và tiêu trắng còn lại cho vừa miệng."
    },
    {
      "stepNumber": 9,
      "instruction": "(Tùy chọn, kiểu West Lake) Pha 10 g bột bắp với 3 muỗng canh nước lạnh, rót từ từ vào nồi vừa khuấy để tạo độ sánh nhẹ.",
      "tip": "wokyourworld.com (West Lake beef soup) làm sánh bằng bột bắp; nếu thích canh trong thì bỏ qua bước này."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc hành lá, múc canh ra tô, dùng ngay khi còn nóng."
    }
  ],
