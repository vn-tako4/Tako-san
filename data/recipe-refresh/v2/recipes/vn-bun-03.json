  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế xương và giò heo: rửa sạch với muối hạt, chần qua nước sôi 3-5 phút cho ra hết bọt bẩn, vớt ra rửa lại dưới vòi nước lạnh.",
      "tip": "Phunutoday: chần kỹ giúp nước dùng trong, không bị hôi.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Ninh nước dùng: cho xương ống và giò heo vào nồi với khoảng 3 lít nước, thêm 3-4 cây sả đập dập và 1 củ gừng đập dập. Đun sôi rồi hạ lửa vừa, thường xuyên hớt bọt cho nước trong.",
      "tip": "Sau khoảng 1 giờ vớt giò heo ra ngâm ngay vào thau nước đá cho giò giòn, săn (Helen's); tiếp tục ninh xương thêm 1-2 giờ cho ngọt nước.",
      "timerMinutes": 150
    },
    {
      "stepNumber": 3,
      "instruction": "Luộc bắp bò: đun nồi nước riêng với sả, hành tím và gừng; cho bắp bò vào luộc chín tới, vớt ra để nguội hoàn toàn rồi thái lát mỏng vừa ăn.",
      "tip": "Phunutoday: thái khi thịt nguội giúp lát thịt đẹp, không nát.",
      "timerMinutes": 40
    },
    {
      "stepNumber": 4,
      "instruction": "Làm sa tế ớt: đun nóng dầu ăn với dầu màu điều, phi thơm hành tím, tỏi và sả băm đến vàng; cho ớt bột vào đảo nhanh tay, thêm nước mắm và đường, đun 2 phút đến khi hỗn hợp hơi sệt.",
      "tip": "Helen's: đảo nhanh và hạ lửa nhỏ khi cho ớt bột để ớt không cháy đắng; phunutoday cũng lưu ý đảo đều nhanh tay.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 5,
      "instruction": "Xử lý mắm ruốc: hòa mắm ruốc với khoảng 200 ml nước lạnh, khuấy đều, để lắng rồi gạn lấy phần nước trong cho vào nồi nước dùng, bỏ phần cặn.",
      "tip": "Helen's: chỉ lấy nước trong để nước dùng thơm mà không bị sạn, không tanh."
    },
    {
      "stepNumber": 6,
      "instruction": "Luộc chả cua và huyết: khi nước dùng đang sôi, dùng lòng muỗng canh phết chả cua thành từng viên thả vào nồi, chả chín nổi lên thì vớt ra; huyết heo cắt miếng vừa ăn, luộc chín kỹ.",
      "tip": "Helen's: phết chả cua bằng muỗng cho viên tròn đều; phunutoday: huyết luộc lại cho chín kỹ trước khi thái miếng.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 7,
      "instruction": "Hoàn thiện nước dùng: cho khoảng 2/3 phần sa tế vào nồi (giữ 1/3 để ăn kèm), thả thêm 2 cây sả đập dập; nêm nước mắm, muối, đường phèn, hạt nêm vừa miệng.",
      "tip": "Helen's: đập dập thêm sả bỏ vào nồi ở cuối để tăng hương; nêm nếm lại bằng hạt nêm và nước mắm.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Trụng bún: bún tươi chần nhanh qua nước sôi cho sạch và dai sợi, vớt ra để ráo.",
      "tip": "Phunutoday: chần bún giúp sợi bún sạch và giữ độ dai."
    },
    {
      "stepNumber": 9,
      "instruction": "Lên tô: cho bún vào tô, xếp lên trên bắp bò thái lát, khoanh giò heo, chả cua, huyết; chan nước dùng thật nóng ngập mặt bún.",
      "tip": "Xếp thịt đẹp mắt trước khi chan nước dùng (phunutoday)."
    },
    {
      "stepNumber": 10,
      "instruction": "Hoàn thiện và thưởng thức: rắc hành tây thái mỏng, hành lá và rau mùi lên trên; dọn kèm rau muống bào, hoa chuối, giá, rau thơm, chanh, ớt và chén sa tế còn lại. Ăn ngay khi nóng.",
      "tip": "Bún bò Huế chuẩn vị nổi bật hương sả và ruốc, nước dùng cay nồng (phunutoday)."
    }
  ],
