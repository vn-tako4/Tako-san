  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá hồi: rửa sạch, thấm thật khô bằng khăn giấy, cắt miếng vừa ăn (mỗi miếng ~80 g). Ướp với 1/4 muỗng cà phê muối và một chút tiêu đen, để 10 phút cho thấm.",
      "tip": "oishi-kenko: ướp muối tiêu trước khi áo bột giúp cá đậm vị; thấm khô để khi áp chảo không bị bắn dầu.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Cà chua khía chữ thập ở đáy quả, chần nước sôi 30 giây rồi vớt ra bóc vỏ, bỏ hạt, thái hạt lựu.",
      "tip": "Mizkan gợi ý dùng cà chua hộp cắt hạt lựu cho tiện; dùng cà chua tươi thì chần bóc vỏ để sốt mịn, không lợn cợn vỏ."
    },
    {
      "stepNumber": 3,
      "instruction": "Hành tây thái múi cau mỏng; tỏi băm nhỏ; nấm hương thái lát; hành lá thái khúc khoảng 3 cm."
    },
    {
      "stepNumber": 4,
      "instruction": "Áo đều các miếng cá hồi qua bột mì, giũ nhẹ cho rơi bớt bột thừa — chỉ cần một lớp mỏng.",
      "tip": "oishi-kenko: lớp bột mỏng giúp cá không nát khi om và sốt bám tốt hơn."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng một nửa lượng dầu ô liu trong chảo, cho cá vào áp chảo mỗi mặt khoảng 2 phút cho vàng nhẹ rồi gắp ra đĩa.",
      "tip": "oishi-kenko áp chảo lửa vừa; không chiên kỹ vì cá còn om tiếp sẽ bị khô, bở.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 6,
      "instruction": "Dùng chính chảo đó, thêm nốt dầu còn lại, phi tỏi lửa nhỏ cho thơm (cẩn thận không để cháy), cho hành tây và nấm hương vào xào đến khi hành trong, nấm mềm.",
      "tip": "oishi-kenko: xào rau củ trước để dậy mùi ngọt tự nhiên rồi mới cho cà chua.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
