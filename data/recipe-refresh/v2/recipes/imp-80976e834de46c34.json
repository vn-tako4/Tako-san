  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Nấm hương khô ngâm nước ấm 2-3 giờ cho nở mềm. Vắt ráo, cắt bỏ chân cứng, thái sợi. Thái thịt bò thành lát mỏng dài khoảng 5 cm.",
      "tip": "Maangchi: ngâm nấm trước khi bắt đầu các bước khác."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp thịt bò và nấm hương với 1 tép tỏi băm, 1 muỗng cà phê đường, 1/4 muỗng cà phê tiêu xay, 2 muỗng cà phê xì dầu và 1 muỗng cà phê dầu mè. Để trong tủ lạnh khi chuẩn bị các nguyên liệu khác."
    },
    {
      "stepNumber": 3,
      "instruction": "Làm trứng trang trí (jidan): tách lòng đỏ, đánh đều với một nhúm muối. Tráng mỏng trên chảo chống dính với 1 muỗng cà phê dầu ăn, lật mặt, để nguội rồi thái thành sợi mỏng.",
      "tip": "Maangchi: chỉ dùng lòng đỏ để trứng trang trí có màu vàng đẹp."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nồi nước lớn cho sôi, thêm nhúm muối. Trần rau bina 30 giây đến 1 phút, vớt ra xả ngay dưới vòi nước lạnh cho nguội. Vắt ráo nước, cắt ngắn rồi trộn với 1 muỗng cà phê xì dầu và 1 muỗng cà phê dầu mè.",
      "tip": "Maangchi: vắt thật ráo để mì không bị nhão nước.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Dùng lại nồi nước đó luộc mì dangmyeon: đậy nắp đun 1 phút, mở nắp đảo đều, nấu thêm 7 phút đến khi mì mềm dai. Vớt ra, cắt ngắn bằng kéo, trộn ngay với 2 muỗng cà phê dầu mè, 1 muỗng cà phê xì dầu và 1 muỗng cà phê đường cho mì khỏi dính.",
      "tip": "Maangchi: không luộc quá lâu, mì dangmyeon dễ bị nhũn.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 6,
      "instruction": "Đun nóng chảo với 2 muỗng cà phê dầu ăn, xào hành tây và hành lá với một nhúm muối khoảng 2 phút đến khi hơi trong. Trút vào tô mì đã trộn.",
      "tip": "Maangchi: xào riêng từng loại rau để mỗi loại giữ được độ giòn và hương vị riêng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Thêm 2 muỗng cà phê dầu ăn vào chảo, xào nấm đùi gà với một nhúm muối khoảng 2 phút đến khi nấm mềm và thơm. Trút vào tô mì.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Thêm 1 muỗng cà phê dầu ăn, xào nhanh cà rốt khoảng 20 giây rồi cho ớt chuông đỏ vào xào thêm 20 giây. Trút vào tô mì.",
      "tip": "Maangchi: cà rốt và ớt chuông chỉ xào sơ để giữ độ giòn."
    },
    {
      "stepNumber": 9,
      "instruction": "Thêm 2 muỗng cà phê dầu ăn, cho hỗn hợp thịt bò và nấm hương đã ướp vào xào đến khi thịt hết màu đỏ và nấm bóng mềm, khoảng 2-3 phút. Trút vào tô mì.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Cho vào tô lớn: mì, rau bina và tất cả rau thịt đã xào. Thêm 1 tép tỏi băm, 1 muỗng canh xì dầu, 1 muỗng canh đường, 1/2 muỗng cà phê tiêu xay và 2 muỗng cà phê dầu mè. Trộn thật đều tay.",
      "tip": "Maangchi: trộn bằng tay (đeo găng) hoặc đũa lớn cho gia vị thấm đều vào mì."
    },
    {
      "stepNumber": 11,
      "instruction": "Thêm trứng thái sợi và hạt mè rang vào, trộn nhẹ lần cuối rồi dọn ra đĩa lớn."
    },
    {
      "stepNumber": 12,
      "instruction": "Japchae ăn nóng hoặc để nguội đều ngon. Phần thừa bảo quản trong tủ lạnh được 3 ngày.",
      "tip": "Mẹo bảo quản của Maangchi (easy-japchae)."
    }
  ],
