  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thịt bò thái lát mỏng khoảng 3 mm, ngang thớ thịt. Kim chi cắt miếng vừa ăn; hành tây thái múi cau; hành lá cắt khúc 3 cm; tỏi băm nhỏ.",
      "tip": "Thái ngang thớ giúp thịt bò xào không bị dai."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp thịt bò với 1 tép tỏi băm, 1 tsp xì dầu, đường, hạt nêm, tiêu xay và 1 tsp dầu ăn. Trộn đều, để 15-20 phút cho thấm.",
      "tip": "Dầu ăn trong nước ướp giúp thịt mềm và không ra nước khi xào (theo Mytour).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Đun chảo lớn trên lửa to với 1 tbsp dầu ăn đến khi dầu thật nóng. Cho phần tỏi băm còn lại vào phi thơm khoảng 20 giây.",
      "tip": "Chảo phải thật nóng thì thịt mới săn nhanh, không bị dai."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho thịt bò đã ướp vào, xào nhanh tay trên lửa lớn 1-2 phút đến khi thịt vừa tái thì trút ngay ra đĩa.",
      "tip": "Xào thịt riêng trước để thịt chín đều, giữ được độ mềm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Dùng lại chảo đó, cho kim chi vào xào khoảng 2 phút cho kim chi săn lại, dậy mùi thơm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho thịt bò trở lại chảo cùng hành tây. Nêm 1 tbsp xì dầu, mật ong và dầu hào; đảo đều 2-3 phút cho thịt và kim chi thấm gia vị, hành tây vừa chín tới.",
      "tip": "Nêm nhạt tay vì kim chi, xì dầu và dầu hào đều đã mặn.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho hành lá vào đảo nhanh 30 giây, rưới dầu mè lên trên rồi tắt bếp."
    },
    {
      "stepNumber": 8,
      "instruction": "Trút ra đĩa, rắc vừng rang lên trên nếu thích. Dọn nóng, ăn kèm cơm trắng.",
      "tip": "Món ngon nhất khi ăn ngay lúc còn nóng hổi."
