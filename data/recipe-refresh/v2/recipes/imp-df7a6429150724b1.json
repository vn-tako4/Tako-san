  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Tôm bóc vỏ, bỏ đầu (có thể giữ lại đuôi cho đẹp), khứa dọc lưng lấy bỏ chỉ đen, rửa sạch rồi thấm thật khô bằng khăn giấy.",
      "tip": "Thấm khô tôm giúp khi om không ra nhiều nước, sốt cà chua đậm đà hơn."
    },
    {
      "stepNumber": 2,
      "instruction": "Cà chua rửa sạch, bỏ cuống, cắt miếng vừa ăn. Hành tây bóc vỏ, thái lát mỏng. Tỏi băm nhỏ. Hành lá thái khoanh để riêng.",
      "tip": "cookpad: cà chua cắt miếng vừa ăn (一口大), hành tây thái lát mỏng để nhanh mềm khi om."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng dầu ô liu trong nồi hoặc chảo sâu lòng, cho tỏi băm vào phi thơm trên lửa vừa, không để tỏi cháy.",
      "tip": "Tỏi cháy sẽ đắng và làm hỏng mùi sốt — thấy vừa vàng thơm là cho nguyên liệu tiếp theo ngay."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho tôm vào đảo nhanh đến khi chuyển màu hồng (khoảng 1–2 phút), gắp tôm ra đĩa riêng.",
      "tip": "cookpad cho hải sản vào om cùng rau củ ngay từ đầu; nhưng tôm chín rất nhanh — xào sơ rồi lấy ra trước giúp tôm không bị dai, bở khi om lâu (kỹ thuật này cũng được JOC dùng trong món ebi-chili).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Vẫn chảo đó, cho hành tây vào xào trên lửa vừa đến khi mềm, trong suốt (khoảng 3 phút).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cà chua, xì dầu, ketchup, đường, sake, muối và 100 ml nước vào; đảo đều, đun sôi rồi hạ xuống lửa nhỏ.",
      "tip": "Bộ gia vị xì dầu + ketchup + sake + đường theo Kaneko — đây là cách nêm sốt cà chua cho tôm kiểu Nhật (khác với cookpad chỉ dùng muối + sake)."
    },
    {
      "stepNumber": 7,
      "instruction": "Đậy nắp, om lửa nhỏ 5–7 phút đến khi cà chua mềm nhừ, sốt hơi sánh lại.",
