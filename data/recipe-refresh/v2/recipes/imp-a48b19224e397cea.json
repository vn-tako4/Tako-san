  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Vo gạo, nấu cơm cho chín dẻo và giữ nóng đến khi dọn."
    },
    {
      "stepNumber": 2,
      "instruction": "Hành tây thái lát mỏng; hành lá thái khoanh mỏng; gừng gọt vỏ, nạo nhuyễn."
    },
    {
      "stepNumber": 3,
      "instruction": "Nếu lát thịt bò quá to, cắt thành miếng vừa ăn.",
      "tip": "SK: cho thịt vào ngăn đá khoảng 10 phút cho hơi cứng sẽ dễ cắt lát mỏng hơn."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho hành tây, dashi, sake, xì dầu và đường vào nồi hoặc chảo sâu lòng cỡ vừa, đun sôi lửa vừa."
    },
    {
      "stepNumber": 5,
      "instruction": "Nấu hành tây trong nước dùng khoảng 5 phút cho mềm, đảo thỉnh thoảng.",
      "tip": "SK: nấu hành trước cho mềm và ngấm vị, tránh nấu thịt quá lâu làm thịt dai.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Cho thịt bò vào, đảo đều, nấu đến khi thịt chín tới và nước sốt cạn sánh lại thành nước dùng đậm vị, khoảng 5 phút.",
      "tip": "SK: không nấu thịt quá kỹ — thịt thái mỏng rất nhanh chín, đun lâu sẽ bị dai.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Cho gừng nạo vào, đun thêm 1 phút. Nếm và nêm thêm muối, đường cho vừa miệng.",
      "tip": "SK: cho gừng vào sau cùng để giữ hương thơm tươi của gừng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Xới cơm nóng ra 2 tô."
    },
    {
      "stepNumber": 9,
      "instruction": "Gắp hỗn hợp thịt bò và hành tây đặt lên mặt cơm, rưới nước sốt trong nồi lên trên.",
      "tip": "SK: đừng rưới quá nhiều sốt kẻo cơm bị nhão."
    },
    {
      "stepNumber": 10,
      "instruction": "Trang trí hành lá thái khoanh và gừng đỏ muối lên trên; nếu dùng trứng thì đặt trứng chần lên mỗi tô. Dọn nóng và ăn ngay.",
      "tip": "SK gợi ý thêm trứng chần (optional) và ớt bột togarashi nếu thích."
    }
  ],
