  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Vo gạo tẻ cho sạch, để ráo rồi cho vào chảo rang sơ trên lửa vừa đến khi hạt gạo se khô và dậy mùi thơm.",
      "tip": "ECOMUSHROOMS: rang sơ giúp cháo thơm và hạt gạo không bị nát khi ninh.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Cho gạo đã rang và khoảng 1.5 lít nước vào nồi, đun sôi rồi hạ lửa nhỏ ninh đến khi gạo nở nhừ thành cháo.",
      "tip": "Thỉnh thoảng khuấy để cháo không bén đáy nồi.",
      "timerMinutes": 40
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế tôm: rửa sạch, bóc vỏ, bỏ đầu, rút chỉ đen ở lưng, để ráo rồi ướp nhẹ với một ít muối và tiêu xay khoảng 10 phút.",
      "tip": "ECOMUSHROOMS: chọn tôm tươi sống, thịt chắc, vỏ bóng.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Sơ chế nấm đùi gà: rửa sạch, ngâm nước muối loãng khoảng 5 phút, vớt ra để ráo rồi thái lát vừa ăn.",
      "tip": "Không ngâm nấm quá lâu sẽ làm nấm ngấm nước, mất vị ngọt.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 5,
      "instruction": "Hành tím bóc vỏ, băm nhỏ. Gừng cạo vỏ, thái sợi. Hành lá và ngò rí rửa sạch, cắt nhỏ."
    },
    {
      "stepNumber": 6,
      "instruction": "Bắc chảo lên bếp, cho 1 muỗng canh dầu ăn vào đun nóng, phi thơm hành tím băm rồi cho tôm vào xào nhanh đến khi thịt tôm săn lại.",
      "tip": "ECOMUSHROOMS: xào săn để tôm giữ được độ ngọt; không xào quá chín vì tôm còn nấu tiếp trong cháo.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
