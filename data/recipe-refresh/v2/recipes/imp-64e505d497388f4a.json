  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Rửa cá hồi với nước muối loãng rồi rửa lại nước sạch; dùng giấy ăn thấm thật khô. Cắt thành 3 miếng (~250 g/miếng); nếu miếng quá lớn nên giữ miếng dày để thịt không bị khô khi áp chảo (dienmayxanh, KingFoodMart).",
      "tip": "KingFoodMart: bề mặt cá càng khô thì áp chảo càng dễ tạo màu vàng đẹp."
    },
    {
      "stepNumber": 2,
      "instruction": "Tỏi và hành tím bóc vỏ, băm nhỏ; ớt rửa sạch thái nhỏ; chanh vắt lấy nước cốt; hành lá thái nhỏ để riêng."
    },
    {
      "stepNumber": 3,
      "instruction": "Ướp cá: xát đều 7 g muối, 4 g tiêu đen và 30 ml nước cốt chanh khắp hai mặt miếng cá; để yên 10–15 phút cho thấm (KingFoodMart; dienmayxanh ướp tương tự nhưng không nêu thời gian).",
      "tip": "KingFoodMart: xoa nhẹ để gia vị thấm vào thịt cá.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc chảo chống dính lên bếp, cho 1.5 muỗng canh dầu ăn đun nóng; đặt mặt da cá hồi xuống chảo trước (nếu còn da), áp chảo mỗi mặt 3 phút cho vàng giòn, hạn chế di chuyển miếng cá (dienmayxanh, KingFoodMart).",
      "tip": "KingFoodMart: giữ nguyên miếng cá vài phút để lớp da vàng giòn và không dính chảo.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 5,
      "instruction": "Lấy chảo khác, cho 15 g bơ lạt vào đun chảy; cho tỏi băm, hành tím băm, ớt băm vào đảo đều đến khi thơm và hơi vàng. Thêm 3 muỗng canh nước mắm và 20 ml nước cốt chanh còn lại, đảo đều (dienmayxanh).",
      "tip": "KingFoodMart: thêm vài lát chanh vàng vào chảo cùng bơ tỏi để tăng mùi thơm."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cá hồi đã áp chảo vào chảo sốt bơ tỏi chanh, đảo đều các mặt để sốt ngấm vào cá (dienmayxanh).",
      "tip": "KingFoodMart: dùng thìa rưới phần bơ tỏi nóng lên mặt cá 1–2 phút giúp cá bóng đẹp, thịt giữ độ mọng; tránh nấu quá lâu vì cá hồi rất dễ bị khô.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Tắt bếp, gắp cá ra đĩa, để nghỉ khoảng 1 phút; rưới phần sốt còn lại trong chảo lên mặt cá (KingFoodMart).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Rắc hành lá thái nhỏ và một chút tiêu đen xay lên trên; trang trí vài lát chanh. Ăn ngay khi còn nóng với cơm nóng hoặc salad (dienmayxanh, KingFoodMart).",
      "tip": "dienmayxanh gợi ý salad cà chua 75 g ăn kèm để cân bằng vị béo của cá."
    }
  ],
