  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau củ ninh nước dùng: cà rốt, củ cải trắng gọt vỏ, rửa sạch, cắt khúc 2–3 cm. Hành lá rửa sạch, để ráo.",
      "tip": "NEWSUN: cắt khúc ngắn 2–3 cm để rau củ nhanh ra nước ngọt."
    },
    {
      "stepNumber": 2,
      "instruction": "Nướng hành tây và gừng: hành tây bổ đôi, gừng cắt lát dày; nướng trực tiếp trên bếp hoặc lò đến khi vỏ cháy xém, dậy mùi thơm. Rửa sơ qua nước ấm, cạo bỏ phần cháy đen.",
      "tip": "Helen: nướng cháy xém rồi rửa qua nước ấm, cạo bỏ phần cháy để nước dùng thơm mà không đắng.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Ninh nước dùng: cho 3 lít nước vào nồi lớn cùng cà rốt, củ cải trắng, hành tây và gừng đã nướng. Đun sôi rồi hạ lửa vừa, ninh 45–60 phút cho rau củ ra hết nước ngọt.",
      "tip": "Helen ninh 30 phút với 4 L nước; NEWSUN ninh 1 tiếng và liên tục hớt bọt để nước trong, không mùi hôi — lấy mức giữa 45–60 phút, nhớ hớt bọt thường xuyên.",
      "timerMinutes": 50
    },
    {
      "stepNumber": 4,
      "instruction": "Rang bộ gia vị phở: cho hoa hồi, quế thanh, thảo quả vào chảo khô rang 2–3 phút đến thơm. Cho vào túi vải lọc, thả vào nồi nước dùng 10 phút cuối.",
      "tip": "Helen: rang gia vị cho cháy xém nhẹ rồi cho vào túi lọc — nước dùng thơm mùi phở đặc trưng mà không bị lợn cợn.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 5,
      "instruction": "Vớt bỏ toàn bộ rau củ đã ninh và túi gia vị ra khỏi nồi, giữ lại phần nước dùng trong.",
      "tip": "NEWSUN: vớt hết rau củ sau khi ninh để nước dùng trong, ngọt thanh."
    },
    {
      "stepNumber": 6,
      "instruction": "Sơ chế phần đạm: đậu phụ cắt miếng vừa ăn; nấm đùi gà cắt bỏ chân, rửa nhanh qua nước, thái lát dày khoảng 0,5 cm.",
      "tip": "Không ngâm nấm lâu trong nước — nấm hút nước sẽ nhạt và nhũn khi xào."
    },
    {
      "stepNumber": 7,
      "instruction": "Chiên đậu phụ: đun nóng dầu ăn đến già, cho đậu phụ vào chiên vàng đều các mặt rồi vớt ra để ráo dầu.",
      "tip": "NEWSUN: chiên đến khi đậu vàng đều thì vớt ra — đậu chiên trước sẽ dai ngon, không bị nát khi cho vào nước dùng.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 8,
      "instruction": "Xào nấm và đậu: phi thơm đầu hành lá (hoặc hành boa-rô) với chút dầu, cho nấm đùi gà vào xào 3 phút. Cho đậu phụ chiên vào, nêm xì dầu, chút muối, đường, hạt nêm chay và bột ngũ vị hương; xào thêm 5 phút cho thấm.",
      "tip": "Helen ướp phần đạm với muối, đường, bột nêm chay, đầu boa-rô băm và ngũ vị hương; NEWSUN xào nấm 3 phút rồi cho đậu vào xào thêm 5 phút.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 9,
      "instruction": "Nêm nước dùng: nêm muối, đường phèn và hạt nêm chay cho vừa ăn. Cho toàn bộ phần nấm đậu đã xào vào nồi, đun sôi trở lại 5 phút rồi tắt bếp.",
      "tip": "NEWSUN: sau khi nêm gia vị phở thì cho nguyên liệu đã xào vào, đun sôi đều rồi tắt bếp — không đun lâu kẻo nấm nhũn.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 10,
      "instruction": "Chần bánh phở và giá: trụng bánh phở qua nước sôi, xả lại nước lạnh rồi xả nhanh qua nước nóng một lần cho sợi ráo, không đóng bánh. Giá đỗ trụng sơ qua nước sôi.",
      "tip": "Helen: xả lạnh rồi xả nóng giúp sợi phở ráo và tơi, không bị dính chùm.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 11,
      "instruction": "Chia bánh phở ra 4 tô, xếp giá trụng và phần nấm đậu xào lên trên, rắc hành lá và ngò gai cắt nhỏ."
    },
    {
      "stepNumber": 12,
      "instruction": "Chan nước dùng đang sôi ngập mặt phở. Dọn ngay khi còn nóng, ăn kèm húng quế, chanh tươi, tương đen và tương ớt.",
      "tip": "Phở phải ăn ngay khi chan nước sôi — để lâu sợi phở nở sẽ mất ngon."
    }
  ],
