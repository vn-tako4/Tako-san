  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế thịt bò: bóp thịt với muối và rượu trắng khoảng 15 phút để khử mùi, sau đó rửa sạch nhiều lần với nước và để ráo. Cắt thịt thành miếng vừa ăn (khối vuông, không quá nhỏ).",
      "tip": "pharmacity.vn: cắt miếng vừa ăn giúp thịt nhanh thấm gia vị.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế rau củ: cà rốt gọt vỏ, rửa sạch, cắt khúc vừa ăn. Sả rửa sạch, cắt lát mỏng. Gừng gọt vỏ, băm nhỏ. Hành tím, tỏi bóc vỏ, băm nhỏ. Hành tây bóc vỏ, để nguyên củ. Cà chua rửa sạch, cắt múi cau. Húng quế, ngò gai nhặt rửa sạch, để ráo.",
      "tip": "pharmacity.vn: chia sả, gừng, hành tím băm làm hai phần — một nửa để ướp, một nửa để phi thơm."
    },
    {
      "stepNumber": 3,
      "instruction": "Ướp thịt bò: trộn đều thịt với gói sốt gia vị bò kho, 1,5 muỗng canh đường, 1 muỗng canh nước mắm, bột ngọt, tiêu và một nửa lượng sả, gừng, hành tím băm. Cho vào tủ lạnh ướp ít nhất 4 tiếng hoặc qua đêm cho thấm.",
      "tip": "pharmacity.vn: ướp tối thiểu 4 tiếng hoặc qua đêm để gia vị thấm sâu, thịt thơm ngon hơn.",
      "timerMinutes": 240
    },
    {
      "stepNumber": 4,
      "instruction": "Thắng dầu điều: đặt nồi lên bếp, cho 2 muỗng canh dầu ăn vào đun nóng, cho dầu điều vào đảo đều lửa vừa đến khi dầu chuyển màu vàng cam thì vớt hạt điều ra, giữ lại phần dầu màu.",
      "tip": "pharmacity.vn: dầu điều giúp nước bò kho có màu vàng cam đẹp mắt."
    },
    {
      "stepNumber": 5,
      "instruction": "Phi thơm phần sả, hành tím, gừng, tỏi băm còn lại trong dầu điều. Cho thịt bò đã ướp vào xào lửa vừa khoảng 5 phút đến khi thịt săn lại.",
      "tip": "vnexpress.net: chỉ xào sơ cho thịt săn và chín bề mặt là được, không xào kỹ.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ 1,5 lít nước dừa tươi vào nồi, thả nguyên củ hành tây vào. Đậy nắp, hầm lửa vừa khoảng 40 phút đến khi thịt chín mềm.",
      "tip": "pharmacity.vn: hầm lửa vừa-nhỏ để thịt mềm mà không bị dai; có thể dùng nồi áp suất để rút ngắn thời gian.",
      "timerMinutes": 40
    },
    {
      "stepNumber": 7,
      "instruction": "Vớt củ hành tây ra khỏi nồi. Cho cà rốt và cà chua vào, nêm 1 muỗng cà phê hạt nêm, 1 muỗng canh nước mắm và 1 muỗng canh đường. Tiếp tục hầm khoảng 10 phút cho cà rốt chín mềm.",
      "tip": "vnexpress.net: cho cà rốt vào hầm chín trong khoảng 20 phút (tùy kích thước miếng cắt).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Hòa tan 2 muỗng canh bột năng với 200 ml nước lọc. Đổ từ từ vào nồi đang sôi, vừa đổ vừa khuấy đều đến khi nước dùng sánh mịn. Nêm nếm lại cho vừa ăn rồi tắt bếp.",
      "tip": "pharmacity.vn: cho bột năng vào khi gần hoàn thành để nước sánh mịn nhưng không quá đặc."
    },
    {
      "stepNumber": 9,
      "instruction": "Múc bò kho ra bát, trang trí húng quế, ngò gai và vài lát ớt tươi. Dùng nóng với bánh mì giòn.",
      "tip": "vnexpress.net: có thể chấm thêm muối tiêu chanh nếu thích. pharmacity.vn: bảo quản ngăn mát tủ lạnh 2-3 ngày, hâm nóng trước khi ăn."
    }
  ],
