  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Luộc trứng gà trong nước sôi khoảng 8–10 phút cho chín, vớt ra ngâm nước lạnh rồi bóc vỏ.",
      "tip": "Bóc vỏ dưới vòi nước lạnh giúp vỏ bong dễ hơn.",
      "timerMinutes": 9
    },
    {
      "stepNumber": 2,
      "instruction": "Rửa sạch thịt ba chỉ, chần nhanh qua nước sôi để loại bỏ mùi hôi và bọt bẩn, rồi cắt thành miếng vuông vừa ăn.",
      "tip": "Phunutoday: chần qua nước sôi trước khi cắt và ướp; memart: ngâm nước muối loãng 5 phút cũng được.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Ướp thịt với 1 thìa nước mắm, 1 thìa đường, 1 thìa hạt nêm, tiêu xay, hành tím và tỏi băm nhuyễn trong 30 phút cho thấm gia vị.",
      "tip": "Phunutoday: ướp đủ 30 phút là bước then chốt để thịt đậm đà.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 4,
      "instruction": "Thắng nước màu: cho 1–2 thìa đường vào chảo với chút dầu, đun lửa nhỏ đến khi đường tan và chuyển màu nâu cánh gián, thêm một chút nước sôi vào khuấy đều.",
      "tip": "Phunutoday: đun lửa nhỏ, khuấy liên tục để đường không cháy đắng.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 5,
      "instruction": "Phi thơm phần hành tím, tỏi băm còn lại với một ít dầu ăn, cho thịt đã ướp vào đảo đều cho săn lại.",
      "tip": "Xào săn giúp thịt thấm màu và không bị nát khi kho lâu.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ nước dừa tươi vào nồi sao cho ngập mặt thịt, thêm nước màu, đun lửa lớn cho sôi rồi hớt bọt để nước kho trong.",
      "tip": "Phunutoday: hớt bọt ngay khi sôi giúp nước kho trong, đẹp màu.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 7,
      "instruction": "Hạ lửa nhỏ, đậy hé nắp, kho liu riu khoảng 1–1,5 giờ cho đến khi thịt mềm và nước kho sệt lại.",
      "tip": "Phunutoday: kho 1–1,5 giờ cho thịt rệu; không khuấy nhiều để tránh nát thịt và trứng. (Memart biến thể nhanh chỉ kho 20–30 phút — mâu thuẫn về thời gian, lấy theo phunutoday cho biến thể nước dừa truyền thống.)",
      "timerMinutes": 75
    },
    {
      "stepNumber": 8,
      "instruction": "Cho trứng đã luộc vào kho cùng thịt, tiếp tục kho thêm 15–20 phút cho trứng thấm gia vị.",
      "tip": "Memart: có thể dùng tăm châm vài lỗ nhỏ trên trứng để gia vị thấm đều hơn; có thể chiên sơ trứng trước (phunutoday) để trứng săn, không nát.",
      "timerMinutes": 18
    },
    {
      "stepNumber": 9,
      "instruction": "Nêm nếm lại gia vị cho vừa miệng (thêm nước mắm hoặc đường nếu cần), tắt bếp và rắc tiêu xay cùng hành lá cắt nhỏ lên trên.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Múc ra đĩa, dùng nóng với cơm trắng và dưa chua.",
      "tip": "Phunutoday: ăn kèm cơm trắng và dưa chua là chuẩn vị."
    }
  ],
