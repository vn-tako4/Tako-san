  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Băm nhỏ thịt gà bằng dao hoặc máy xay thực phẩm (hoặc dùng gà xay sẵn). Tỏi bóc vỏ băm nhỏ; ớt hiểm băm nhỏ; ớt sừng thái lát (nếu dùng); đậu que thái khúc nhỏ (nếu dùng).",
      "tip": "HIT: giã tỏi + ớt bằng cối chày thành hỗn hợp lợn cợn để dậy mùi tinh dầu."
    },
    {
      "stepNumber": 2,
      "instruction": "Nhặt lấy lá húng quế khỏi cọng, rửa sạch, để ráo. Nấu cơm trắng trước để sẵn.",
      "tip": "RCT: tách lá khỏi cọng cứng; cơm nên nấu xong trước vì món xào chỉ mất vài phút."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng wok/chảo lớn ở lửa vừa-cao, cho 2 muỗng canh dầu ăn. Cho tỏi và ớt hiểm vào phi đến khi tỏi vàng thơm.",
      "tip": "RCT: phi đến khi tỏi vàng nâu; cẩn thận hơi ớt cay nồng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 4,
      "instruction": "Cho thịt gà xay vào chảo, dùng xạn dằm tơi các cục thịt, xào đến khi thịt gần chín (khoảng 80%).",
      "tip": "HIT: đừng xào quá kỹ ở bước này — thịt sẽ chín tiếp khi nêm sốt.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Nêm vào chảo: 1.5 muỗng canh dầu hào, 1 muỗng canh xì dầu Thái, 1 muỗng cà phê hắc xì dầu, 1 muỗng canh nước mắm và 2 muỗng cà phê đường. Đảo đều cho sốt bám đều thịt, xào thêm khoảng 1 phút.",
      "tip": "HIT: đảo đến khi sốt sánh lại, bám vào thịt. RCT: nếm thử ở bước này và chỉnh mặn-ngọt cho vừa.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Cho đậu que và ớt sừng vào (nếu dùng), xào thêm 1-2 phút đến khi đậu vừa chín tới, còn hơi giòn.",
      "tip": "RCT: rau chỉ xào vừa chín tới, giữ độ giòn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "TẮT BẾP, nhấc chảo khỏi lửa, cho lá húng quế vào đảo nhanh đến khi vừa héo thì múc ra ngay.",
      "tip": "Cả hai nguồn đều nhấn mạnh: húng quế chỉ cần hơi nóng còn lại làm héo trong ~10-30 giây; xào quá sẽ đắng và mất mùi.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Chảo sạch khác: cho 3 muỗng canh dầu ăn, đun lửa lớn cho dầu thật nóng già, đập từng quả trứng vào chiên đến khi viền giòn rụm, lòng đỏ còn lòng đào thì vớt ra.",
      "tip": "RCT: dầu phải thật nóng trước khi đập trứng — đó là bí quyết trứng ốp la kiểu Thái viền ren giòn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Xới cơm trắng ra đĩa, múc gà xào húng quế để cạnh cơm, đặt trứng ốp la lên trên. Dọn kèm chén nước mắm ớt (prik nam pla) và vài lát dưa leo.",
      "tip": "RCT: ăn đúng kiểu Thái — chọc vỡ lòng đỏ trứng, rưới một ít prik nam pla vào để chấm."
    }
