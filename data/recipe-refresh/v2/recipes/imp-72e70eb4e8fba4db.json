  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: bóc vỏ, bỏ chỉ lưng, rửa sạch rồi thấm thật khô bằng khăn giấy.",
      "tip": "Tôm thấm khô thì áp chảo mới vàng mặt, không bị ra nước và dai."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp tôm với tỏi băm, gừng nạo và nước kim chi, trộn đều, để trong tủ lạnh 30 phút.",
      "tip": "Nguồn 1 ướp 30 phút cho tôm thấm vị chua cay. Nếu vội, có thể bỏ qua bước ướp và xào trực tiếp như nguồn 2.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế rau củ: kim chi cắt miếng vừa ăn; bắp cải thảo bào sợi; ớt chuông đỏ thái sợi; hành lá thái khúc 3–4 cm."
    },
    {
      "stepNumber": 4,
      "instruction": "Làm nóng chảo lớn hoặc wok trên lửa vừa, cho bơ vào đun chảy hoàn toàn."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho tôm đã ướp vào chảo, áp chảo khoảng 2 phút mỗi mặt đến khi tôm chuyển màu hồng, thịt đục (không còn trong). Gắp tôm ra đĩa riêng, giữ lại phần bơ trong chảo.",
      "tip": "Nguồn 1: vớt tôm ra trước để tôm không bị nấu quá chín và dai khi xào rau.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 6,
      "instruction": "Vẫn chảo đó, thêm dầu ăn, tăng lên lửa vừa–cao. Cho bắp cải thảo và ớt chuông vào xào 2–3 phút đến khi rau vừa chín tới, còn giữ độ giòn.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho kim chi và xì dầu vào chảo, đảo đều thêm 1 phút cho kim chi nóng thấm rồi tắt bếp.",
      "tip": "Nguồn 1: chỉ xào kim chi 1 phút ở cuối để kim chi không bị nát và giữ vị chua cay.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Cho tôm đã áp chảo trở lại chảo, đảo nhanh tay cho tôm quyện đều với rau và kim chi."
    },
    {
      "stepNumber": 9,
      "instruction": "Rưới dầu mè lên khắp chảo, đảo đều lần cuối.",
      "tip": "Nguồn 2: cho dầu mè khi đã tắt bếp để giữ mùi thơm, dầu mè đun lâu dễ đắng."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn ra đĩa, rắc hành lá và vừng rang lên trên. Ăn ngay khi còn nóng với cơm trắng.",
      "tip": "Nguồn 1: món ăn ngon nhất khi vừa nấu xong; có thể vắt thêm lát chanh nếu thích (nguồn 1 gợi ý dùng kèm)."
    }
  ],
