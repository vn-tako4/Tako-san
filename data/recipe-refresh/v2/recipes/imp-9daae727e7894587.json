  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế đùi gà: rửa sạch với nước muối loãng để khử mùi, chặt thành miếng vừa ăn, để ráo.",
      "tip": "Nguồn B gợi ý rửa gà với muối (có thể thêm vài lát gừng) để thịt thơm và nước canh trong."
    },
    {
      "stepNumber": 2,
      "instruction": "Ướp gà với hành tím băm, 1/2 muỗng cà phê hạt nêm, gừng thái chỉ và một ít tiêu xay, trộn đều, để 20-30 phút cho thấm.",
      "tip": "Nguồn A ướp đủ 30 phút — thịt gà đậm đà hơn hẳn so với nấu ngay.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 3,
      "instruction": "Bắp cải bỏ cuống cứng và lá ngoài dập, tách lá rửa sạch, thái miếng vừa ăn, để ráo. Cà rốt gọt vỏ, rửa sạch, cắt lát hoặc tỉa hoa dày vừa."
    },
    {
      "stepNumber": 4,
      "instruction": "Hành lá rửa sạch, cắt nhỏ phần lá để rắc; giữ phần đầu hành trắng để phi thơm cùng hành tím."
    },
    {
      "stepNumber": 5,
      "instruction": "Bắc nồi lên bếp, cho 1 muỗng canh dầu ăn vào đun nóng, phi thơm hành tím và đầu hành trắng đến khi vàng nhẹ, dậy mùi.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
