  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cắt bỏ phần cùi bắp cải, thái bắp cải thành những sợi nhỏ hoặc miếng vừa ăn. Rửa sạch nhiều lần với nước, để ráo hoàn toàn.",
      "tip": "Chọn bắp cải có màu xanh nhạt, lá bện và cuốn chắc vào nhau, đầu bắp cải dày khép kín; không mua bắp cải lá vàng hoặc cuống đã nâu (tiphay.vn).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 2,
      "instruction": "Rửa sạch hành lá, ngò rí; cắt phần đầu hành lá để riêng, phần lá còn lại và ngò rí cắt nhỏ. Ớt rửa sạch, thái lát nhỏ. Hành tím (nếu dùng) bóc vỏ, băm nhuyễn.",
      "tip": "Giữ phần đầu hành để phi thơm — đây là bí quyết tạo mùi thơm cho nước canh (tiphay.vn).",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Đập 4 quả trứng gà vào chén, dùng đũa hoặc phới đánh tan đều cả lòng đỏ và lòng trắng.",
      "tip": "Đánh trứng kỹ để sợi trứng mịn và đều khi đổ vào nồi.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc nồi lên bếp, cho 2 muỗng cà phê dầu ăn vào. Khi dầu nóng, cho phần đầu hành đã đập dập (hoặc hành tím băm) vào phi thơm.",
      "tip": "Phi vừa thơm vàng, không để hành cháy sẽ đắng nước canh.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ 1.2 lít nước lọc vào nồi, nêm 2 muỗng cà phê muối, 2 muỗng cà phê bột ngọt, 4 muỗng cà phê đường và 2 muỗng cà phê hạt nêm. Đun sôi khoảng 5 phút cho gia vị tan hoàn toàn và nước dùng đậm đà.",
      "tip": "Trong lúc đun, hớt bọt nếu có để nước canh trong.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Khi nước sôi mạnh, từ từ đổ trứng đã đánh tan vào nồi, đồng thời dùng đũa khuấy nhẹ nhàng theo một chiều để trứng tạo thành những sợi mỏng đẹp mắt, không bị vón cục. Chờ trứng nổi lên và chín đều.",
      "tip": "Bí quyết sợi trứng đẹp: đổ trứng khi nước đang sôi mạnh và khuấy nhẹ một chiều; tránh khuấy quá mạnh sẽ làm trứng nát (saigonesebaguette.vn). Có thể dùng rây lọc để đổ trứng qua, sợi trứng sẽ mảnh và đều hơn.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Cho toàn bộ bắp cải vào nồi, đảo đều, nấu thêm 1–2 phút cho bắp cải vừa chín tới.",
      "tip": "Không nấu bắp cải quá lâu — bắp cải chín tới giữ độ giòn ngọt và màu xanh đẹp (saigonesebaguette.vn).",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Cho 2 muỗng canh nước mắm vào nồi, khuấy đều. Nếm lại và điều chỉnh gia vị cho vừa miệng.",
      "tip": "Nêm nước mắm ở bước cuối để giữ hương thơm; nước mắm đun lâu sẽ mất mùi.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, múc canh ra tô. Rắc hành lá, ngò rí đã cắt nhỏ, vài lát ớt và một ít tiêu xay lên mặt. Dùng nóng với cơm.",
      "tip": "Món canh hoàn thành có màu sắc đẹp mắt: sợi trứng vàng óng, bắp cải xanh tươi; nước dùng ngọt thanh, vị bắp cải giòn giòn và vị mềm thơm của trứng."
    }
  ],
