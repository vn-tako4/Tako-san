  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Đậu hũ cắt miếng vuông khoảng 2 cm, thao tác nhẹ tay để không vỡ. Nấm đùi gà thái sợi nhỏ, cà rốt thái sợi mỏng.",
      "tip": "thewoksoflife.com và theseasonedwok.com dùng nấm khô (nấm hương, mộc nhĩ, kim châm) ngâm mềm; công thức này dùng nấm đùi gà tươi cho tiện."
    },
    {
      "stepNumber": 2,
      "instruction": "Ớt hiểm thái lát mỏng, hành lá cắt nhỏ, gừng thái sợi, tỏi băm. Trứng gà đập ra bát, đánh tan."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha 20 g bột bắp với 60 ml nước lạnh, khuấy tan, để riêng."
    },
    {
      "stepNumber": 4,
      "instruction": "Trộn hỗn hợp gia vị: giấm đen, nước tương, đường, muối và tiêu trắng; khuấy cho đường muối tan.",
      "tip": "theseasonedwok.com cho giấm vào gần cuối để giữ vị chua thơm; thewoksoflife.com dùng giấm trắng chưng cất — công thức này chọn giấm đen theo trường phái Tứ Xuyên."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun sôi nước dùng gà, cho gừng và tỏi vào nấu 2 phút cho thơm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho cà rốt và nấm đùi gà vào, nấu 5 phút cho rau chín tới.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Cho đậu hũ vào nồi thật nhẹ tay, nấu thêm 3 phút, không khuấy mạnh để đậu không vỡ.",
      "tip": "Công thức này dùng đậu hũ cứng theo gợi ý món; theseasonedwok.com dùng đậu hũ mềm.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Khuấy đều chén bột bắp rồi rót từ từ vào nồi, vừa rót vừa khuấy nhẹ đến khi canh hơi sánh."
    },
    {
      "stepNumber": 9,
      "instruction": "Để canh sôi bùng lên, rót trứng đánh tan thành dòng mỏng, vừa rót vừa khuấy tròn để tạo vân trứng.",
      "tip": "thewoksoflife.com nhấn mạnh: canh phải đang sôi mạnh (bubbling) mới cho trứng vào thì vân trứng mới đẹp, không bị vón."
    },
    {
      "stepNumber": 10,
      "instruction": "Tắt bếp, cho ngay hỗn hợp giấm-gia vị vào, khuấy đều.",
      "tip": "Cho giấm sau khi tắt bếp giúp giữ mùi thơm chua đặc trưng; đun lâu giấm sẽ bay mùi."
    },
    {
      "stepNumber": 11,
      "instruction": "Thêm dầu mè và ớt hiểm, nếm lại cho cân bằng ba vị chua – cay – mặn, điều chỉnh giấm hoặc tiêu tùy khẩu vị.",
      "tip": "thewoksoflife.com: vị cay chủ yếu từ tiêu trắng, vị chua từ giấm — tăng giảm hai gia vị này tùy thích."
    },
    {
      "stepNumber": 12,
      "instruction": "Rắc hành lá, múc ra tô, dùng nóng."
    }
  ],
