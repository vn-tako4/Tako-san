  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế sườn: chặt miếng vừa ăn, rửa với nước muối loãng. Chần sườn qua nước sôi 2–3 phút cho ra bọt bẩn, vớt ra rửa lại nước sạch, để ráo.",
      "tip": "Chần sườn giúp nước kho trong, không bị hôi — cả hai nguồn đều làm bước này.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 2,
      "instruction": "Luộc trứng cút 8 phút tính từ lúc nước sôi; vớt ra ngâm ngay vào nước lạnh 5 phút cho dễ bóc vỏ, bóc sạch vỏ để riêng.",
      "tip": "Ngâm nước lạnh ngay sau khi luộc giúp trứng không bị thâm quầng lòng đỏ.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 3,
      "instruction": "Hành tím, tỏi bóc vỏ băm nhuyễn; ớt hiểm thái lát hoặc băm nhỏ tùy độ cay muốn ăn."
    },
    {
      "stepNumber": 4,
      "instruction": "Ướp sườn với hành tỏi ớt băm, nước mắm, đường, muối, tiêu và nước màu; trộn đều, để 30 phút cho sườn ngấm gia vị.",
      "tip": "Điện Máy Xanh ướp 30 phút; Top Việt Food ướp 15 phút — ướp lâu hơn giúp sườn đậm đà hơn.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng dầu ăn trong nồi/chảo sâu lòng, cho sườn đã ướp vào xào săn trên lửa vừa khoảng 2 phút.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Thêm trứng cút và ớt trái vào nồi, đảo nhẹ tay khoảng 5 phút cho trứng thấm đều gia vị.",
      "tip": "Đảo nhẹ để trứng không bị vỡ nát.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Đổ nước dừa vào ngập mặt sườn, đun sôi rồi hạ xuống lửa nhỏ.",
      "tip": "Top Việt Food lưu ý kho nhỏ lửa để sườn mềm và nước sánh dần."
    },
    {
      "stepNumber": 8,
      "instruction": "Kho liu riu khoảng 30 phút, thỉnh thoảng trở mặt sườn và trứng cho thấm đều.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 9,
      "instruction": "Mở nắp, tăng lên lửa vừa, kho thêm đến khi nước sánh, còn khoảng 1/3, sườn mềm và lên màu nâu đỏ đẹp. Nêm nếm lại mặn-ngọt cho vừa miệng.",
      "tip": "Không kho cạn quá — phần nước kho sánh dùng chan cơm rất ngon."
    },
    {
      "stepNumber": 10,
      "instruction": "Tắt bếp, rắc tiêu xay, múc sườn và trứng ra đĩa sâu lòng, dùng nóng với cơm trắng."
    }
  ],
