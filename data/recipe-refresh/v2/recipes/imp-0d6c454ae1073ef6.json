  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Chọn 3 quả su su non: dùng tay bấm thử thấy mềm, vỏ bóng mỡ, có nhiều gai, còn tươi, không bầm dập, ít khía trên thân để dễ gọt.",
      "tip": "dienmayxanh: quả già sơ cứng khó ăn; nên chọn quả ít khía để thuận tiện sơ chế."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho su su vào thau nước, dùng dao bào gọt bỏ lớp vỏ ngoài (gọt trong nước hoặc đeo bao tay để tránh mủ su su dính tay).",
      "tip": "dienmayxanh: gọt trong nước tránh mủ dính tay; loại sạch hết vỏ để su su không bị đắng khi ăn.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Chẻ đôi quả su su theo chiều dọc, moi bỏ hạt và phần cùi trắng bên trong, rửa sạch lại với nước.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 4,
      "instruction": "Cắt su su thành miếng vừa ăn (miếng dài nhỏ, rộng khoảng 1⁄2 lóng tay) để nhanh chín và dễ thấm nước rưới.",
      "tip": "dienmayxanh (bản luộc): cắt xéo miếng 1⁄2 lóng tay — áp dụng tương tự cho bản hấp.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Tỏi bóc vỏ, đập dập (không băm nhuyễn). Hành lá rửa sạch, thái nhỏ để riêng.",
      "tip": "xaydungso: tỏi đập dập để khi pha nước rưới thơm mà không hăng.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Đun sôi nước trong nồi hấp/xửng. Xếp su su vào xửng, đậy nắp, hấp đến khi chín tới, khoảng 10-12 phút.",
      "tip": "xaydungso: 'đun sôi nước trong nồi hấp, cho su su vào hấp chín'. Không hấp quá lâu để su su giữ độ giòn ngọt.",
      "timerMinutes": 11
    },
    {
      "stepNumber": 7,
      "instruction": "Trong lúc chờ hấp, pha nước rưới: 1 muỗng canh nước mắm + tỏi đập dập + 1 muỗng canh dầu ăn + 1⁄2 muỗng cà phê muối, khuấy đều.",
      "tip": "xaydungso: 'pha nước mắm với tỏi và dầu ăn, rưới lên su su trước khi dùng'. Có thể thay nước mắm bằng xì dầu theo gợi ý món."
    },
    {
      "stepNumber": 8,
      "instruction": "Su su chín thì gắp ra đĩa, rưới đều nước mắm tỏi lên trên, rắc hành lá thái nhỏ. Dọn nóng, dùng với cơm."
    }
  ],
