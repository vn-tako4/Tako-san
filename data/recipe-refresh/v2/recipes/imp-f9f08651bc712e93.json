  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá: rửa cá với nước muối loãng (hoặc dùng chanh và muối chà xát) cho hết nhớt, khử tanh, rửa lại nước lạnh rồi thấm thật khô. Phi lê cá, thái thành miếng dày khoảng 1,5 cm vừa ăn.",
      "tip": "pasgo dặn giữ lại phần mỡ cá để rán lấy mỡ xào chả cá ở bước sau. xaydungso (bài cá lăng): dùng chanh và muối chà xát giúp cá không bị nhớt.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Lọc mẻ: cho cơm mẻ qua rây, chỉ lấy phần nước mịn để ướp (bỏ bã).",
      "tip": "pasgo: 'đem 4 thìa mẻ mọc lấy phần nước mịn' — bã mẻ lợn cợn sẽ làm cá bị chua gắt và mất đẹp."
    },
    {
      "stepNumber": 3,
      "instruction": "Ướp cá: cho cá vào tô lớn, thêm riềng băm, nước mẻ, mắm tôm, bột nghệ, đường, nước mắm, muối, tiêu, tỏi băm, hành tím băm (và sả nếu dùng). Trộn đều nhẹ tay cho gia vị bám đều từng miếng cá."
    },
    {
      "stepNumber": 4,
      "instruction": "Bọc kín tô cá, để ngăn mát tủ lạnh ít nhất 30 phút cho thấm (pasgo), hoặc 1 tiếng nếu có thời gian (xaydungso).",
      "tip": "Cá thái dày 1,5 cm nên ướp tối thiểu 30 phút; ướp lâu hơn trong tủ lạnh giúp cá đậm đà hơn.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 5,
      "instruction": "Trong lúc chờ cá thấm: thì là và hành lá rửa sạch — phần củ trắng chẻ mỏng, lá xanh cắt khúc 3–5 cm (pasgo). Đậu phộng rang giã dập. Bún chần qua nước sôi nếu cần, để ráo."
    },
    {
      "stepNumber": 6,
      "instruction": "Nướng cá: xếp cá lên vỉ, nướng trên bếp than hồng cho cháy xém vàng đều 2 mặt (pasgo); nếu dùng lò nướng thì 200–250°C trong 15–20 phút đến khi cá vàng nhẹ (xaydungso).",
      "tip": "Trong lúc nướng nếu thấy miếng cá khô thì quét một lớp dầu ăn lên mặt cá (pasgo).",
      "timerMinutes": 18
    },
    {
      "stepNumber": 7,
      "instruction": "Rán mỡ cá: cho phần mỡ cá giữ lại từ bước 1 vào chảo, rán lửa vừa cho tan hết mỡ.",
      "tip": "pasgo dùng chính mỡ cá để xào — đây là bí quyết tạo độ béo ngậy đặc trưng của chả cá Vua Chả Cá.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Xào chả cá: cho cá đã nướng vào chảo mỡ đang nóng, thêm thì là và hành lá đã sơ chế, đảo nhẹ tay cho rau vừa chín tới và thấm mỡ cá thì tắt bếp.",
      "tip": "Đảo nhẹ tay để miếng cá không bị nát; rau chỉ cần vừa chín tới, còn xanh là ngon nhất.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 9,
      "instruction": "Pha mắm tôm chấm: cho 2 muỗng canh mắm tôm, 1⁄2 muỗng canh đường, 1⁄4 muỗng cà phê bột ngọt và 1 muỗng canh nước cốt chanh vào chén, đánh đều tay cho sủi bọt.",
      "tip": "xaydungso: đánh sủi bọt để mắm tôm thơm ngon hơn. pasgo gợi ý có thể pha với quất thay chanh."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn món: múc chả cá đang nóng hổi ra đĩa (hoặc để nguyên chảo nhỏ), rắc đậu phộng rang lên trên; dọn kèm đĩa bún trắng, húng láng, ớt tươi và chén mắm tôm.",
      "tip": "pasgo: chả cá ngon nhất là ăn nóng, chảo vẫn đang tí tách reo — ăn ngay đừng để nguội mất ngon."
    },
    {
      "stepNumber": 11,
      "instruction": "Thưởng thức: gắp miếng chả cá chấm mắm tôm, ăn kèm bún, thì là, hành lá, lạc rang và vài ngọn húng láng."
    }
  ],
