  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cá: làm sạch, cắt khúc dày 3–4 cm, rửa với nước muối loãng rồi thấm thật khô. Ướp cá với muối và chút tiêu khoảng 10 phút.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Cà chua rửa sạch, thái múi cau (hoặc thái hạt lựu nếu muốn sốt nhuyễn mịn). Hành tím, tỏi băm nhỏ; ớt thái lát; hành lá cắt khúc 2 cm."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng dầu ăn trên lửa vừa, cho cá vào chiên vàng đều hai mặt rồi vớt ra để ráo dầu.",
      "tip": "Thấm khô cá trước khi chiên để không bị bắn dầu và cá giòn, không nát."
    },
    {
      "stepNumber": 4,
      "instruction": "Chắt bớt dầu, chừa lại khoảng 2 muỗng canh trong chảo; cho hành tím, tỏi vào phi thơm."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho cà chua vào xào đến khi mềm nhuyễn, thêm 1/2 chén nước (khoảng 120 ml), đun sôi nhẹ.",
      "tip": "Hải Sản Lộc xào cà chua thật nhuyễn trước khi cho cá — sốt sẽ sánh và bám cá tốt hơn."
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm nước mắm, đường, dầu hào vào sốt; nếm lại cho vị chua-ngọt-mặn hài hòa."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cá đã chiên vào chảo sốt, hạ lửa nhỏ rim khoảng 10 phút cho cá thấm đều.",
      "tip": "MÂU THUẪN NGUỒN: Unity Fitness rim nhanh ~2 phút, Hải Sản Lộc rim ~10 phút — chọn 10 phút để cá thấm sốt kỹ hơn.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Thêm ớt và hành lá vào, đảo nhẹ, rắc tiêu xay rồi tắt bếp."
    },
    {
      "stepNumber": 9,
      "instruction": "Bày cá ra đĩa, rưới đều sốt cà chua lên trên, ăn nóng với cơm trắng.",
      "tip": "Cả hai nguồn đều gợi ý món ăn kèm cơm nóng và chấm nước mắm."
    }
  ],
