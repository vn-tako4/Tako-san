  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Rửa sạch cà chua, cắt thành múi cau nhỏ; hành lá thái nhỏ, để riêng.",
      "tip": "WOL: cắt cà chua thành múi cau nhỏ (small wedges) để nhanh mềm và ra nước."
    },
    {
      "stepNumber": 2,
      "instruction": "Đập 4 quả trứng vào tô, nêm 1/4 muỗng cà phê muối, 1/4 muỗng cà phê tiêu trắng, 1/2 muỗng cà phê dầu mè và 1 muỗng cà phê rượu Thiệu Hưng; đánh đều khoảng 1 phút.",
      "tip": "Nêm gia vị ngay vào trứng giúp trứng đậm đà, không bị nhạt."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng wok/chảo trên lửa vừa cho đến khi vừa bốc khói.",
      "tip": "Chảo phải thật nóng trước khi cho dầu thì trứng mới không bị dính (WOL)."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho 2 muỗng canh dầu ăn vào chảo nóng, đổ trứng vào xào nhanh tay đến khi vừa đông lại thì xúc ra để riêng.",
      "tip": "Xúc trứng ra ngay khi vừa chín tới, đừng xào kỹ — trứng sẽ chín tiếp khi cho trở lại chảo.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nốt 1 muỗng canh dầu ăn vào chảo, vặn lửa lớn, cho cà chua và hành lá vào xào khoảng 1 phút.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Thêm 2 muỗng cà phê đường, 1/2 muỗng cà phê muối còn lại và 60 ml nước; cho trứng đã xào trở lại chảo, đảo đều.",
      "tip": "Nếu bếp rất nóng và nước bốc hơi nhanh, có thể thêm một chút nước (WOL cho phép đến 1/2 cup)."
    },
    {
      "stepNumber": 7,
      "instruction": "Đậy nắp chảo, nấu lửa vừa 1–2 phút cho cà chua mềm hẳn và ra nước sốt.",
      "tip": "Bước đậy nắp giúp cà chua mềm nhừ mà không cần xào lâu.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Mở nắp, đảo đều cho sốt cà chua hòa quyện với trứng."
    },
    {
      "stepNumber": 9,
      "instruction": "Nếm và điều chỉnh muối/đường cho vừa khẩu vị.",
      "tip": "WOL ghi muối 'hoặc nêm theo khẩu vị'."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn ra đĩa, ăn nóng với cơm trắng.",
      "tip": "Món này ngon nhất khi ăn ngay lúc còn nóng."
    }
  ],
