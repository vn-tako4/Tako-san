  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Nấu nước dùng: cho 1.2 L nước, tảo bẹ, củ cải trắng cắt khối lớn và 1/4 củ hành tây vào nồi. Đun sôi lửa lớn rồi hạ lửa vừa, nấu 15 phút. Vớt bỏ tảo bẹ, củ cải và hành tây.",
      "tip": "KB: không nấu tảo bẹ quá lâu sẽ làm nước dùng bị nhớt và đắng.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Nêm nước dùng với 1 tbsp xì dầu loại dùng cho canh, muối và tiêu cho vừa miệng. Giữ ấm.",
      "tip": "Nước dùng lạt một chút cũng được vì sốt ướp thịt bò sẽ tiết ra thêm vị mặn ngọt khi nấu lẩu."
    },
    {
      "stepNumber": 3,
      "instruction": "Ướp thịt bò: trộn đều xì dầu, đường, mật ong, rượu nấu ăn, tỏi băm, dầu mè, lê xay và tiêu trong tô lớn. Cho thịt bò thái lát mỏng vào, dùng tay trộn nhẹ cho thấm đều. Ướp trong lúc sơ chế rau củ.",
      "tip": "KB: nếu mua thịt thái sẵn, dùng dao khía vài đường cho miếng thịt nhỏ lại vừa ăn.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 4,
      "instruction": "Sơ chế nấm: nấm đùi gà cắt lát dày khoảng 1 cm hoặc chẻ dọc thành miếng vừa ăn; nấm hương tươi cắt bỏ chân, cắt lát dày.",
      "tip": "KB: nấm nấu sẽ teo lại khá nhiều nên đừng cắt quá mỏng."
    },
    {
      "stepNumber": 5,
      "instruction": "Sơ chế rau củ: cà rốt thái lát mỏng; cải thảo cắt miếng vừa ăn; 1/2 củ hành tây còn lại thái lát; hành lá cắt khúc 5 cm."
    },
    {
      "stepNumber": 6,
      "instruction": "Nếu dùng mì khoai lang: ngâm trong nước ấm 20 phút cho mềm, vớt ra để ráo.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 7,
      "instruction": "Dùng nồi lẩu nông, xếp thịt bò đã ướp và các loại nấm, rau củ thành từng cụm xen kẽ cho đẹp mắt. Cho mì khoai lang (nếu dùng) vào cùng.",
      "tip": "KB: xếp theo cụm thay vì trộn lẫn để món lẩu trông hấp dẫn như ngoài hàng."
    },
    {
      "stepNumber": 8,
      "instruction": "Đổ khoảng 750 ml (3 cups) nước dùng vào nồi, đủ ngập khoảng 2/3 nguyên liệu.",
      "tip": "Phần nước dùng còn lại giữ nóng để châm thêm trong lúc ăn."
    },
    {
      "stepNumber": 9,
      "instruction": "Đun lửa lớn cho sôi, dùng đũa tách các lát thịt bò cho khỏi dính vào nhau.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Hạ lửa vừa, nấu thêm 5-7 phút đến khi nấm mềm và thịt bò chín tới.",
      "tip": "Thịt bò thái mỏng rất nhanh chín — nấu quá lâu thịt sẽ dai. Công thức YouTube Hàn cũng chỉ đun lẩu vừa sôi tới.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 11,
      "instruction": "Nêm nếm lại nước dùng cho vừa miệng, rắc hành lá lên trên. Dọn nóng ngay tại bàn, vừa ăn vừa châm thêm nước dùng và rau nấm nếu còn.",
      "tip": "KB: có thể nấu làm 2 mẻ tùy kích cỡ nồi, hoặc vừa ăn vừa thêm nguyên liệu như ăn lẩu."
    }
