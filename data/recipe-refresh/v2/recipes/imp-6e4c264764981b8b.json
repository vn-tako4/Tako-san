  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Chà một ít muối hột lên toàn bộ thịt gà để khử mùi hôi, rửa sạch nhiều lần với nước rồi để ráo. Cắt đùi gà thành miếng vừa ăn (khoảng 2–3 cm).",
      "tip": "ReviewAZ: ngoài muối có thể dùng một ít rượu trắng để rửa giúp thịt săn chắc hơn."
    },
    {
      "stepNumber": 2,
      "instruction": "Sả bóc lớp vỏ khô héo bên ngoài, rửa sạch, đập dập rồi băm nhỏ. Hành tím, tỏi bóc vỏ băm nhỏ. Ớt rửa sạch, bỏ cuống, thái lát mỏng. Hành tây (nếu dùng) bóc vỏ, thái múi cau."
    },
    {
      "stepNumber": 3,
      "instruction": "Cho thịt gà vào tô, thêm 1 muỗng cà phê hạt nêm và 1 muỗng canh nước mắm, trộn đều cho gia vị phủ đều các miếng gà. Ướp 20 phút cho thấm.",
      "tip": "ReviewAZ: có thể dùng tăm hoặc dĩa đâm nhẹ vào miếng gà để gia vị thấm qua da tốt hơn."
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc chảo lên bếp, cho 2 muỗng canh dầu ăn vào, đun nóng dầu rồi cho hành tím, tỏi băm vào phi đến khi vàng thơm.",
      "tip": "Dầu phải thật nóng trước khi cho hành tỏi vào, tránh hành tỏi bị âm dầu và ngấm mùi khét."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho sả băm và ớt vào chảo, đảo đều tay cho hỗn hợp dậy mùi thơm nồng."
    },
    {
      "stepNumber": 6,
      "instruction": "Trút thịt gà đã ướp vào chảo, đảo đều trên lửa lớn cho thịt săn lại."
    },
    {
      "stepNumber": 7,
      "instruction": "Khi thịt đã săn, hạ lửa vừa, cho 1⁄2 muỗng canh đường, 1 muỗng cà phê nước màu, 1⁄2 muỗng cà phê muối và 1 muỗng cà phê hạt nêm vào, thêm một chút nước, đảo đều cho gia vị tan và thấm đều thịt.",
      "tip": "elib.vn: bước thêm một chút nước này giúp gia vị hòa quyện mà thịt không bị khô cháy."
    },
    {
      "stepNumber": 8,
      "instruction": "Tiếp tục xào đảo đều đến khi thịt gà chín vàng, gia vị thấm đều và nước ướp cạn sền sệt thì nêm nếm lại cho vừa khẩu vị rồi tắt bếp."
    },
    {
      "stepNumber": 9,
      "instruction": "Múc gà ra đĩa, ăn nóng với cơm trắng.",
      "tip": "ReviewAZ: ớt thái lát nên cho vào gần cuối để giữ màu đỏ tươi và không bị nát; món ngon hơn khi dùng nóng kèm dưa chua."
    }
  ],
