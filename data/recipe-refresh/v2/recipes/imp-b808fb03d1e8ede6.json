  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Vo gạo 2-3 lần đến khi nước trong, cho vào nồi cơm với 430 ml nước, ngâm 20-30 phút rồi bật nấu. Khi cơm chín để nghỉ 10 phút rồi xới tơi.",
      "tip": "JOC: ngâm gạo trước khi nấu giúp hạt cơm chín đều, dẻo."
    },
    {
      "stepNumber": 2,
      "instruction": "Gà cắt miếng vuông khoảng 2.5 cm, ướp với 1 muỗng cà phê muối, trộn đều.",
      "tip": "ATK: ướp muối trước giúp thịt gà đậm đà từ bên trong."
    },
    {
      "stepNumber": 3,
      "instruction": "Khoai tây gọt vỏ, cắt miếng khoảng 2 cm, ngâm nước lạnh 15 phút cho ra bớt tinh bột rồi vớt ráo. Cà rốt gọt vỏ, cắt khoanh dày. Hành tây thái nhỏ. Gừng nạo nhuyễn, tỏi băm nhỏ.",
      "tip": "JOC: ngâm khoai tây 15 phút để khoai không bị nát khi ninh; dùng khoai Yukon gold giữ dáng tốt hơn khoai thường.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng dầu trong nồi lớn ở lửa vừa. Cho hành tây và 1/4 muỗng cà phê muối còn lại vào, xào khoảng 8 phút đến khi hành nâu vàng, đảo thường xuyên.",
      "tip": "ATK: xào hành đến nâu vàng (không chỉ trong) là nền vị ngọt cho cà ri.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 5,
      "instruction": "Thêm gừng nạo và tỏi băm vào, đảo nhanh 30 giây cho thơm.",
      "tip": "Không để tỏi cháy — tỏi cháy sẽ đắng."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho gà vào nồi, đảo đều đến khi thịt không còn màu hồng, khoảng 3 phút.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho khoai tây và cà rốt vào đảo cùng, đổ nước dùng gà vào. Đun sôi ở lửa lớn rồi hạ lửa nhỏ, ninh liu riu khoảng 20 phút đến khi khoai chín mềm (xiên đũa qua dễ dàng).",
      "tip": "ATK: giữ lửa liu riu nhẹ — sôi mạnh làm khoai nát và nước đục.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 8,
      "instruction": "Hạ lửa xuống mức nhỏ nhất, bẻ bánh cà ri cho vào từng miếng, khuấy nhẹ đến khi roux tan hoàn toàn, khoảng 1 phút.",
      "tip": "Cho roux vào khi lửa nhỏ/tắt bếp để roux tan mịn không vón cục (JOC: tắt bếp rồi mới cho roux vào khuấy tan).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Thêm xì dầu và sốt Worcestershire, khuấy đều, ninh liu riu thêm 3-5 phút đến khi sốt sánh lại. Nêm nếm muối/tiêu cho vừa miệng.",
      "tip": "ATK: khuấy nhẹ, cạo đáy nồi để cà ri không bén cháy khi sánh lại.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 10,
      "instruction": "Xới cơm ra 4 bát hoặc đĩa sâu (mỗi phần khoảng 1 cup cơm), múc cà ri đặt cạnh phần cơm.",
      "tip": "ATK: trình bày cơm một bên, cà ri một bên đĩa — đúng kiểu kare raisu Nhật."
    },
    {
      "stepNumber": 11,
      "instruction": "Rắc hành lá thái xéo lên trên cà ri. Dọn kèm fukujinzuke (hoặc gừng muối) nếu có. Ăn nóng.",
      "tip": "Cà ri để qua đêm trong tủ lạnh hôm sau ăn còn ngon hơn — vị các nguyên liệu quyện vào nhau (JOC)."
    }
  ],
