  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Nấu nước dùng: mía lau và ngô chẻ đôi, cho vào nồi với 2,5 lít nước, đun sôi rồi hạ lửa nấu khoảng 30-40 phút để lấy vị ngọt tự nhiên.",
      "tip": "DMX/bestme: đây là bí quyết nước lẩu ngọt thanh mà không cần nhiều gia vị.",
      "timerMinutes": 35
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế nấm: cắt bỏ gốc, rửa sạch với nước muối loãng hoặc nước vo gạo để loại bỏ bụi bẩn, xả lại nước sạch, để ráo; những cây nấm quá dài thì cắt nhỏ, chẻ ra cho vừa ăn.",
      "tip": "DMX: không ngâm nấm quá lâu trong nước, nấm thấm nước sẽ mất ngọt.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế rau củ: bắp cải cắt miếng vừa ăn; cà rốt gọt vỏ, tỉa khúc vừa ăn; đậu phụ cắt miếng vuông vừa ăn; hành boa rô băm nhỏ; hành lá cắt nhỏ.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc nồi lẩu lên bếp, cho 1 muỗng canh dầu ăn, phi thơm hành boa rô băm.",
      "tip": "bestme: phi hành khô/tỏi vàng thơm trước khi cho nước dùng vào.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Vớt bỏ mía lau và ngô ra khỏi nồi nước dùng, đổ nước dùng vào nồi lẩu đã phi hành; nêm 2 muỗng canh nước tương, 1 muỗng cà phê muối, 1 muỗng canh đường, 1 muỗng canh hạt nêm chay; đun sôi, nếm lại cho vừa miệng.",
      "tip": "DMX: 'Nêm nếm gia vị vào nồi lẩu sao cho vừa miệng' — nêm nhạt một chút vì khi nhúng nấm, rau sẽ ra thêm vị ngọt.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Trụng mì chay (nếu dùng): đun sôi nồi nước khác, cho mì vào trụng vừa chín tới, vớt ra xả nước lạnh cho sợi dai, để ráo, bày ra tô.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Khi ăn, đun sôi nồi lẩu, cho lần lượt các loại nấm, đậu phụ, bắp cải, cà rốt vào nhúng vừa chín tới rồi thưởng thức nóng.",
      "tip": "DMX 'Mách bạn': các nguyên liệu rất nhanh chín — không nấu quá lâu sẽ mất độ giòn và hương vị đặc trưng của nấm."
    },
    {
      "stepNumber": 8,
      "instruction": "Dọn lẩu nóng kèm mì chay/bún đã trụng, rắc hành lá lên trên; chấm thêm nước tương nếu thích đậm đà.",
      "tip": "bestme: ăn kèm rau thơm, xà lách tùy sở thích."
    }
  ],
