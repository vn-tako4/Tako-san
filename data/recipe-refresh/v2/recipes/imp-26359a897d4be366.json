  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Tôm bóc vỏ, bỏ chỉ lưng, rửa sạch, để ráo. Ướp tôm với rượu nấu ăn và một nhúm muối trong 10 phút.",
      "tip": "Ướp rượu giúp tôm thơm, bớt tanh (kỹ thuật của nguồn 1).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 2,
      "instruction": "Nấm đùi gà thái lát mỏng khoảng 0.5 cm. Gừng thái lát. Tỏi thái lát mỏng. Hành lá cắt riêng phần đầu trắng và phần lá xanh."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun nóng dầu ăn trong nồi, cho gừng, đầu trắng hành lá và tỏi vào phi thơm khoảng 10-20 giây.",
      "tip": "Phi nhanh tay, không để tỏi cháy."
    },
    {
      "stepNumber": 4,
      "instruction": "Đổ nước dùng gà vào nồi, đun sôi."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nấm đùi gà vào, nấu khoảng 3 phút cho nấm vừa chín.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm muối và xì dầu nhạt, khuấy đều, nếm lại cho vừa miệng."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho tôm đã ướp vào, nấu 2-3 phút đến khi tôm cong lại và chuyển màu hồng thì tắt bếp ngay.",
      "tip": "Cả hai nguồn đều cho tôm vào cuối và không nấu lâu — tôm quá lửa sẽ bị dai, khô.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm tiêu trắng xay, khuấy nhẹ cho đều."
    },
    {
      "stepNumber": 9,
      "instruction": "Rưới dầu mè lên mặt, rắc phần lá hành xanh cắt nhỏ."
    },
    {
      "stepNumber": 10,
      "instruction": "Múc súp ra tô, dùng nóng."
    }
  ],
