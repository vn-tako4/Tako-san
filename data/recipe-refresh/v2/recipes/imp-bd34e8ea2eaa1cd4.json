  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau củ: bắp cải bỏ lá già, thái sợi; hành tây thái lát mỏng; cần tây và cà rốt thái khoanh; khoai tây gọt vỏ, cắt hạt lựu; tỏi băm nhỏ; ngò tây thái nhỏ.",
      "tip": "Thái các loại củ kích thước đều nhau để chín đồng đều."
    },
    {
      "stepNumber": 2,
      "instruction": "Thái pancetta và thịt vai hun khói thành miếng nhỏ vừa ăn."
    },
    {
      "stepNumber": 3,
      "instruction": "Đun chảy bơ cùng dầu ô liu trong nồi súp lớn ở lửa vừa."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho pancetta, hành tây, cần tây, cà rốt, khoai tây và tỏi vào, xào khoảng 3 phút cho thơm và rau hơi mềm.",
      "tip": "Nguồn A chỉ xào 3 phút — rau sẽ chín tiếp trong quá trình ninh.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thịt vai hun khói vào, đảo thêm khoảng 1 phút.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Cho bắp cải, ngò tây và nhánh thyme vào cùng khoảng 1 cốc (240 ml) nước dùng, đậy nắp, om đến khi bắp cải hơi xẹp xuống."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho đậu cannellini đã để ráo và phần nước dùng còn lại vào nồi. Nêm muối và tiêu đen, đun cho sôi."
    },
    {
      "stepNumber": 8,
      "instruction": "Hạ lửa nhỏ, đậy nắp, ninh liu riu khoảng 1 giờ cho các vị hòa quyện và đậu bở mềm.",
      "tip": "Nguồn A khuyên nấu từ sáng để vị hòa quyện; nguồn B (Lorenza) ninh tổng ~1.5 giờ, nêm muối sau 30 phút đầu.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 9,
      "instruction": "Nếu dùng mì ditali: luộc riêng trong nồi nước muối đến al dente (khoảng 8-10 phút), vớt để ráo.",
      "tip": "Luộc riêng để nước súp không bị đặc bột.",
      "timerMinutes": 9
    },
    {
      "stepNumber": 10,
      "instruction": "Nếm lại, chỉnh muối tiêu cho vừa. Múc mì ra từng bát (nếu dùng), chan súp nóng lên trên, rắc Parmigiano bào. Dọn kèm bánh mì.",
      "tip": "Súp ăn ngon nhất khi còn nóng; hâm lại vẫn ngon."
    }
  ],
