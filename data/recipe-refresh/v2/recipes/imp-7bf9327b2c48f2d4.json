  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sườn non rửa sạch dưới vòi nước, thấm thật khô bằng khăn giấy. Có thể chặt thành từng dẻ dài hoặc để nguyên tảng tùy thích.",
      "tip": "WOL: thấm khô kỹ giúp sốt ướp bám tốt hơn."
    },
    {
      "stepNumber": 2,
      "instruction": "Trộn đều trong tô lớn: xì dầu, tỏi băm, đường, muối, tiêu trắng, ngũ vị hương, rượu Thiệu Hưng, dầu mè và tương hoisin thành sốt ướp."
    },
    {
      "stepNumber": 3,
      "instruction": "Giữ lại khoảng 1/3 lượng sốt để quét khi nướng. Phần còn lại xoa đều khắp miếng sườn, bọc kín, ướp trong tủ lạnh ít nhất 2 giờ, tốt nhất qua đêm.",
      "tip": "WOL: ướp ít nhất 2 giờ, qua đêm là ngon nhất.",
      "timerMinutes": 120
    },
    {
      "stepNumber": 4,
      "instruction": "Trước khi nướng 30 phút, lấy sườn ra khỏi tủ lạnh cho bớt lạnh.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 5,
      "instruction": "Làm nóng lò ở 200°C (400°F). Lót giấy bạc vào khay nướng, đặt vỉ nướng lên trên, đổ 1 cup (~240 ml) nước vào khay.",
      "tip": "WOL: nước trong khay giúp sườn không bị khô và hứng mỡ chảy xuống, đỡ cháy khét."
    },
    {
      "stepNumber": 6,
      "instruction": "Xếp sườn lên vỉ, cho vào lò nướng 30 phút.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 7,
      "instruction": "Lấy sườn ra, quét đều sốt ướp đã giữ lại lên khắp mặt, lật mặt sườn, cho vào lò nướng tiếp 20 phút.",
      "tip": "WOL nướng thêm 30 phút sau khi quét; Miki nướng 15 phút sau khi lật — chọn 20 phút cho 1.2 kg sườn, đường trong sốt sẽ tạo lớp vỏ hơi cháy xém đặc trưng.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 8,
      "instruction": "Quét một lớp mật ong mỏng lên mặt sườn, chuyển khay lên rãnh trên của lò, chỉnh 220°C (chế độ grill), nướng thêm 5 phút cho mặt sườn bóng và hơi xém.",
      "tip": "Theo Miki. Canh chừng kỹ vì mật ong rất dễ cháy.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 9,
      "instruction": "Lấy sườn ra, để nghỉ 5 phút cho nước thịt phân bố đều.",
      "tip": "WOL: bước nghỉ giúp thịt không bị khô khi chặt.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 10,
      "instruction": "Chặt sườn thành từng miếng vừa ăn."
    },
    {
      "stepNumber": 11,
      "instruction": "Xếp sườn ra đĩa, rắc hành lá thái nhỏ lên trên."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn nóng với cơm trắng.",
      "tip": "WOL gợi ý ăn kèm rau xào tỏi như cải thìa hoặc bông cải xanh."
    }
  ],
