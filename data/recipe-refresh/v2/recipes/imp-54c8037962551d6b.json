  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Nhặt bỏ phần rễ giá đỗ (có thể bỏ qua bước này nếu muốn nhanh), rửa sạch giá 2–3 lần nước rồi để thật ráo.",
      "tip": "Giá phải ráo nước hoàn toàn thì khi xào mới giòn và không bị ra nước, nhũn."
    },
    {
      "stepNumber": 2,
      "instruction": "Tỏi bóc vỏ, băm nhỏ. Hành lá rửa sạch, thái nhỏ."
    },
    {
      "stepNumber": 3,
      "instruction": "Bắc chảo lên bếp lửa lớn, cho 1 muỗng canh dầu ăn vào đun nóng."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho tỏi băm vào phi thơm đến khi ngả vàng, dậy mùi (không để cháy kẻo đắng).",
      "tip": "Đảo liên tục tay vì tỏi băm rất nhanh cháy trên lửa lớn.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Cho toàn bộ giá đỗ vào chảo, đảo nhanh và đều tay trên lửa lớn.",
      "tip": "Bếp MiNa nhấn mạnh: xào lửa to thì giá mới giữ được độ giòn."
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm muối, hạt nêm và nước mắm (nếu dùng), đảo đều khoảng 1 phút đến khi giá vừa chín tới, vẫn còn độ giòn.",
      "tip": "memart.vn xào 2–3 phút; Bếp MiNa chỉ xào khoảng 1 phút sau khi nêm — lấy theo Bếp MiNa để giá giòn, không nhũn.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Cho hành lá thái nhỏ và tiêu xay vào, đảo đều rồi tắt bếp ngay."
    },
    {
      "stepNumber": 8,
      "instruction": "Bày giá đỗ xào tỏi ra đĩa, dùng nóng với cơm trắng.",
      "tip": "Món xào ăn ngay khi còn nóng mới giữ được độ giòn ngọt của giá."
    }
  ],
