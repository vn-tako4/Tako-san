  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: bóc vỏ, bỏ chỉ đen ở lưng, rửa sạch, để ráo nước.",
      "tip": "Slurrp dùng tôm đã bóc vỏ sẵn (peeled and deveined). Để ráo kỹ giúp tôm xào nhanh săn, không ra nước."
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế rau củ: gừng gọt vỏ băm nhỏ; tỏi bóc vỏ băm nhuyễn; cải thìa cắt khúc vừa ăn; nấm thái lát mỏng; hành lá cắt nhỏ để riêng."
    },
    {
      "stepNumber": 3,
      "instruction": "Đặt nồi lớn lên bếp, cho dầu ăn vào đun nóng vừa, cho tỏi và gừng băm vào phi thơm khoảng 30 giây đến 1 phút, không để cháy.",
      "tip": "Slurrp: sauté garlic and ginger until fragrant; Allrecipes: xào hành, tỏi, gừng, ớt khoảng 2 phút. Tỏi cháy sẽ đắng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 4,
      "instruction": "Cho tôm vào nồi, xào nhanh trên lửa lớn đến khi tôm chuyển màu hồng và hơi săn lại thì vớt ra đĩa, để riêng.",
      "tip": "Slurrp xào tôm trước rồi vớt ra để tôm không bị nấu quá dai; Allrecipes cho tôm vào sau cùng cùng rau — mâu thuẫn, lấy theo Slurrp.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ nước dùng gà, nước lọc và xì dầu vào nồi, khuấy đều, đun sôi.",
      "timerMinutes": 5
    },
