  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cải thảo tách từng lá, rửa sạch, để ráo. Cắt khúc 3-4 cm, để riêng phần cọng trắng và phần lá xanh.",
      "tip": "Taste Asian Food: cắt dọc làm tư, bỏ phần gốc cứng, tách riêng cọng trắng và lá vì thời gian chín khác nhau."
    },
    {
      "stepNumber": 2,
      "instruction": "Cà rốt (nếu dùng) gọt vỏ, thái lát mỏng. Gừng một nửa băm nhỏ, một nửa thái lát. Hành lá thái nhỏ."
    },
    {
      "stepNumber": 3,
      "instruction": "Cho thịt heo xay vào tô, thêm gừng băm, xì dầu ướp thịt (1 muỗng cà phê), 1/2 muỗng cà phê muối, tiêu trắng, bột bắp, rượu Thiệu Hưng và 1 muỗng canh nước lọc. Trộn đều một chiều đến khi thịt dẻo, để nghỉ 10 phút.",
      "tip": "Taste Asian Food: trộn kỹ cho thịt dẻo giúp thịt mềm, không bị bở khi nấu.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Đặt nồi lên bếp lửa vừa, cho 1 muỗng canh dầu ăn vào. Cho gừng thái lát và đầu hành trắng vào phi thơm khoảng 30 giây."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thịt heo xay đã ướp vào, dùng đũa đánh tơi, xào đến khi thịt săn lại và hết màu hồng.",
      "tip": "Xào thịt trước giúp canh thơm và trong hơn so với thả thịt sống trực tiếp.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 6,
      "instruction": "Đổ nước dùng gà và nước lọc vào nồi, đun sôi, vớt bọt cho nước canh trong."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho phần cọng trắng cải thảo (và cà rốt nếu dùng) vào, đun sôi rồi hạ lửa vừa, nấu 5 phút cho cọng mềm.",
      "tip": "Taste Asian Food: cọng trắng cần 5 phút; Omnivore cũng nấu phần dày trước 5 phút.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Cho phần lá xanh cải thảo vào, nấu thêm 3 phút đến khi lá mềm nhưng vẫn giữ màu xanh.",
      "tip": "Taste Asian Food: lá xanh chỉ cần 3 phút, nấu lâu sẽ nhũn và mất màu.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 9,
      "instruction": "Nêm 1 muỗng canh xì dầu và 1 muỗng cà phê muối (phần còn lại), khuấy đều, nếm lại cho vừa miệng.",
      "tip": "Taste Asian Food: độ mặn phụ thuộc vào nước dùng đã nêm sẵn hay chưa — nêm từ từ."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc hành lá thái nhỏ lên trên, nhỏ vài giọt dầu mè (nếu dùng)."
    },
    {
      "stepNumber": 11,
      "instruction": "Tắt bếp, múc canh ra tô lớn."
    },
    {
      "stepNumber": 12,
      "instruction": "Dọn nóng, ăn kèm cơm trắng."
    }
