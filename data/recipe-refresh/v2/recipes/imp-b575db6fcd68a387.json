  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Đập 3 quả trứng vào tô, đánh tan đều bằng đũa hoặc phới."
    },
    {
      "stepNumber": 2,
      "instruction": "Hành lá thái nhỏ. Tỏi băm nhỏ (nếu dùng).",
      "tip": "Blonde Kimchi: nhiều gia đình Hàn cắt hành lá bằng kéo trực tiếp trên nồi cho nhanh."
    },
    {
      "stepNumber": 3,
      "instruction": "Cho 750 ml nước vào nồi cùng kombu (nếu dùng), đun lửa vừa đến khi sôi thì vớt kombu ra.",
      "tip": "Video công thức Hàn: đun kombu đến sôi rồi vớt ra ngay để nước không bị nhớt."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho xì dầu, tỏi băm (nếu dùng) vào nồi, khuấy đều, nêm 1/2 muỗng cà phê muối."
    },
    {
      "stepNumber": 5,
      "instruction": "Khi nước sôi bùng, hạ lửa vừa, rót từ từ trứng đã đánh vào nồi theo dòng mỏng, vừa rót vừa di chuyển tay theo vòng tròn.",
      "tip": "My Korean Kitchen: để trứng đông vài giây rồi mới khuấy nhẹ để tạo sợi trứng mềm."
    },
    {
      "stepNumber": 6,
      "instruction": "Để yên KHÔNG khuấy khoảng 10 giây để trứng kết thành sợi mịn.",
      "tip": "Blonde Kimchi: khuấy ngay sẽ làm nước canh bị đục."
    },
    {
      "stepNumber": 7,
      "instruction": "Khuấy nhẹ bằng đũa để tách trứng thành sợi, đun thêm 1 phút cho trứng chín hẳn.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 8,
      "instruction": "Cho hành lá vào, nếm lại và chỉnh muối/tiêu cho vừa miệng; thêm nhúm bột ngọt nếu thích (tùy chọn). Tắt bếp."
    },
    {
      "stepNumber": 9,
      "instruction": "Múc canh ra bát, rưới vài giọt dầu mè (tùy chọn). Ăn nóng với cơm trắng.",
      "tip": "Blonde Kimchi: canh trứng ăn sáng rất nhẹ bụng, cũng là món giải rượu phổ biến của người Hàn; có thể chan cơm trực tiếp vào canh."
    }
  ],
