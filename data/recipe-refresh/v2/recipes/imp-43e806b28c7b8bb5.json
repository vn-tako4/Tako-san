  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: cắt bỏ đầu, bóc vỏ, rút bỏ chỉ lưng, rửa sạch với nước muối pha loãng rồi rửa lại với nước, để ráo.",
      "tip": "DMX: rửa nước muối loãng giúp tôm sạch và săn chắc; tripmart: sau khi bóc vỏ nên để ráo trên giấy ăn để khi xào tôm không ra nước."
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế rau củ: hành tím bóc vỏ, băm nhuyễn; cà rốt gọt vỏ, cắt hạt lựu; giá đỗ rửa sạch, để ráo; hành lá nhặt bỏ lá héo úa, rửa sạch, cắt nhỏ; tỏi bóc vỏ, băm nhỏ."
    },
