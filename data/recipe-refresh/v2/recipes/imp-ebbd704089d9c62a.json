  "steps": [
    {
      "stepNumber": 1,
      "instruction": "So che ga: thit ga rua sach, de rao nuoc, thai mieng vua an.",
      "tip": "De rao that ky de khi xao thit san nhanh, khong ra nuoc."
    },
    {
      "stepNumber": 2,
      "instruction": "So che rau cu: hanh tay boc vo, cat mui cau; sa boc vo gia, bam nho cung hanh tim; toi chia lam 2 phan bam nho.",
      "tip": "vietgiaitri.com meo: co the uop lanh hanh tay trong ngan da 10-15 phut truoc khi cat de do cay mat ma khong anh huong mui vi."
    },
    {
      "stepNumber": 3,
      "instruction": "Uop ga: tron deu thit ga voi sa va hanh tim bam, 1/2 phan toi bam, 1 muong ca phe muoi ot xanh, 1 muong canh dau hao, 1/2 muong canh nuoc mam, 1/2 muong canh nuoc tuong, 1 muong ca phe tieu, 1 muong canh hat nem, 1/2 muong canh bot ngot va 1 muong canh duong. Uop 30 phut cho tham gia vi.",
      "tip": "Lay dung cong thuc uop cua dienmayxanh.com; vinid.net co cong thuc gan nhu tuong tu. Muoi ot xanh la gia vi uop chu khong phai do cham rieng.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 4,
      "instruction": "Phi thom: dat chao len bep lua lon, cho 2 muong canh dau an vao dun nong gia, cho phan toi bam con lai vao phi vang thom.",
      "tip": "Dau that nong moi cho toi vao thi toi vang deu, khong bi am dau."
    },
    {
      "stepNumber": 5,
      "instruction": "Xao ga: cho thit ga da uop tham vao chao, xao nhanh tay khoang 5 phut cho san thit.",
      "tip": "Xao lua lon, dao nhanh tay de mieng ga san deu, giu duoc do ngot.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Om ga: ha nho lua, cho 2 muong canh nuoc loc vao chao, day nap om khoang 10 phut cho thit ga chin han.",
      "tip": "Buoc om nap giup ga chin mem tu ben trong ma khong can them dau.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 7,
      "instruction": "Cho hanh tay vao: mo nap thay ga da chin va can bot nuoc thi mo lua lon tro lai, cho hanh tay vao xao them khoang 5 phut.",
      "tip": "Xao hanh tay vua chin toi de hanh giu do gion ngot, khong xao lau hanh se mem nhun.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Nem nem lai gia vi cho vua an, thay hanh chin thi tat bep. Muc ra dia, an nong voi com trang.",
      "tip": "vietgiaitri.com (ban canh ga doc lap): nem 1 tsp hat nem + 1 tsp bot ngot + 1 tsp muoi + 1 tsp tieu + 2 Tbsp nuoc mam khi xao — co the tham khao de dieu chinh do man theo khau vi."
    }
  ],
