  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Rửa thịt ba chỉ và thịt nạc vai với muối cho sạch, để ráo. Thái thịt ba chỉ thành miếng mỏng to bản; thịt nạc vai đem xay hoặc băm nhuyễn.",
      "tip": "netspace bước 1. Thịt ba chỉ thái mỏng vừa để dễ thấm gia vị và nhanh chín trên than.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Sả lột bớt lớp vỏ cứng bên ngoài, thái khoanh rồi xay nhuyễn; vắt lấy nước cốt sả, bỏ bã. Hành khô xay thật nhỏ đến gần như nát.",
      "tip": "netspace bước 2: chỉ lấy nước cốt sả để ướp — bã sả dễ cháy khét khi nướng than."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha gia vị ướp cho 600 g thịt: 2 muỗng cà phê bột canh, 2 muỗng cà phê đường, 2 muỗng cà phê bột ngọt, 1⁄2 muỗng cà phê nước hàng, 1⁄2 muỗng cà phê mắm tôm; trộn đều với nước cốt sả và hành xay.",
      "tip": "Tỷ lệ gốc của netspace cho 1 kg thịt: 3 thìa cà phê bột canh : 3 thìa đường : 3 thìa mỳ chính + 1 thìa cà phê nước hàng + 1 thìa mắm tôm — đã chia đôi cho 600 g thịt."
    },
    {
      "stepNumber": 4,
      "instruction": "Chia hỗn hợp gia vị làm 2 phần bằng nhau; một phần ướp với thịt xay, một phần ướp với thịt miếng. Bóp/trộn kỹ, bọc kín để ngăn mát ít nhất 1 tiếng.",
      "tip": "netspace: ướp qua đêm trong tủ lạnh thì thịt thấm ngon hơn nhiều. Công thức bán hàng của Đông Chuil cũng dặn ướp ít nhất 3–4 tiếng và bóp kỹ cho chả dẻo, không bở.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 5,
      "instruction": "Làm dưa góp: đu đủ xanh và cà rốt gọt vỏ, ngâm nước muối loãng rồi bào thành miếng mỏng; đổ bỏ nước ngâm, để ráo. Trộn với đường, giấm, bột canh, nước cốt chanh và ớt băm; nếm chua ngọt vừa miệng.",
      "tip": "netspace bước 5. Ngâm nước muối loãng giúp đu đủ, cà rốt giòn và bớt hăng.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 6,
      "instruction": "Vê thịt xay thành những viên nhỏ vừa ăn, ấn hơi dẹt. Xếp thịt miếng lên vỉ. Trước khi nướng khoảng 30 phút, trộn thêm 1⁄2 muỗng cà phê nước cốt chanh vào thịt.",
      "tip": "netspace lưu ý: cho nước cốt chanh trước khi nướng giúp thịt mềm hơn."
    },
    {
      "stepNumber": 7,
      "instruction": "Nướng thịt: Nướng trên bếp than hoa là ngon nhất (chuẩn vị Hà Nội) — than hồng vừa, trở đều tay cho xém cạnh mà không cháy. Trong lúc nướng, phết dầu ăn lên mặt thịt cho khỏi khô.",
      "tip": "netspace: nướng than hoa thơm ngon nhất. Chả viên nướng đến xém cạnh, dậy mùi thơm là đạt (Đông Chuil).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 8,
      "instruction": "Pha nước chấm: hòa tan 200 ml nước lọc với 80 ml nước mắm, 60 g đường và 40 ml nước cốt chanh; thêm tỏi và ớt băm. Nếm lại cho vị chua, mặn, ngọt dịu hài hòa rồi đun ấm.",
      "tip": "netspace: công thức có thể xê dịch tùy độ mặn của nước mắm — nếm lại và điều chỉnh cho vừa khẩu vị. Đun ấm lên thì tỏi ớt sẽ nổi lên trông đẹp mắt."
    },
    {
      "stepNumber": 9,
      "instruction": "Rửa sạch các loại rau sống, để ráo nước. Dọn bún ra đĩa."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn món: cho chả miếng và chả viên vào bát nước chấm ấm, thêm dưa góp đu đủ cà rốt; ăn kèm bún tươi và rau sống.",
      "tip": "netspace: dọn bún + rau ra đĩa, cho chả + dưa đu đủ cà rốt vào nước chấm. Nước chấm phải ấm nóng mới đúng điệu bún chả Hà Nội."
    }
  ],
