  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Lau miếng kombu bằng khăn ẩm (không rửa — lớp phấn trắng là vị umami), ngâm trong 1200 ml nước 30 phút.",
      "tip": "TAKA's Kitchen: ngâm kombu 30 phút rồi đun lửa nhỏ 10 phút trước khi sôi để lấy vị; JOC: không bao giờ để kombu sôi bùng.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 2,
      "instruction": "Cá hồi cắt miếng vừa ăn, rắc 1/2 muỗng cà phê muối lên hai mặt, ướp 15-20 phút để khử tanh.",
      "tip": "ushio-jiru: rắc muối lên cá, để 15-30 phút — muối rút bớt máu và chất gây tanh.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Nấm đùi gà cắt bỏ gốc, thái lát dày khoảng 5 mm. Gừng thái lát mỏng. Hành lá cắt xéo."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun một nồi nước khác cho sôi. Trụng nhanh miếng cá 30-60 giây cho se mặt (kỹ thuật 'shimofuri'), vớt ra xả ngay nước lạnh rồi rửa sạch váng và máu còn sót.",
      "tip": "ushio-jiru trụng đầu cá 45-60 giây, xương 15-20 giây; phi lê mỏng nên trụng nhanh hơn. Dùng bàn chải/đầu ngón tay cọ sạch phần máu đọng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nồi nước ngâm kombu lên bếp, đun lửa vừa đến khi nước lăn tăn (sắp sôi) thì vớt kombu ra ngay.",
      "tip": "Tuyệt đối không để kombu sôi bùng — kombu sôi sẽ tiết vị đắng và chát làm hỏng nước canh trong."
    },
    {
      "stepNumber": 6,
      "instruction": "Thêm sake, gừng lát và nấm đùi gà vào nồi, đun sôi nhẹ 5 phút, hớt bọt thường xuyên.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cá đã trụng vào nồi, hớt sạch bọt, đun lửa nhỏ thêm 5-8 phút cho cá chín và nấm mềm.",
      "tip": "eGullet: cho cá vào sau rau củ, ninh thêm 5-10 phút — không ninh quá lâu, cá nát và nước đục.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm 1/2 muỗng cà phê muối còn lại và 2 muỗng canh xì dầu. Nếm lại và điều chỉnh cho vừa miệng.",
      "tip": "eGullet nhấn mạnh với canh trong Nhật (sumashi): nêm nhạt là chính ('subtlety is the key') — nêm từ từ, thiếu thì thêm."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho hành lá cắt xéo vào nồi, tắt bếp ngay. Múc canh ra bát, ăn nóng.",
      "tip": "ushio-jiru: có thể chan canh lên cơm nóng ăn kèm."
    }
  ],
