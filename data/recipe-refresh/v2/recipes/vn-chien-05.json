  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Ngâm mộc nhĩ, nấm hương trong nước ấm 10-15 phút cho nở mềm; rửa sạch, vắt thật khô, thái sợi rồi băm nhỏ. Bỏ gốc nấm hương.",
      "tip": "vovankienthuc: ngâm nước ấm ~10 phút, vắt khô — nhân ướt là nguyên nhân nem bị vỡ và mềm khi rán.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Miến ngâm nước ấm 10-15 phút cho mềm (không ngâm nhũn), vớt ra để thật ráo, cắt khúc ngắn khoảng 1 đốt ngón tay.",
      "tip": "VnExpress: miến không nên ngâm nhũn quá, phải để khô ráo.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 3,
      "instruction": "Củ đậu, hành tây, su hào, cà rốt gọt vỏ, rửa sạch. Thái sợi mỏng nhỏ (hoặc thái hạt lựu nhỏ theo vovan). Hành hoa, rau mùi rửa sạch thái nhỏ. Hành khô bóc vỏ băm nhỏ.",
      "tip": "VnExpress: các loại rau củ quả nên để khô ráo và trộn riêng trước."
    },
    {
      "stepNumber": 4,
      "instruction": "Tôm tươi bóc vỏ, bỏ chỉ đen, rửa sạch, để ráo, thái hạt lựu nhỏ.",
      "tip": "VnExpress thái tôm hạt lựu và cho 2-3 miếng vào từng cuốn khi gói."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thịt nạc vai xay vào âu lớn, thêm 1 muỗng canh dầu ăn, 1 muỗng cà phê hạt nêm, 1 muỗng cà phê muối, 1 muỗng cà phê nước mắm, 2 muỗng cà phê hạt tiêu. Trộn đều, ướp 10 phút.",
      "tip": "VnExpress: trộn thịt với gia vị trước, rau củ trộn riêng — khi nào gói mới trộn chung.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 6,
      "instruction": "Trộn đều thịt đã ướp với mộc nhĩ, nấm hương, miến, củ đậu, hành tây, su hào, cà rốt, hành hoa, rau mùi, hành khô băm. Khi chuẩn bị gói mới cho 2 lòng đỏ trứng vào trộn lần cuối.",
      "tip": "VnExpress: cho trứng vào lúc sắp gói để nhân không bị chảy nước."
    },
    {
      "stepNumber": 7,
      "instruction": "Trải lá bánh đa nem lên mặt phẳng. Dùng khăn sạch thấm chút bia thoa đều mặt bánh cho mềm. Đặt thêm 1/2 lá bánh đa vào giữa để lót chống vỡ.",
      "tip": "VnExpress: phết bia giúp vỏ nem giòn; lót 1/2 lá tránh vỡ nhân khi rán. Gói vừa tay, không chặt quá vì nhân nở ra khi chiên."
    },
    {
      "stepNumber": 8,
      "instruction": "Múc lượng nhân vừa phải (khoảng 2-3 muỗng canh) đặt vào đầu lá nem, thêm 2-3 miếng tôm hạt lựu, gấp hai mép rồi cuộn tròn đều tay. Làm lần lượt đến hết nhân (~20 cái).",
      "tip": "Cuộn đều tay, kích thước bằng nhau để chín đều."
    },
    {
      "stepNumber": 9,
      "instruction": "Bắc chảo, đổ dầu ăn đủ ngập nem, đun nóng vừa (thử đầu đũa thấy sủi tăm). Cho nem vào rán lửa nhỏ vừa đến khi nem se mặt, chín khoảng 70-80% thì vớt ra giấy thấm dầu, để nguội.",
      "tip": "VnExpress: rán 2 lần nem mới giòn rụm. Lần 1 chỉ rán tới 70-80%, có thể chia mẻ cấp đông ăn dần.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 10,
      "instruction": "Trước khi ăn, cho nem vào chiên lần 2 ở lửa vừa đến khi vàng giòn đều các mặt. Vớt ra để lên giấy thấm dầu.",
      "timerMinutes": 5
    },
