  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế hải sản: tôm rửa sạch, cắt bỏ râu; mực làm sạch, khía vảy rồng rồi cắt khoanh vừa ăn; phi lê cá rửa sạch, thái lát vừa. Để tất cả ráo nước, bày ra đĩa.",
      "tip": "cooky bước 1.",
      "timerMinutes": 20
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế rau củ: 2 quả cà chua cắt miếng vừa, 1 quả bổ múi cau để cho vào sau; dứa cắt miếng vừa ăn; sả đập dập cắt khúc; lá chanh vò hơi nát; ớt thái lát; nấm cắt bỏ gốc, rửa sạch.",
      "tip": "cooky: lá chanh vò hơi nát để dậy mùi thơm.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Bắc nồi lên bếp, cho 2 muỗng canh dầu ăn vào; phi thơm tỏi băm và hành tím băm đến vàng, cho lá chanh vò nát và sả vào xào thơm.",
      "tip": "cooky bước 2.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Cho ớt, 2 quả cà chua cắt miếng và dứa vào đảo đều cho chín sơ, ra màu đẹp.",
      "tip": "cooky bước 3: đảo để thơm và cà chua chín sơ.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ 1.5 lít nước vào nồi, đun sôi rồi vớt bỏ sả và lá chanh ra khỏi nồi cho nước lẩu trong, không bị đắng.",
      "tip": "cooky bước 3: vớt sả và lá chanh ra sau khi sôi.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Đặt rây lên miệng nồi, cho me chua vào rây rồi dùng muôi dầm lọc lấy nước cốt me xuống nồi. Nêm 15 ml nước mắm, 1 muỗng canh tương cà, 1 muỗng canh tương ớt, 1 muỗng cà phê muối, 1⁄2 muỗng cà phê bột ngọt, 20 g đường; khuấy đều, đun sôi lại.",
      "tip": "cooky bước 4 (đã hiệu chỉnh lỗi đánh máy '400 g đường' trong nguồn).",
      "timerMinutes": 10
    },
    {
      "stepNumber": 7,
      "instruction": "Cho cà chua bổ múi cau và các loại nấm vào nồi. Lần lượt cho tôm, mực, phi lê cá vào; nấu đến khi hải sản vừa chín tới.",
      "tip": "cooky bước 5. KHÔNG nấu hải sản quá lâu sẽ bị dai, mất ngọt.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm nếm lại cho vừa vị chua cay mặn ngọt hài hòa theo khẩu vị gia đình.",
      "tip": "tripi: nêm nếm lại cho vừa miệng trước khi dọn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Dọn nồi lẩu ra bàn. Khi ăn nhúng rau muống, rau nhút, cải thảo vào nồi; ăn kèm bún tươi (hoặc mì tôm theo hint) và chấm nước mắm ớt.",
      "tip": "cooky bước 6; tripi: thêm chén nước mắm cay là 'hết sẩy'."
    }
  ],
