  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Chuẩn bị dứa: nếu dùng dứa hộp, chắt lấy 190 ml nước ép và giữ lại 160 g miếng dứa để riêng.",
      "tip": "WOL: dứa và nước ép dứa là optional — không thích ngọt có thể bỏ qua, thay nước ép bằng nước hoặc nước dùng gà."
    },
    {
      "stepNumber": 2,
      "instruction": "Pha sốt chua ngọt: cho nước nóng, 1/4 muỗng cà phê muối, đường và tương cà vào tô, khuấy đến khi đường và muối tan hết. Thêm giấm gạo và nước ép dứa, khuấy đều, để riêng.",
      "tip": "WOL: pha sốt trước để khi nấu chỉ việc đổ vào — món này nấu rất nhanh."
    },
    {
      "stepNumber": 3,
      "instruction": "Cắt gà thành miếng vuông đều nhau khoảng 2,5 cm cho chín đều. Cho vào tô cùng 2 muỗng canh nước, bột tỏi, bột hành, dầu mè, tiêu trắng và 1/2 muỗng cà phê muối. Trộn đều, để 5 phút cho gà thấm hết nước.",
      "tip": "WOL: bước ướp và cấp ẩm này giúp gà mọng nước khi chiên và lớp bột bám chắc, giòn lâu; nếu gà còn ráo nước thì trộn thêm rồi để thêm 5 phút.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Pha bột áo: trộn đều bột mì, bột bắp, bột nở và baking soda trong tô. Thêm nước đá, dùng nĩa khuấy thành bột sánh mịn, rồi cho 1 muỗng canh dầu ăn vào khuấy đều.",
      "tip": "WOL: bột nở, baking soda và dầu là bí quyết giúp lớp vỏ nhẹ, giòn xốp đúng chuẩn nhà hàng."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun dầu chiên trong nồi nhỏ đến 170°C (335°F). Nên dùng nhiệt kế kẹo để đo cho chính xác.",
      "tip": "WOL: nồi nhỏ tốn ít dầu hơn nhưng phải chiên nhiều mẻ; nồi to chiên nhanh hơn nhưng tốn dầu."
    },
    {
      "stepNumber": 6,
      "instruction": "Nhúng 5–6 miếng gà vào bột, dùng đũa hoặc tay áo bột đều. Thả từng miếng từ từ vào dầu — nhúng nửa chừng cho lớp bột se lại vài giây rồi mới buông hẳn để gà không dính đáy nồi và không dính vào nhau. Chiên khoảng 2 phút đến khi vỏ vàng giòn, vớt ra để ráo dầu trên rổ hoặc giấy thấm dầu.",
      "tip": "WOL: thả chậm là kỹ thuật quan trọng chống dính; lật nhẹ cho vàng đều các mặt.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Làm nóng 1 muỗng canh dầu ăn trong wok/chảo lớn trên lửa vừa–lớn. Cho tỏi băm, hành tây và ớt chuông vào, xào nhanh 30 giây.",
      "tip": "WOL xào rau 30 giây; tỏi tươi theo OC — phi thơm trước khi cho rau."
    },
    {
      "stepNumber": 8,
      "instruction": "Đổ chén sốt chua ngọt đã pha vào chảo, đun sôi rồi hạ lửa cho sốt liu riu.",
      "tip": "WOL: nấu sốt ngay sau khi chiên gà xong để gà giữ độ giòn tối đa."
    },
    {
      "stepNumber": 9,
      "instruction": "Pha 2 muỗng canh bột bắp với 2 muỗng canh nước thành hỗn hợp sệt. Vừa khuấy sốt vừa rưới từ từ vào đến khi sốt sánh, bám được vào thìa — có thể không cần dùng hết.",
      "tip": "WOL: cho từ từ, nếm thử — đây là lúc điều chỉnh thêm muối, giấm hoặc đường cho vừa khẩu vị."
    },
    {
      "stepNumber": 10,
      "instruction": "Cho miếng dứa vào, đảo đến khi dứa nóng đều.",
      "tip": "WOL: gia đình tác giả thường bỏ qua dứa vì không thích quá ngọt — tùy khẩu vị."
    },
    {
      "stepNumber": 11,
      "instruction": "Chiên lại gà: đun dầu lên 170°C, cho gà vào chiên lại 2 mẻ, mỗi mẻ khoảng 45 giây cho giòn rụm.",
      "tip": "WOL: chiên lại là bí quyết giữ gà giòn khi áo sốt; nếu chuẩn bị trước thì chiên lại ngay trước khi trộn sốt.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 12,
      "instruction": "Cho gà vừa chiên lại vào chảo sốt, đảo nhẹ bằng xẻng cho sốt bám đều từng miếng. Dọn ra đĩa và ăn ngay.",
      "tip": "WOL: phải ăn ngay khi còn nóng giòn; rửa chảo ngay sau khi nấu vì axit trong giấm làm hại lớp chống dính của chảo."
    }
  ],
