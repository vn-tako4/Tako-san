  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Rửa tôm khô qua nước lạnh cho sạch bụi, ngâm trong nước ấm 15-20 phút cho mềm rồi vớt ra để ráo.",
      "tip": "MÂU THUẪN NHỎ: nguồn 2 ngâm tôm khô 30 phút; nguồn 1 cho tôm khô vào nồi từ đầu không ngâm. Ngâm 15-20 phút giúp tôm nhanh ra vị ngọt hơn.",
      "timerMinutes": 18
    },
    {
      "stepNumber": 2,
      "instruction": "Cải thảo tách từng bẹ, rửa sạch, cắt khúc dài 5-7 cm. Để riêng phần bẹ trắng cứng và phần lá xanh mềm ra hai bát.",
      "tip": "Bẹ cứng lâu chín hơn lá nên phải cho vào trước (nguồn 2)."
    },
    {
      "stepNumber": 3,
      "instruction": "Gừng thái lát mỏng, hành lá thái nhỏ để riêng."
    },
    {
      "stepNumber": 4,
      "instruction": "Cho tôm khô đã ngâm và gừng lát vào nồi với nước lạnh, đun sôi trên lửa lớn.",
      "tip": "Cho tôm khô vào từ nước lạnh để vị ngọt tiết ra từ từ, nước dùng trong và ngọt sâu (nguồn 1)."
    },
    {
      "stepNumber": 5,
      "instruction": "Khi nước sôi, hạ lửa vừa, đậy hé vung, nấu 10 phút cho tôm khô ra hết vị ngọt. Vớt bọt nếu có.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 6,
      "instruction": "Cho phần bẹ cải thảo trắng vào nồi, nấu 5 phút cho bẹ vừa mềm tới.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Cho phần lá cải xanh vào, nấu thêm 2-3 phút đến khi lá vừa chín tới, còn giữ màu xanh mướt.",
      "tip": "Không nấu lá quá lâu kẻo cải nhũn và mất màu (nguồn 2).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Nêm muối vừa ăn, khuấy nhẹ cho tan đều. Nếm lại và điều chỉnh.",
      "tip": "Nêm muối ở cuối để dễ kiểm soát độ mặn, vì tôm khô đã có vị mặn tự nhiên (nguồn 1)."
    },
    {
      "stepNumber": 9,
      "instruction": "Rắc hành lá thái nhỏ lên trên, tắt bếp. Múc canh ra tô lớn, dọn nóng.",
      "tip": "Món canh thanh ngọt, ăn kèm cơm trắng rất hợp."
    }
  ],
