  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Bắp cải bỏ lõi cứng, thái sợi mỏng; cà rốt (nếu dùng) thái sợi mỏng cùng cỡ với bắp cải.",
      "tip": "Azusa: thái các loại rau cùng cỡ để chín đều."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho bắp cải và cà rốt vào nồi với 60 ml (1/4 cup) nước, đậy nắp, đun lửa vừa khoảng 5 phút cho rau mềm.",
      "tip": "Azusa: chỉ cần 1/4 cup nước và đậy nắp — rau chín bằng hơi nước, không cần luộc ngập nước.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Vớt rau ra rổ, để nguội bớt rồi dùng tay vắt nhẹ cho ráo hết nước thừa.",
      "tip": "Azusa nhấn mạnh: KHÔNG bỏ qua bước vắt nước — vắt kỹ giúp sốt mè bám đều, món không bị loãng/nhạt."
    },
    {
      "stepNumber": 4,
      "instruction": "Nếu vừng chưa rang: cho vừng vào chảo khô, rang lửa vừa-nhỏ đến khi thơm và hơi vàng.",
      "tip": "Azusa: rang vừng trước khi giã giúp dậy mùi thơm béo.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Cho vừng rang vào cối, giã đến khi thơm và hơi sánh mịn (có thể để lại một ít hạt nguyên để thêm độ giòn)."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho vừng đã giã vào tô, thêm 1 muỗng canh đường và 1 muỗng canh xì dầu, trộn đều thành sốt mè.",
      "tip": "Đây là công thức sốt gomaae kinh điển: vừng giã + đường + xì dầu (Azusa)."
    },
    {
      "stepNumber": 7,
      "instruction": "Cho bắp cải và cà rốt đã vắt ráo vào tô sốt, trộn đều tay cho sốt bám đều từng sợi rau."
    },
    {
      "stepNumber": 8,
      "instruction": "Đậy kín, cho vào tủ lạnh ít nhất 30 phút cho món lạnh đều và thấm vị.",
      "tip": "Món này ăn lạnh (đúng tên món); Azusa: bảo quản tủ lạnh 2–3 ngày, hợp làm meal prep/bento.",
      "timerMinutes": 30
    },
    {
      "stepNumber": 9,
      "instruction": "Dọn ra đĩa, rắc hành lá thái nhỏ (tùy chọn) và một ít vừng nguyên hạt lên trên."
    }
  ],
