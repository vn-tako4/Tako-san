  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cắt bỏ phần gốc cứng của nấm đùi gà, lau sạch bằng khăn ẩm (không ngâm rửa — nấm hút nước sẽ bị nhão khi chiên)."
    },
    {
      "stepNumber": 2,
      "instruction": "Thái nấm thành khoanh dày 1.5-2 cm (entabe). Có thể khía mặt nấm hình caro cho thấm gia vị và trông giống sò điệp (Himahiyo).",
      "tip": "Thái dày kiểu 'scallop-style' là điểm đặc trưng của món: miếng nấm dày ăn giòn sần sật như sò điệp."
    },
    {
      "stepNumber": 3,
      "instruction": "Hành lá thái nhỏ, để riêng."
    },
    {
      "stepNumber": 4,
      "instruction": "Đặt chảo lên bếp lửa vừa, cho bơ vào đun tan chảy hoàn toàn."
    },
    {
      "stepNumber": 5,
      "instruction": "Xếp các khoanh nấm thành một lớp vào chảo, chiên mặt thứ nhất 2-3 phút đến khi vàng nâu.",
      "tip": "Không xếp nấm chồng lên nhau — nấm ra nước sẽ bị hấp thay vì chiên vàng giòn mặt.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Lật nấm, chiên mặt còn lại đến vàng nâu đều.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Rắc muối và tiêu đen đều lên hai mặt nấm."
    },
    {
      "stepNumber": 8,
      "instruction": "Rưới xì dầu quanh thành chảo nóng, đảo nhanh 10-15 giây cho nấm thấm đều.",
      "tip": "Himahiyo: rưới shoyu quanh mép chảo nóng để shoyu bốc hơi thơm (hương cháy cạnh) thay vì đổ trực tiếp lên nấm."
    },
    {
      "stepNumber": 9,
      "instruction": "Cho hành lá thái nhỏ vào, đảo nhanh rồi tắt bếp. Bày nấm ra đĩa, ăn nóng.",
      "tip": "SOSCuisine: rắc hành lá lên trên cùng lúc dọn — món ăn nóng là ngon nhất, để nguội bơ đông lại sẽ ngấy."
    }
  ],
