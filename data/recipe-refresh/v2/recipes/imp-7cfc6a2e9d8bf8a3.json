  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Rau muống nhặt lấy phần cọng non và lá, bỏ cọng già và lá úa, ngắt khúc vừa ăn. Ngâm rau trong nước muối loãng khoảng 5 phút, rửa sạch nhiều lần với nước rồi để rổ cho ráo.",
      "tip": "Saigonese Baguette: ngâm nước muối vừa làm sạch vừa giúp rau xanh hơn khi nấu."
    },
    {
      "stepNumber": 2,
      "instruction": "Cà chua rửa sạch, cắt bỏ cuống, thái múi cau. Hành tím lột vỏ, thái lát mỏng (hoặc băm nhỏ). Hành lá rửa sạch, cắt nhỏ."
    },
    {
      "stepNumber": 3,
      "instruction": "Tôm đồng rửa sạch, bóc vỏ, rút chỉ đen, giữ lại gạch tôm nếu có. Cho tôm vào cối giã thô (có thể dùng máy xay xay thô). Ướp tôm với 1⁄3 muỗng cà phê muối, 1⁄2 muỗng cà phê hạt nêm, 1⁄2 muỗng cà phê đường và 1⁄3 muỗng cà phê tiêu, trộn đều để thấm.",
      "tip": "naungon.com: giã thô tôm (kèm gạch tôm nếu có) giúp nước canh ngọt và có màu đẹp hơn."
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc nồi lên bếp, đun nóng 2 muỗng canh dầu ăn trên lửa vừa, cho hành tím vào phi đến khi vàng thơm."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho tôm đã ướp vào nồi, đảo đều đến khi tôm chuyển màu hồng và săn lại."
    },
    {
      "stepNumber": 6,
      "instruction": "Thêm cà chua vào xào chung với tôm khoảng 3 phút để cà chua mềm và ra màu đẹp."
    },
    {
      "stepNumber": 7,
      "instruction": "Đổ 1,5 lít nước lọc vào nồi, mở lửa lớn đun sôi mạnh. Nêm 1⁄2 muỗng cà phê muối, 1 muỗng cà phê hạt nêm, 1 muỗng canh nước mắm và 1⁄2 muỗng cà phê bột ngọt (nếu dùng), khuấy tan."
    },
    {
      "stepNumber": 8,
      "instruction": "Khi nước sôi thật mạnh, cho toàn bộ rau muống vào nồi. Đợi nước sôi trở lại thì nêm nếm lại gia vị cho vừa miệng."
    },
    {
      "stepNumber": 9,
      "instruction": "Khi rau vừa chín tới (xanh mướt, còn giòn), cho hành lá vào, tắt bếp ngay. Múc canh ra tô, ăn nóng với cơm.",
      "tip": "naungon.com: không nên đun lâu — rau mất độ giòn và màu xanh; không đậy nắp khi đang nấu để rau giữ màu xanh."
    }
  ],
