  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Bắp cải tách lá, cắt nhỏ vừa ăn, rửa sạch. Ngâm bắp cải trong nước muối loãng khoảng 10-15 phút cho sạch, vớt ra rửa lại, để ráo.",
      "tip": "Ngâm nước muối giúp loại bỏ thuốc trừ sâu và sâu nhỏ trong kẽ lá.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Nấm kim châm cắt bỏ phần gốc, tách nhỏ, rửa sạch nhẹ nhàng, để ráo nước.",
      "tip": "Không ngâm nấm lâu trong nước, nấm sẽ bị nhũn và mất ngọt."
    },
    {
      "stepNumber": 3,
      "instruction": "Đậu phụ rửa qua nước cho sạch, để ráo, cắt thành miếng vuông vừa ăn (khoảng 3-4 cm).",
      "tip": "Để đậu thật ráo trước khi chiên để không bị bắn dầu."
    },
    {
      "stepNumber": 4,
      "instruction": "Tỏi bóc vỏ, băm nhuyễn. Hành lá rửa sạch, cắt khúc ngắn khoảng 2-3 cm."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng dầu ăn trong chảo/nồi, cho đậu phụ vào chiên vàng đều các mặt, vớt ra để ráo dầu.",
      "tip": "Nongsandungha: chiên vàng đều các mặt trước khi kho — lớp vỏ vàng giúp đậu không nát và ngấm gia vị hơn.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 6,
      "instruction": "Chắt bớt dầu chiên, giữ lại một ít trong nồi, cho tỏi băm vào phi thơm vàng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Cho nấm kim châm vào xào trước khoảng 1-2 phút cho nấm ngấm dầu tỏi, sau đó cho bắp cải vào xào cùng.",
      "tip": "Nongsandungha: xào nấm với tỏi trước rồi mới cho bắp cải vào xào tiếp.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Đổ xì dầu vào cùng với đường, muối, hạt nêm và nước lọc. Đảo đều, đậy nắp, đun lửa nhỏ cho bắp cải chín mềm, ngấm gia vị.",
      "tip": "Nongsandungha: đun lâu một chút cho bắp cải chín mềm thì tắt bếp. Không cho quá nhiều nước vì bắp cải và nấm sẽ tiết thêm nước.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 9,
      "instruction": "Cho đậu phụ đã chiên vào nồi, đảo nhẹ tay, kho thêm 3-5 phút cho đậu ngấm đều nước kho.",
      "tip": "Đảo nhẹ để đậu không bị nát.",
      "timerMinutes": 4
    },
    {
      "stepNumber": 10,
      "instruction": "Nêm nếm lại cho vừa khẩu vị, rắc tiêu đen xay và hành lá cắt khúc lên trên, tắt bếp. Dọn ra đĩa, dùng nóng với cơm."
    }
  ],
