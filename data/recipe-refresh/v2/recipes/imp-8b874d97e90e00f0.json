  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Gà rửa sạch, thấm khô, cắt miếng vừa ăn khoảng 4–5 cm, cho vào tô lớn.",
      "tip": "Thấm khô gà giúp gia vị bám tốt và khi chiên không bị bắn dầu."
    },
    {
      "stepNumber": 2,
      "instruction": "Sả lấy phần gốc trắng, cắt khúc, đập dập rồi dùng chày giã cho tơi thành sợi. Cho sả đã giã vào tô gà.",
      "tip": "Nguồn A: giã sả đến khi nhẹ, tơi và thành sợi như bông — sả tơi sẽ giòn thơm khi chiên cùng gà.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 3,
      "instruction": "Giã tỏi, rễ mùi và tiêu đen nguyên hạt thành hỗn hợp sệt thô. Trộn hỗn hợp này vào tô gà cùng dầu hào, nước mắm, đường và bột ngô.",
      "tip": "Nguồn A: trộn bằng tay, bóp nhẹ để sả tơi ra và gia vị thấm đều từng miếng gà.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Ướp gà ít nhất 30 phút trong tủ lạnh (ngon nhất 1–2 giờ).",
      "tip": "Nguồn B ướp 1 giờ; ướp lạnh giúp gà thấm sâu và thịt săn chắc hơn khi chiên.",
      "timerMinutes": 60
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ dầu vào nồi/chảo sâu khoảng 1/3 dung tích, đun nóng đến 165°C (thử bằng cách nhúng đầu đũa gỗ vào thấy sủi bọt li ti).",
      "tip": "Nguồn A: dầu đủ nóng ở 165°C/325°F; dầu chưa đủ nóng gà sẽ ngấm dầu, quá nóng vỏ cháy mà trong chưa chín.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 6,
      "instruction": "Cho gà vào chiên từng mẻ nhỏ (không xếp chồng), chiên 4–5 phút đến khi vàng giòn và chín đều.",
      "tip": "Nguồn A: vớt ngay những sợi sả nào vàng trước khi gà chín để không bị cháy đắng.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Vớt gà và sả ra, để ráo dầu trên giấy thấm.",
      "tip": "Để ráo giúp gà giữ độ giòn lâu."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho tất cả gà và sả chiên vào tô lớn, thêm lá chanh thái sợi, xóc đều.",
      "tip": "Nguồn A: lá chanh cho vào sau khi chiên để giữ hương thơm tươi."
    },
    {
      "stepNumber": 9,
      "instruction": "Bày ra đĩa, ăn nóng với cơm nếp hoặc cơm trắng, kèm tương ớt ngọt Thái nếu thích.",
