  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế cua đồng: ngâm cua khoảng 1 giờ cho nhả hết đất cát, rửa lại nhiều lần cho thật sạch; lột yếm, tách mai; dùng thìa khều lấy gạch cua để riêng vào bát nhỏ.",
      "tip": "Vietgiaitri: ngâm 1 giờ để loại bỏ đất cát; phunutoday: nên giã cua thay vì xay."
    },
    {
      "stepNumber": 2,
      "instruction": "Giã và lọc cua: giã nhuyễn thân cua với một nhúm muối; hòa với nước, dùng tay bóp nhẹ cho thịt cua tan ra, lọc qua rây bỏ xác — lọc 2-3 lần được khoảng 2,5-3 lít nước riêu.",
      "tip": "Vietgiaitri lọc được ~3,5 lít nước cho 1 kg cua; ướp nước cua với chút muối."
    },
    {
      "stepNumber": 3,
      "instruction": "Rán đậu phụ: đậu phụ cắt miếng vuông vừa ăn, rán vàng giòn các mặt, vớt ra để ráo dầu.",
      "tip": "Vietgiaitri: cắt khối vuông nhỏ rán vàng.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Xào gạch cua và cà chua: phi thơm hành khô với mỡ lợn; cho gạch cua vào xào chín trút ra đĩa; cà chua bổ múi cau cho vào xào với 1 mcf mắm và chút đường đến sền sệt.",
      "tip": "Phunutoday: xào riêng từng phần để giữ màu đẹp và vị thơm.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 5,
      "instruction": "Nấu riêu: bắc nồi nước cua lên bếp, thêm mắm tôm và nước mắm; đun lửa vừa, thỉnh thoảng khuấy nhẹ đáy nồi cho cua không dính; khi riêu nổi thành mảng thì hạ lửa nhỏ, dùng muôi gạt riêu sang một bên nồi.",
      "tip": "Phunutoday: vặn nhỏ lửa khi riêu nổi để mảng riêu không vỡ; không khuấy mạnh.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 6,
      "instruction": "Hoàn thiện nước lèo: cho cà chua xào, gạch cua xào và đậu rán vào nồi; thêm nước mẻ đã lọc và giấm bỗng; nêm muối, hạt nêm, đường vừa miệng; đun sôi nhẹ thêm 5 phút.",
      "tip": "Vietgiaitri: cho giấm bỗng vào thử vị chua vừa ăn, tùy khẩu vị; phunutoday: nước dùng chua đậm vị, ngọt hậu.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Thái bắp bò: thịt bò cho vào ngăn đá 15 phút cho cứng lại rồi thái lát thật mỏng, bày ra đĩa.",
      "tip": "Phunutoday: bỏ ngăn đá 15 phút giúp thái mỏng dễ dàng."
    },
    {
      "stepNumber": 8,
      "instruction": "Sơ chế rau sống: xà lách, kinh giới, tía tô, rau mùi, hành lá rửa sạch, ngâm nước muối loãng, vớt ra để ráo.",
      "tip": "Phunutoday: ngâm nước muối pha loãng đảm bảo vệ sinh."
    },
    {
      "stepNumber": 9,
      "instruction": "Lên tô: cho bún vào tô, xếp riêu cua, đậu phụ, cà chua; bắp bò chần nhanh trong nước lèo đang sôi cho vừa chín tới rồi xếp lên; chan nước lèo nóng; rắc hành lá.",
      "tip": "Phunutoday: thịt bò nhúng qua nước lèo cho chín rồi mới cho vào bát.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 10,
      "instruction": "Thưởng thức: ăn kèm rau sống, mắm tôm và ớt tươi. Thành phẩm đạt: riêu cua đóng thành mảng vàng ruộm, nước dùng chua đậm vị, ngọt hậu không chát.",
      "tip": "Phunutoday: yêu cầu thành phẩm và lưu ý không thích mắm tôm có thể bỏ qua."
    }
  ],
