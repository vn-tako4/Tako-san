  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Kiểm tra thịt cua, gỡ bỏ mảnh vỏ cứng còn sót; để ráo nước.",
      "tip": "Thịt cua bóc sẵn dễ còn lẫn mảnh vỏ — kiểm tra kỹ để khi ăn không bị hóc."
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế gia vị: ớt hiểm đập dập rồi băm nhỏ; tỏi băm nhỏ; ớt chuông bỏ hạt, cắt miếng vừa ăn; ớt sừng thái lát xéo mỏng; hành lá cắt khúc khoảng 3 cm."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha sốt: cho dầu hào, xì dầu, đường, tiêu xay và nước dùng vào chén, khuấy đều cho tan.",
      "tip": "Wongnai nêm gia vị trước khi cho cua vào chảo — vị chuẩn là mặn ngọt nhẹ (tiếng Thái: 'เค็มหวานนิดๆ')."
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng dầu ăn trong chảo hoặc wok trên lửa vừa-lớn."
    },
    {
      "stepNumber": 5,
      "instruction": "Phi tỏi và ớt hiểm đến khi vàng thơm, khoảng 30-60 giây, cẩn thận không để tỏi cháy.",
      "tip": "Tỏi cháy sẽ đắng và làm hỏng mùi thơm của món.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Cho ớt chuông và ớt sừng vào, đảo nhanh tay khoảng 1 phút cho hơi mềm nhưng vẫn giòn.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Đổ hỗn hợp sốt đã pha vào chảo, đun sôi nhẹ; nếm lại và chỉnh mặn-ngọt cho vừa miệng."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho thịt cua vào, đảo nhẹ tay 1-2 phút cho cua nóng đều và thấm sốt.",
      "tip": "Thịt cua bóc sẵn đã chín và rất mỏng manh — FoodTravel lưu ý không xào lâu kẻo cua nát và ra nước, mất vị ngọt.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Cho hành lá cắt khúc vào, đảo nhanh 15-20 giây rồi tắt bếp."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn ra đĩa, ăn nóng với cơm trắng.",
      "tip": "Có thể rắc thêm hành lá thái nhỏ lên trên khi dọn như cách FoodTravel trình bày."
    }
  ],
