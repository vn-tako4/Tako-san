  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Gọt vỏ su su, rửa thật sạch cho hết nhựa.",
      "tip": "afamily.vn nhấn mạnh rửa sạch nhựa su su để món không bị chát, nhớt."
    },
    {
      "stepNumber": 2,
      "instruction": "Bổ đôi quả su su, khoét bỏ hạt, thái thành sợi chỉ đều nhau.",
      "tip": "Thái sợi giúp su su nhanh chín và quyện đều với trứng."
    },
    {
      "stepNumber": 3,
      "instruction": "Hành tím bóc vỏ, băm nhỏ. Hành hoa và rau mùi rửa sạch, thái nhỏ để riêng."
    },
    {
      "stepNumber": 4,
      "instruction": "Đập 3 quả trứng gà ra bát, đánh đều tay cho tan hết lòng trắng và lòng đỏ.",
      "tip": "afamily.vn: đánh trứng bông lên trước khi cho vào chảo."
    },
    {
      "stepNumber": 5,
      "instruction": "Bắc chảo lên bếp, cho 2 muỗng canh dầu ăn vào. Dầu nóng thì cho hành tím băm vào phi thơm."
    },
    {
      "stepNumber": 6,
      "instruction": "Cho su su vào chảo, để lửa to, đảo đều tay. Nêm muối, hạt nêm và nước mắm; đảo cho su su ngấm đều gia vị.",
      "tip": "afamily.vn: xào lửa to để su su chín nhanh mà vẫn giữ độ giòn, không bị ra nước nhiều.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Khi su su chín tới (hơi mềm, đã ngấm gia vị), đổ từ từ trứng đã đánh vào chảo, vừa đổ vừa đảo đều cho su su quyện với trứng.",
      "tip": "afamily.vn: đổ trứng từ từ và đảo liên tục để trứng bám đều từng sợi su su, không bị vón cục."
    },
    {
      "stepNumber": 8,
      "instruction": "Đảo thêm đến khi trứng se lại thì cho hành hoa thái nhỏ vào, đảo nhanh một lượt.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Tắt bếp, rắc rau mùi thái nhỏ và tiêu đen xay lên trên."
    },
    {
      "stepNumber": 10,
      "instruction": "Múc su su xào trứng ra đĩa, dọn ăn nóng cùng cơm trắng.",
      "tip": "afamily.vn: có thể rắc thêm chút tiêu xay khi dọn cho thơm."
    }
  ],
