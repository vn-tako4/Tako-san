  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thái gà thành hạt lựu khoảng 1.5cm; ướp với xì dầu nhạt, rượu Thiệu Hưng, bột bắp (và thêm tiêu trắng, muối, dầu ăn nếu làm theo CSF), trộn đều bằng tay; để ướp 10-30 phút.",
      "tip": "CSF: lớp tinh bột áo ngoài (kỹ thuật 'velveting') giúp gà mềm, không bị khô khi xào.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Pha sốt: cho nước dùng gà, giấm đen, rượu Thiệu Hưng, xì dầu nhạt, xì dầu đen, đường, bột bắp, muối vào bát, khuấy tan đều, để riêng.",
      "tip": "Khuấy lại bát sốt ngay trước khi đổ vào chảo vì bột bắp lắng xuống đáy."
    },
    {
      "stepNumber": 3,
      "instruction": "(Tùy chọn, theo CSF) Chuẩn bị đậu phộng: rang muối nóng hoặc chiên sơ đến khi nghe tiếng nổ lách tách, vớt ra để ráo; có thể dùng đậu phộng rang sẵn để tiết kiệm thời gian.",
      "tip": "CSF: rang một mẻ lớn để dành làm topping hoặc ăn vặt cũng ngon.",
      "timerMinutes": 7
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng wok/chảo lớn với 1 muỗng canh dầu ở lửa to vừa; dàn gà thành một lớp, áp chảo 20-30 giây không đảo, rồi đảo đến khi mặt ngoài vừa trắng, bên trong còn hơi sống; vớt gà ra đĩa ngay.",
      "tip": "Omnivore: đừng xào chín hẳn lúc này — gà sẽ chín nốt trong sốt, giữ được độ mọng.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 5,
      "instruction": "Cho nốt 2 muỗng canh dầu vào chảo; cho tiêu Tứ Xuyên và ớt khô vào ở lửa vừa, đảo đến khi rất thơm.",
      "tip": "CSF: dùng lửa nhỏ và kiên nhẫn — tiêu rang cháy sẽ đắng.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 6,
      "instruction": "Cho tỏi, gừng và một nửa hành lá vào, đảo nhanh khoảng 30 giây cho thơm; (nếu dùng ớt chuông đỏ) cho vào xào thêm 1 phút.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Khuấy lại bát sốt cho bột bắp tan hoàn toàn, đổ vào chảo, đảo nhanh vài lần.",
      "tip": "CSF nhấn mạnh: luôn khuấy sốt trước khi đổ vào chảo."
    },
    {
      "stepNumber": 8,
      "instruction": "Cho gà trở lại chảo, đảo đều đến khi sốt sánh lại và bám đều từng miếng gà.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Cho đậu phộng và phần hành lá còn lại vào, đảo 3 giây cho quyện; tắt bếp, dọn ra đĩa ngay.",
      "tip": "CSF: dọn ngay khi sốt vừa bám đều — để lâu đậu phộng mất độ giòn."
    },
    {
      "stepNumber": 10,
      "instruction": "Ăn nóng với cơm trắng; có thể rưới thêm chút dầu ớt nếu muốn màu đỏ đẹp hơn.",
      "tip": "Omnivore: ăn kèm cơm trắng là chuẩn nhất vì sốt rất ngon, đừng bỏ phí."
    }
  ],
