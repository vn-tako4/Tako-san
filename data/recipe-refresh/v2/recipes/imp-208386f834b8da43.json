  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Chọn trứng tươi: vỏ ngoài sẫm màu đều màu, không đốm nứt; bề mặt hơi sần nhám; lắc nhẹ không cảm nhận chuyển động bên trong. Rửa sạch trứng, để ráo.",
      "tip": "Cách chọn trứng tươi theo fptshop."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho trứng vào nồi nước lạnh cùng 1 muỗng cà phê muối và 1 muỗng canh giấm, bật lửa lớn và khuấy nhẹ. Khi nước sôi thì đậy nắp nồi, luộc 5-7 phút rồi tắt bếp; để trứng nguội khoảng 2 phút rồi bóc sạch vỏ.",
      "tip": "2sao: muối và giấm giúp vỏ trứng không nứt và dễ bóc hơn.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 3,
      "instruction": "Pha nước sốt kho: cho hắc xì dầu, nước tương, đường, bột ngọt và bột ngũ vị hương vào bát, trộn đều cho tan."
    },
    {
      "stepNumber": 4,
      "instruction": "Hành tím, tỏi, ớt cắt mỏng; đầu hành lá cắt khúc để riêng, phần lá hành và ngò rí cắt nhỏ để rắc khi dọn.",
      "tip": "fptshop: có thể dùng tăm xăm lên trứng hoặc xẻ đường dọc trên trứng để gia vị thấm đều hơn."
    },
    {
      "stepNumber": 5,
      "instruction": "Bắc chảo chống dính lên bếp, cho 1.5 muỗng canh dầu ăn. Dầu nóng thì cho đầu hành lá, hành tím, tỏi và ớt cắt mỏng vào phi vừa vàng thì tắt bếp ngay để tránh cháy.",
      "tip": "Cả hai nguồn đều nhấn mạnh tắt bếp ngay khi vừa vàng vì hành tỏi dễ cháy đắng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho tương ớt, nước sốt kho và 75 ml nước lọc vào chảo, bật bếp trở lại. Cho trứng đã bóc vỏ vào, đảo nhẹ tay cho trứng thấm đều màu sốt."
    },
    {
      "stepNumber": 7,
      "instruction": "Để lửa vừa, kho trứng đến khi nước sốt sánh keo lại, trứng lên màu nâu bóng đẹp thì tắt bếp.",
      "tip": "Hai nguồn không cho thời gian cụ thể — dấu hiệu đạt là nước sốt sánh sệt ('keo'), trứng lên màu đều.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 8,
      "instruction": "Gắp trứng bày ra đĩa, rưới phần nước sốt keo còn lại trong chảo lên trên."
    },
    {
      "stepNumber": 9,
      "instruction": "Rắc hành lá, ngò rí cắt nhỏ và một ít tiêu xay lên trên."
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn nóng với cơm trắng. Món càng để càng thấm vị — có thể kho lại ở bữa sau cho đậm đà hơn."
    }
  ],
