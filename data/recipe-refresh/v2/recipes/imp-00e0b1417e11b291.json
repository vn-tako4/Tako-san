  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Thấm khô đậu phụ bằng khăn giấy, cắt thành khối vuông khoảng 2.5 cm (1 inch).",
      "tip": "Thấm thật khô để lớp áo bột bắp bám tốt và đậu chiên giòn, không bị bắn dầu (WOL)."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho 1/4 cup bột bắp ra đĩa nông, lăn từng miếng đậu phụ cho phủ đều một lớp bột mỏng.",
      "tip": "Chỉ cần lớp áo mỏng; bột bắp sẽ hút ẩm từ đậu — đây là hiện tượng bình thường (WOL)."
    },
    {
      "stepNumber": 3,
      "instruction": "Hành tây thái lát mỏng; gừng nạo nhỏ; hành lá thái nhỏ để riêng."
    },
    {
      "stepNumber": 4,
      "instruction": "Hòa 2 muỗng cà phê bột bắp còn lại với 120 ml nước ấm trong một chén nhỏ, khuấy tan.",
      "tip": "Pha sẵn chén bột bắp để khi sốt sôi chỉ việc đổ vào, sốt sánh đều không vón cục."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng 1/3 cup dầu ăn trong chảo gang hoặc chảo chống dính trên lửa vừa; cho đậu phụ vào chiên các mặt đến vàng giòn rồi vớt ra để riêng.",
      "tip": "Xếp đậu cách nhau để không dính; chiên vàng đều các mặt mới vớt ra.",
      "timerMinutes": 8
    },
    {
      "stepNumber": 6,
      "instruction": "Giữ nguyên chảo (chắt bớt dầu nếu quá nhiều), cho gừng nạo vào phi thơm khoảng 1 phút.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 7,
      "instruction": "Cho hành tây thái lát vào xào 2–3 phút cho vừa mềm, vẫn giữ độ giòn nhẹ.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Thêm mirin, nước tương, nước tương đậm, đường nâu và dầu mè vào chảo; đun cho hỗn hợp sôi lăn tăn.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Đổ chén nước bột bắp vào chảo cùng đậu phụ đã chiên; đảo đều khoảng 1 phút đến khi sốt sánh lại và bám đều quanh miếng đậu.",
      "tip": "Đảo nhẹ tay để đậu không bị vỡ nát.",
      "timerMinutes": 1
    },
    {
      "stepNumber": 10,
