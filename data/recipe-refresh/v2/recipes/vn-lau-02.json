  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế gà: chà xát muối khắp thân gà để khử mùi tanh, rửa sạch lại với nước rồi chặt thành miếng vừa ăn. Ướp gà với 1 muỗng cà phê muối, 1⁄2 muỗng cà phê tiêu xay và 1 muỗng canh nước mắm trong 15 phút.",
      "tip": "yummyday bước 1: ướp đúng 3 loại gia vị này 15 phút cho ngấm.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế lá giang: nhặt bỏ dây và lá sâu, rửa sạch, để ráo rồi vò nhẹ cho hơi dập để khi nấu tiết ra nhiều vị chua.",
      "tip": "yummyday: vò nhẹ giúp tăng vị chua; KHÔNG thái nhỏ lá giang vì sẽ không tiết hết được vị chua.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 3,
      "instruction": "Sơ chế gia vị: sả đập dập cắt khúc; tỏi băm nhuyễn; hành tím băm nhỏ; ớt hiểm đập dập; cà chua bổ múi cau; ngò gai và ngò ôm thái nhỏ.",
      "tip": "Chuẩn bị sẵn tất cả trước khi bật bếp.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 4,
      "instruction": "Bắc nồi lên bếp, cho 1 muỗng canh dầu ăn vào; phi sả đến khi vàng thơm rồi cho tỏi, hành tím vào phi chung. Cho thịt gà đã ướp vào xào đến khi săn lại.",
      "tip": "yummyday: phi sả vàng trước rồi mới cho tỏi vào để tỏi không bị cháy đắng.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 5,
      "instruction": "Đổ 2 lít nước vào nồi, đun sôi rồi vớt bọt cho nước lẩu trong. Hạ lửa liu riu, hầm đến khi thịt gà chín mềm.",
      "tip": "mytour: hớt bọt để nước dùng trong.",
      "timerMinutes": 25
    },
    {
      "stepNumber": 6,
      "instruction": "Nêm muối, đường, hạt nêm, bột ngọt và phần nước mắm còn lại; nếm cho vừa khẩu vị chua-mặn-ngọt hài hòa.",
      "tip": "Nêm nhạt tay một chút vì lá giang vào sẽ làm vị đậm lên.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 7,
      "instruction": "Khi gà đã mềm, cho lá giang và cà chua vào nồi, nấu thêm vài phút cho lá giang tiết hết vị chua rồi tắt bếp.",
      "tip": "yummyday: lá giang càng nấu càng tăng vị chua — cho từ từ, nếm thường xuyên để không bị quá chua.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 8,
      "instruction": "Thêm ớt hiểm đập dập, 1 muỗng cà phê sa tế; rắc hành phi, ngò gai và ngò ôm thái nhỏ lên trên.",
      "tip": "yummyday: hoàn thiện với ớt + sa tế + tỏi phi.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 9,
      "instruction": "Sơ chế rau ăn kèm: rau muống chẻ, rau nhút, bắp chuối bào rửa sạch, để ráo; bày ra đĩa.",
      "tip": "yummyday: lẩu gà lá giang chuẩn Nam Bộ ăn kèm rau muống bào sợi, rau nhút, bắp chuối bào sợi.",
      "timerMinutes": 10
    },
    {
      "stepNumber": 10,
      "instruction": "Dọn nồi lẩu ra bàn, ăn kèm bún tươi. Lưu ý: nấu lẩu bằng nồi inox hoặc tráng men, KHÔNG dùng nồi nhôm vì chất chua ăn mòn nhôm có thể gây ngộ độc.",
      "tip": "Cảnh báo an toàn được cả yummyday và zaidap nhấn mạnh."
    }
  ],
