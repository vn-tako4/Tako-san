  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế rau sống: nhặt xà lách, rau thơm, lá hẹ, giá đỗ; rửa sạch nhiều lần, ngâm nước muối loãng 15 phút rồi vớt ra rổ để thật ráo.",
      "tip": "toplist: rau phải để ráo hoàn toàn, nếu không gỏi cuốn bị ướt và bánh tráng dễ rách"
    },
    {
      "stepNumber": 2,
      "instruction": "Cà rốt gọt vỏ, bào sợi; đun sôi nồi nước, chần cà rốt 2 phút rồi vớt ra để ráo. Dưa leo rửa sạch, bỏ phần hạt bên trong, thái sợi dài.",
      "tip": "handmadev: chần cà rốt 2 phút cho vừa mềm mà vẫn giữ màu; dưa leo bỏ hạt để nhân không ra nước",
      "timerMinutes": 2
    },
    {
      "stepNumber": 3,
      "instruction": "Nấm đùi gà rửa sạch, thái sợi dày khoảng 1 cm. Đậu phụ thái miếng vừa chiên.",
      "tip": "toplist#2: nấm đùi gà cắt sợi dài, dày cạnh khoảng 1 cm để khi xào không bị nát"
    },
    {
      "stepNumber": 4,
      "instruction": "Đun nóng dầu ăn, cho đậu phụ vào chiên vàng đều hai mặt. Vớt ra để nguội bớt, thái sợi; trộn ngay với 1 muỗng canh nước tương khi đậu còn nóng cho thấm.",
      "tip": "handmadev: trộn nước tương lúc đậu còn nóng giúp đậu thấm vị đậm đà hơn"
    },
    {
      "stepNumber": 5,
      "instruction": "Dùng chảo vừa chiên đậu, cho nấm đùi gà vào xào nhanh tay với 1 muỗng cà phê hạt nêm chay, đảo đến khi nấm vừa chín tới thì tắt bếp, để riêng.",
      "tip": "handmadev xào nấm chỉ với hạt nêm chay; toplist#2 phi hành boa-rô trước khi xào — lấy theo handmadev vì món chay thuần không dùng hành"
    },
    {
      "stepNumber": 6,
      "instruction": "Trụng bún tươi qua nước sôi, vớt ra rổ, xả nhanh nước lạnh cho sợi bún tơi, để ráo.",
      "tip": "bún phải ráo nước hoàn toàn, nếu không cuốn xong bánh tráng sẽ bị nhão"
    },
    {
      "stepNumber": 7,
      "instruction": "Pha nước chấm: khuấy đều 4 muỗng canh nước tương, 2 muỗng canh đường, 2 muỗng canh giấm (hoặc nước cốt 1 quả chanh), 1 muỗng cà phê bột ớt và 1 muỗng canh mè rang.",
      "tip": "handmadev: tỉ lệ gốc 2 nước tương : 1 đường : 1 giấm; nếm lại và gia giảm đường/giấm theo khẩu vị"
    },
    {
      "stepNumber": 8,
      "instruction": "Làm mềm bánh tráng: nhúng nhanh từng cái qua thau nước sạch rồi trải lên mặt phẳng sạch.",
      "tip": "không ngâm lâu — bánh tráng hút nước sẽ tiếp tục mềm trong lúc cuốn; nhúng ướt quá dễ rách"
    },
    {
      "stepNumber": 9,
      "instruction": "Cuốn gỏi: lót 1-2 lá xà lách lên 1/3 miếng bánh tráng, lần lượt xếp bún, nấm xào, đậu phụ, cà rốt, dưa leo, giá đỗ, rau thơm và 1 cọng hẹ; gấp hai mép bánh vào trong rồi cuộn chặt tay. Lặp lại đến hết nguyên liệu.",
      "tip": "toplist#2: xếp nhân trải ngang theo chiều bánh để cuốn đều; cuộn chặt nhưng không quá mạnh tay kẻo rách bánh"
    },
    {
      "stepNumber": 10,
      "instruction": "Xếp gỏi cuốn ra đĩa, có thể cắt đôi để lộ phần nhân nhiều màu. Ăn kèm chén nước chấm đã pha.",
      "tip": "gỏi cuốn ngon nhất khi ăn ngay; để lâu bánh tráng sẽ dai và nhân ra nước"
    }
  ],
