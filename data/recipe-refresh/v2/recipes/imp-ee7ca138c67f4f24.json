  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Cắt thịt bò thành miếng vừa ăn (nếu dùng thịt thái lát sẵn, miếng nào quá to thì cắt đôi). Cho thịt vào tô, thêm 1 muỗng canh rượu sake, 1 nhúm muối, 1 nhúm tiêu và 1 muỗng cà phê tinh bột khoai tây; dùng tay xoa đều cho thấm.",
      "tip": "Nichirei (món thịt bò xào ớt chuông): áo một lớp tinh bột mỏng giúp thịt không bị khô, giữ được độ mọng nước."
    },
    {
      "stepNumber": 2,
      "instruction": "Hành tây bóc vỏ, cắt múi cau dày 1–2 cm. Gừng gọt vỏ mỏng: một nửa thái sợi mỏng, một nửa mài nhuyễn.",
      "tip": "Nichirei (sinh-gừng-yaki): gừng nên gọt vỏ thật mỏng vì phần gần vỏ thơm nhất; dùng gừng tươi thay vì gừng tuýp."
    },
    {
      "stepNumber": 3,
      "instruction": "Pha nước sốt: cho xì dầu, mirin, 2 muỗng canh rượu sake còn lại và đường vào chén, khuấy cho đường tan hoàn toàn.",
      "tip": "Tỉ lệ vàng sốt gừng của Nichirei là sake 2 : xì dầu 1 : mirin 1,5 — sốt mặn ngọt cân bằng, hợp chan cơm."
    },
    {
      "stepNumber": 4,
      "instruction": "Đặt chảo lên bếp lửa vừa, cho dầu mè vào tráng đều mặt chảo."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thịt bò đã ướp vào chảo, xào nhanh tay đến khi thịt vừa đổi màu (không xào kỹ quá thịt sẽ dai).",
      "tip": "Thịt bò thái mỏng chín rất nhanh; xào vừa đổi màu là đủ vì thịt còn chín tiếp ở các bước sau.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Cho hành tây vào chảo, đảo đều cho thấm dầu; đậy nắp, hạ lửa nhỏ, hấp-xào khoảng 3 phút cho hành mềm và ra vị ngọt.",
      "tip": "Theo Nichirei 韓国風炒め: sau khi thịt đổi màu thì cho hành vào, đậy nắp hấp-xào lửa nhỏ 3 phút.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Mở nắp, đổ nước sốt và toàn bộ gừng (cả sợi lẫn mài nhuyễn) vào; vặn lửa vừa-cao, đảo nhanh tay đến khi sốt sánh lại và bám đều thịt, hành.",
      "tip": "Nichirei (sinh-gừng-yaki): cho sốt vào khi hành đã mềm, vừa đảo vừa để sốt quyện đều — không để sốt còn loãng lõng bõng.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 8,
      "instruction": "Nếm lại, thêm chút muối hoặc tiêu nếu cần cho vừa miệng rồi tắt bếp."
    },
    {
      "stepNumber": 9,
      "instruction": "Dọn ra đĩa, rắc hành lá thái nhỏ lên trên. Ăn nóng với cơm trắng.",
      "tip": "Món xào gừng kiểu Nhật ngon nhất khi ăn ngay lúc còn nóng hổi."
    }
  ],
