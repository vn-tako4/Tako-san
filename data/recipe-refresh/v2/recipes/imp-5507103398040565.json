  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Pha sốt yakisoba: cho 1/4 cup sốt Worcestershire, 4 muỗng cà phê sốt hàu, 4 muỗng cà phê tương cà, 2 muỗng cà phê xì dầu và 2 muỗng cà phê đường vào bát nhỏ, đánh tan đến khi đường tan hết.",
      "tip": "Mẹo của JOC: nếm sốt trước khi dùng — độ ngọt của tương cà và độ chua của Worcestershire khác nhau theo hãng, thêm đường nếu cần. Nên pha gấp đôi để dự phòng."
    },
    {
      "stepNumber": 2,
      "instruction": "Sơ chế: thịt ba chỉ cắt khúc dài 2.5 cm; hành tây thái lát mỏng; cà rốt thái sợi mỏng; bắp cải bỏ lõi cứng, cắt miếng vuông khoảng 2.5 cm; hành lá cắt khúc 5 cm (để riêng phần trắng và phần xanh); nấm hương bỏ chân, thái lát mỏng; ớt chuông thái sợi; giá đỗ rửa sạch, để ráo.",
      "tip": "JOC: cho thịt ba chỉ vào ngăn đá 10 phút trước khi cắt để thái mỏng đều dễ hơn."
    },
    {
      "stepNumber": 3,
      "instruction": "Gỡ tơi mì yakisoba hấp sẵn; nếu các vắt mì dính nhau, tráng nhanh qua nước nóng rồi để ráo.",
      "tip": "JOC dùng mì hấp sẵn nên chỉ cần làm tơi, không luộc."
    },
    {
      "stepNumber": 4,
      "instruction": "Làm nóng chảo sâu lòng hoặc wok trên lửa vừa-cao. Khi chảo thật nóng, cho 2 muỗng canh dầu ăn vào, tráng đều mặt chảo."
    },
    {
      "stepNumber": 5,
      "instruction": "Cho thịt ba chỉ vào xào đến khi chín vàng, nêm tiêu đen xay.",
      "tip": "JC101: xào thịt trước cho vàng rồi mới cho rau.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 6,
      "instruction": "Cho hành tây và phần trắng của hành lá vào, đảo đều đến khi hành tây trong.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 7,
      "instruction": "Cho ớt chuông, bắp cải, cà rốt và nấm hương vào, đảo đều tay đến khi rau hơi mềm, xẹp xuống.",
      "tip": "JOC: xào đến khi rau 'mostly wilted' (hơi mềm là được, giữ độ giòn).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 8,
      "instruction": "Cho giá đỗ vào, đảo nhanh khoảng 1 phút.",
      "tip": "Giá đỗ chín rất nhanh — cho vào cuối để giữ độ giòn (JC101).",
      "timerMinutes": 1
    },
    {
      "stepNumber": 9,
      "instruction": "Cho mì yakisoba vào chảo, đảo đều với thịt và rau. Rưới đều sốt yakisoba đã pha, đảo 2–3 phút cho sốt bám đều từng sợi mì.",
      "tip": "JC101: nếu mì còn cứng, hạ lửa, đậy nắp 2 phút cho mì mềm bằng hơi nước rồi mới cho sốt.",
      "timerMinutes": 3
    },
    {
      "stepNumber": 10,
      "instruction": "Nêm nếm lại: thêm muối/tiêu nếu cần, cho phần xanh của hành lá vào đảo nhanh rồi tắt bếp."
    },
    {
      "stepNumber": 11,
      "instruction": "Dọn mì ra đĩa, rắc rong biển aonori và xếp gừng đỏ muối lên trên. Dùng nóng.",
      "tip": "JOC: aonori và beni shoga là topping đặc trưng của yakisoba — không bỏ qua nếu muốn đúng vị."
    }
  ],
