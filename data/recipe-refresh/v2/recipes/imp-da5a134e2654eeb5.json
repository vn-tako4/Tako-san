  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế: nếu lá kim chi to thì cắt thành miếng vừa ăn. Thái mỏng 1/2 củ hành tây. Cắt hành lá thành khúc ngắn. Nạo gừng, băm nhỏ tỏi.",
      "tip": "Dùng kim chi đã lên men chua (fully fermented) — Korean Bapsang: kim chi càng chua càng hợp với món này."
    },
    {
      "stepNumber": 2,
      "instruction": "Cho kim chi, hành tây, hành lá, tỏi, gừng, xì dầu, đường, dầu mè, gochujang và hạt tiêu vào tô lớn, trộn đều. Để nghỉ 15 phút cho ngấm gia vị.",
      "tip": "Blue Apocalypse nêm kim chi trước với 1/2 tsp đường + 1/4 tsp ớt bột để giảm độ chua gắt.",
      "timerMinutes": 15
    },
    {
      "stepNumber": 3,
      "instruction": "Đun sôi khoảng 4 cup nước trong nồi vừa. Cắt đậu phụ thành 2 khối lớn. Giảm lửa vừa-cao, nhẹ nhàng cho đậu phụ vào luộc 5 phút.",
      "tip": "Korean Bapsang thích luộc vì đậu phụ mềm; có thể hấp hoặc áp chảo vàng mặt ngoài nếu muốn.",
      "timerMinutes": 5
    },
    {
      "stepNumber": 4,
      "instruction": "Vớt đậu phụ ra rổ cho ráo nước. Cắt mỗi khối thành lát dày khoảng 1,2 cm, nhẹ tay tránh vỡ."
    },
    {
      "stepNumber": 5,
      "instruction": "Đun nóng chảo lớn trên lửa vừa-cao. Cho hỗn hợp kim chi đã ướp vào xào 5-6 phút, đảo đều đến khi kim chi mềm và phần lớn nước tiết ra đã bay hơi.",
      "timerMinutes": 6
    },
    {
      "stepNumber": 6,
      "instruction": "Nếm lại: nếu kim chi quá chua thêm chút đường; muốn cay hơn thêm gochujang; muốn đậm hơn thêm chút xì dầu.",
      "tip": "Blue Apocalypse: nêm vừa miệng là chính vì độ chua của kim chi mỗi mẻ khác nhau."
    },
    {
      "stepNumber": 7,
      "instruction": "Xếp các lát đậu phụ quanh đĩa, chừa khoảng trống ở giữa. Múc kim chi xào vào giữa đĩa.",
      "tip": "Hoặc bày đậu phụ và kim chi xào cạnh nhau trên đĩa — Korean Bapsang."
    },
    {
      "stepNumber": 8,
      "instruction": "Rắc vừng rang và chút hành lá thái nhỏ lên trên. Dọn nóng ngay với cơm trắng.",
      "tip": "Ở Hàn, dubu kimchi còn là món nhậu (anju) phổ biến với rượu soju hoặc makgeolli — Korean Bapsang."
    }
  ],
