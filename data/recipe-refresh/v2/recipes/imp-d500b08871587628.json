  "steps": [
    {
      "stepNumber": 1,
      "instruction": "Sơ chế tôm: rửa sạch, cắt bỏ râu, bóc vỏ (có thể chừa lại phần đuôi cho đẹp), rút đường chỉ lưng, rửa lại với nước sạch rồi để ráo (theo memart).",
      "tip": "Tôm tươi giúp món kho ngọt thịt và không tanh — chọn tôm vỏ bóng, thân săn chắc."
    },
    {
      "stepNumber": 2,
      "instruction": "Dứa gọt vỏ, bỏ mắt, cắt thành miếng vừa ăn (toyenxin cắt lát; memart thái miếng).",
      "tip": "Chọn dứa chín vàng, thơm — dứa quá xanh sẽ chua gắt, phải tăng đường."
    },
    {
      "stepNumber": 3,
      "instruction": "Hành tím và tỏi băm nhuyễn, ớt thái lát; hành lá cắt nhỏ để riêng."
    },
    {
      "stepNumber": 4,
      "instruction": "Ướp tôm với 1 muỗng canh nước mắm, 1 muỗng cà phê đường, 1/2 lượng hành tỏi băm và 1/2 lượng tiêu xay; trộn đều, để 15-20 phút cho thấm (theo toyenxin).",
      "tip": "Ướp trước giúp tôm đậm đà và giữ được độ ngọt khi kho (mẹo của toyenxin).",
      "timerMinutes": 15
    },
    {
      "stepNumber": 5,
      "instruction": "Bắc nồi/chảo lên bếp, cho 1.5 muỗng canh dầu ăn vào đun nóng. Phi thơm lượng hành tỏi và ớt còn lại đến khi vàng thơm.",
      "timerMinutes": 2
    },
    {
      "stepNumber": 6,
      "instruction": "Trút tôm đã ướp vào, đảo đều trên lửa vừa đến khi tôm chuyển màu đỏ cam và săn lại (theo toyenxin).",
      "tip": "Đảo vừa tay, không đảo quá nhiều để tôm không bị nát (mẹo kho tôm của toyenxin).",
      "timerMinutes": 3
    },
    {
      "stepNumber": 7,
      "instruction": "Cho dứa vào đảo đều cùng tôm. Thêm khoảng 100 ml nước lọc (vừa sâm sấp mặt tôm), nêm nốt 1/2 muỗng canh nước mắm, 1 muỗng cà phê đường còn lại và 1 muỗng cà phê hạt nêm (nếu dùng)."
    },
    {
      "stepNumber": 8,
      "instruction": "Đun sôi rồi hạ lửa nhỏ, kho liu riu khoảng 10-15 phút, thỉnh thoảng đảo nhẹ, đến khi nước kho sệt keo lại, bám quanh tôm và dứa.",
      "tip": "'Kho keo' nghĩa là kho đến khi nước kho đặc sánh lại (toyenxin: 'kho đến khi nước kho sệt lại'). Dứa ra nước nên không cần cho nhiều nước từ đầu.",
      "timerMinutes": 12
    },
    {
      "stepNumber": 9,
      "instruction": "Nêm nếm lại cho vừa miệng — vị chuẩn là mặn ngọt hài hòa, có vị chua thanh của dứa.",
      "tip": "Nếu dứa chua gắt, thêm chút đường; nếu dứa quá ngọt, giảm đường ngay từ bước 7."
    },
    {
      "stepNumber": 10,
      "instruction": "Rắc hành lá cắt nhỏ và lượng tiêu xay còn lại lên trên, đảo đều rồi tắt bếp (cả hai nguồn)."
